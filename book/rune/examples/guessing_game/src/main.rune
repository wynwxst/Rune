import std::{io,process,random}

fn main() -> i64 {
    println!("Welcome to guessing game!\nEnter your guess: ")
    let number = random::between(0, 100)
    var guess: int? = nil

    for _ in 0..=3 {
        while io::readLineOrEnd() is Some(line) {
            guess = line.$toInt()
            match guess {
                None => continue,
                Some(_) => {}
            }
            break
        }
        let guess: i64 = guess.unwrap()


        match guess {
            _ if guess > number => println!("Too big"),
            _ if guess < number => println!("Too small"),
            _ => {println!("You won!"); break}
        }
    }



    0
}