import std::{io, math}

/// A point or direction on the plane.
pub struct Vec2 {
    pub x: f64
    pub y: f64
}

extend Vec2 {
    pub fn length(&self) -> f64 {
        math::lengthOf(self.x, self.y)
    }

    pub fn distanceTo(&self, other: &Vec2) -> f64 {
        (*other - *self).length()
    }

    /// The z part of the 3D cross product, twice the area of the triangle
    /// the two vectors span.
    pub fn cross(&self, other: &Vec2) -> f64 {
        self.x * other.y - self.y * other.x
    }
}

bind operator::add to Vec2 {
    fn add(&self, other: &Vec2) -> Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
}

bind operator::sub to Vec2 {
    fn sub(&self, other: &Vec2) -> Vec2 {
        Vec2 { x: self.x - other.x, y: self.y - other.y }
    }
}

bind operator::mul to Vec2 {
    fn mul(&self, k: f64) -> Vec2 {
        Vec2 { x: self.x * k, y: self.y * k }
    }
}

bind operator::neg to Vec2 {
    fn neg(&self) -> Vec2 {
        Vec2 { x: -self.x, y: -self.y }
    }
}

bind operator::eq to Vec2 {
    fn eq(&self, other: &Vec2) -> bool {
        self.x == other.x && self.y == other.y
    }
}

bind io::Display to Vec2 {
    fn display(&self) -> String {
        "(" + self.x.$str() + ", " + self.y.$str() + ")"
    }
}
