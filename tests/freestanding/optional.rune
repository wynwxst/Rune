import fs::sys
class Node {
    pub var v: i64 = 0
    pub var next: Node? = nil
    fn init(self, v: i64) { self.v = v }
}
fn depth(n: &Node) -> i64 {
    if n.next is Some(m) { 1 + depth(&m) } else { 1 }
}
fn pick(i: i64) -> i64? { if i > 0 { i } else { nil } }
#export("_start")
fn start() -> Never {
    var a = Node(1)
    a.next = Node(2)
    sys::exit(depth(&a) * 10 + (pick(3) ?? 0))
}
