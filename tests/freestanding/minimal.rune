// The minimal freestanding runtime: strings made, joined, compared and
// printed, and integers as text, with `freestanding_type = "minimal"`.
// Compiled to an object only, so it is the same on every host; the hooks are
// C's, for whoever links it.
@runtime(none)
import std::io

extern "C" {
    fn malloc(size: usize) -> *var u8
    fn free(block: *var u8)
    fn write(fd: i32, bytes: *u8, count: usize) -> i64
    fn exit(code: i32) -> Never
}

@allocator
@safe("C's heap")
fn heapAllocate(size: usize, align: usize) -> *var u8 { unsafe { malloc(size) } }

@deallocator
@safe("C's heap")
fn heapFree(block: *var u8, size: usize, align: usize) { unsafe { free(block) } }

@output
@safe("standard output")
fn out(bytes: *u8, count: usize) { unsafe { write(1, bytes, count) } }

@panicHandler
@safe("C's exit")
fn onPanic(message: CString, location: CString) -> Never { unsafe { exit(101) } }

fn main() -> i64 {
    var text: String = "count:"
    var i = 0
    while i < 3 { text = text + " " + i.$str(); i += 1 }
    io::println(text)
    io::println((text == ("count: 0 1 2" as String)).$str())
    0
}
