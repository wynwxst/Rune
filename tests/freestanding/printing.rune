import fs::sys
import std::io
import std::fmt

// `String`, `format!`, `println!` and numbers as text on a program with no C
// library: the freestanding runtime makes them, and `io` writes through the
// program's `@output` (in sys.rune).
@export("_start")
fn start() -> Never {
    let name: String = "freestanding"
    println!("hello from {name}: {} {}", 6 * 7, 0.1 + 0.2)
    io::println(fmt::fixed(2.0 / 3.0, 4) + " " + (1.0e300 * 10.0).$str())
    let n: String = "-12.5e-1"
    io::println((n.$toFloat() ?? 0.0).$str())
    sys::exit(0)
}
