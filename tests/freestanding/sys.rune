// A freestanding program for Linux x86_64 with no C library: two system
// calls by inline assembly, a bump allocator, and a panic handler that
// prints and exits 101. Every case in this directory is compiled with it.
#runtime(none)
#entry(none)

import std::asm

pub fn say(text: CString) {
    let bytes = unsafe { text as *u8 }
    var n: i64 = 0
    while unsafe { bytes[n] } != 0 { n += 1 }
    let written: i64 = unsafe { asm::value<i64>("syscall", "={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}", 1, 1, bytes, n) }
}

pub fn sayNumber(value: i64) {
    var digits: [21:u8] = [0; 21]
    var at: i64 = 19
    var n = if value < 0 { 0 - value } else { value }
    while true {
        digits[at] = (48 + n % 10) as u8
        n = n / 10
        if n == 0 { break }
        at -= 1
    }
    if value < 0 { at -= 1; digits[at] = 45 }
    say(unsafe { &var digits[at] as *var u8 as CString })
}

pub fn exit(code: i64) -> Never {
    let r: i64 = unsafe { asm::value<i64>("syscall", "={rax},{rax},{rdi}", 60, code) }
    loop {}
}

/// Where `io::println` and the rest go: standard output, by system call.
#output
fn writeOut(bytes: *u8, count: usize) {
    let written: i64 = unsafe { asm::value<i64>("syscall", "={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}", 1, 1, bytes, count as i64) }
}

#panicHandler
fn panicked(message: CString, location: CString) -> Never {
    say("panic: ")
    say(message)
    say("\n")
    exit(101)
}

global var arena: [65536:u8] = [0; 65536]
global var used: usize = 0
pub global var live: i64 = 0

#allocator
fn allocate(size: usize, align: usize) -> *var u8 {
    let at = (used + align - 1) / align * align
    used = at + size
    live += 1
    unsafe { &var arena[at as i64] as *var u8 }
}

#deallocator
fn release(block: *var u8, size: usize, align: usize) { live -= 1 }
