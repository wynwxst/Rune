// A library that exports procedural macros, for `B1_macro_exported`. One is
// written among its ordinary code, and the library uses it itself; the other
// lives in the `#type(Macros)` file built with it.
import std::Macro

/// Squares an expression.
#macro
pub fn square(input: Macro::Tokens) -> Macro::Tokens {
    Macro::parse("((" + input.text() + ") * (" + input.text() + "))")
}

pub fn area(side: i64) -> i64 { square!(side) }
