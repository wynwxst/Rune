// `@link` and `@linkpath` at the top of a file declare what it needs from the
// system linker. libm is what `cbrt` lives in.
// EXPECT: 3.0
// EXPECT: 5.0
@link("m")
@linkpath("/usr/lib")

import std::io

extern "C" {
    fn cbrt(x: f64) -> f64
    fn hypot(a: f64, b: f64) -> f64
}

@safe("libm is linked by the directives at the top of this file")
fn main() -> i64 {
    io::println(unsafe { cbrt(27.0) }.$str())
    io::println(unsafe { hypot(3.0, 4.0) }.$str())
    0
}
