// EXPECT-ERROR: is never closed
// A string left open inside a macro call swallowed the end of the file into
// its arguments, and the parser's recovery spun forever on what was left.
import std::io

fn main() -> i64 {
    let name: String? = "Dusk"
    println!("{}", name.expect("H))
    io::println("after")
    0
}
