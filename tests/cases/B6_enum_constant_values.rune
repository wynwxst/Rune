// EXPECT: 1 2 8 3 11
// EXPECT: 7 7 28 28 29
// EXPECT: -2 -1 0 6
// A variant's value may be arithmetic on numbers and on the variants before
// it: flags written as shifts and combined with `|`, an alias for an earlier
// variant, and implicit values counting on from a computed one.
import std::io

enum Style {
    Titled = 1 << 0
    Closable = 1 << 1
    Resizable = 1 << 3
    Plain = Titled | Closable
    Everything = Style::Plain | Resizable
}

enum Family {
    AF_ISO = 7,
    AF_OSI = AF_ISO,
    AF_ISDN = 28,
    AF_E164 = AF_ISDN,
    AF_NEXT,
}

enum Count { Low = -(1 + 1), Mid, Zero, High = (Mid + 4) * -2 / -1 + ~-1 }

fn main() -> i64 {
    io::println((Style::Titled as i64).$str() + " " + (Style::Closable as i64).$str() + " " +
                (Style::Resizable as i64).$str() + " " + (Style::Plain as i64).$str() + " " +
                (Style::Everything as i64).$str())
    io::println((Family::AF_ISO as i64).$str() + " " + (Family::AF_OSI as i64).$str() + " " +
                (Family::AF_ISDN as i64).$str() + " " + (Family::AF_E164 as i64).$str() + " " +
                (Family::AF_NEXT as i64).$str())
    io::println((Count::Low as i64).$str() + " " + (Count::Mid as i64).$str() + " " +
                (Count::Zero as i64).$str() + " " + (Count::High as i64).$str())
    0
}
