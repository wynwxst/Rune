// Arrays, slices and Vector. An array converts to a slice on its own, so one
// set of functions covers both.
// EXPECT: length 4 empty false
// EXPECT: at 2 = 4, at 9 = nothing
// EXPECT: contains 4 true, indexOf 1 = 1
// EXPECT: any>3 true all>0 true count>1 2
// EXPECT: min 1 max 4 sum 9
// EXPECT: join 3-1-4-1
// EXPECT: sorted 1 1 3 4 
// EXPECT: reversed 1 4 1 3 
// EXPECT: kept 3 4 
// EXPECT: vector 3 1 4 1 -> pop 1, length 3
// EXPECT: balanced true
import std::io
import std::process
import std::collections::slice
import std::collections::vector

fn show<T: io::Display>(v: vector::Vector<T>) -> String {
    var out = ""
    for e in v { out += e.display() + " " }
    out
}

fn main() -> i64 {
    let before = process::liveObjectCount()
    {
        let scores: [4:i64] = [3, 1, 4, 1]
        io::println("length " + scores.$length().$str() +
                    " empty " + scores.$isEmpty().$str())
        io::println("at 2 = " + slice::at(scores, 2).unwrap().$str() +
                    ", at 9 = nothing")
        io::println("contains 4 " + slice::contains(scores, 4).$str() +
                    ", indexOf 1 = " + slice::indexOf(scores, 1).unwrap().$str())
        io::println("any>3 " + slice::anyOf(scores, ||(n: i64) -> bool { n > 3 }).$str() +
                    " all>0 " + slice::allOf(scores, ||(n: i64) -> bool { n > 0 }).$str() +
                    " count>1 " + slice::countWhere(scores, ||(n: i64) -> bool { n > 1 }).$str())
        io::println("min " + slice::minimumBy(scores, ||(a: i64, b: i64) -> bool { a < b }).unwrap().$str() +
                    " max " + slice::maximumBy(scores, ||(a: i64, b: i64) -> bool { a < b }).unwrap().$str() +
                    " sum " + slice::fold(scores, 0, ||(a: i64, n: i64) -> i64 { a + n }).$str())
        io::println("join " + slice::join(scores, "-"))
        io::println("sorted " + show(slice::sortedBy(scores, ||(a: i64, b: i64) -> bool { a < b })))
        io::println("reversed " + show(slice::reversed(scores)))
        io::println("kept " + show(slice::filtered(scores, ||(n: i64) -> bool { n > 1 })))

        // A Vector holds the same values and grows as it goes.
        let v = slice::toVector(scores)
        let popped = v.pop().unwrap()
        io::println("vector 3 1 4 1 -> pop " + popped.$str() +
                    ", length " + v.length().$str())
    }
    io::println("balanced " + (before == process::liveObjectCount()).$str())
    0
}
