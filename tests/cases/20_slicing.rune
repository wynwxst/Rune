// `values[a..b]` borrows part of an array or slice as a `[T]`.
// EXPECT: 6 15 6
// EXPECT: 3 7
// EXPECT: nested 7
import std::io

fn total(v: [i64]) -> i64 {
    var s = 0
    for x in v { s += x }
    s
}

fn main() -> i64 {
    let a: [6:i64] = [1, 2, 3, 4, 5, 6]
    io::println(total(a[0..3]).$str() + " " + total(a[3..6]).$str() + " " +
                total(a[0..=2]).$str())
    io::println(a[2..5].$length().$str() + " " + total(a[1..5][1..3]).$str())

    let s = a[1..5]
    io::println("nested " + total(s[1..3]).$str())
    0
}
