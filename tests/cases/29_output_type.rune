// `#type` says what a file produces. This one has a `main`, so it would be an
// executable anyway; saying so explicitly is the point.
// EXPECT: explicit is fine
#type(Executable)

import std::io
import std::collections::vector

fn main() -> i64 {
    // `std::collections` is the short name for
    // `std::collections` — one implementation, two paths.
    var v = vector::Vector<i64>()
    v.push(1)
    io::println(if v.length() == 1 { "explicit is fine" } else { "wrong" })
    0
}
