// EXPECT-ERROR: type arguments go after the name they belong to
// `reflect::<Point>fieldName(0)` writes the type arguments before the name;
// they belong after it: `reflect::fieldName<Point>(0)`.
import std::reflect
struct Point { x: i32 }
fn main() -> i64 {
    let n = std::reflect::<Point>fieldName(0)
    0
}
