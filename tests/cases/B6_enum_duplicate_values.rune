// EXPECT: 2 2 1
// Two variants with one value warn (W0402), unless one is written as the
// other's name. The program still builds.
import std::io
enum Level { Low = 1, Mid = 2, High = 2, Default = Low }
enum Step { A = 1, B = 0, C }
fn main() -> i64 {
    io::println((Level::Mid as i64).$str() + " " + (Level::High as i64).$str() + " " +
                (Step::C as i64).$str())
    0
}
