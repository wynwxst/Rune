// A shared borrow may read what it reaches, never change it — even a class
// field.
// FLAGS: --memory zombie
// EXPECT-ERROR: cannot assign to 'self.n' through `&`
class Counter {
    var n: i64
    fn init(self) { self.n = 0 }
    fn bump(&self) { self.n += 1 }
}
fn main() -> i64 { let c = Counter(); c.bump(); c.n }
