// The other half of `B3_shared_library`: an ordinary Rune module built with
// `--shared`, so the system's loader can open it and a program can look its
// functions up by name.
//
// `#export` is what makes that possible: it gives a function the symbol the
// outside world knows it by, with no mangling, so `dlsym` finds it.
import std::io

#export("greeter_add")
pub fn add(a: i64, b: i64) -> i64 { a + b }

#export("greeter_shout")
pub fn shout(times: i64) -> i64 {
    var i = 0
    while i < times {
        io::println("hello from a shared library")
        i += 1
    }
    times * 2
}

/// State lives in the library, and stays there between calls.
global var counter: i64 = 0

#export("greeter_next")
pub fn next() -> i64 {
    counter += 1
    counter
}
