// LIB: libeverything lib/libeverything.rune
// EXPECT: version 3
// EXPECT: tally 2
// EXPECT: point (3,4) 7 (6,8)
// EXPECT: operators (4,6) true false
// EXPECT: convert 7.0 7.0
// EXPECT: inherited (1,2) tag
// EXPECT: enums 2 24.0 8.0
// EXPECT: generic 1 two -> two 1
// EXPECT: class 1 3
// EXPECT: alias 2.5 2
// EXPECT: marks (0,0)! a pair!
// EXPECT: auto Point true Resource false
// EXPECT: dyn (5,5)! some (9,9)!
// EXPECT: closure 12
// EXPECT: macro (2,2)
// EXPECT: foreign 5
// EXPECT: mine Zed! held 7
// EXPECT: extended (3,4) 12 14
//
// Everything a library can export, used from the other side of the `.rul`
// boundary — and then *extended* and *bound to*, which is the part that has
// to work for a library to be worth having.
//
// A `.rul` carries its modules' source, and this file re-parses it into
// modules of its own. So each declaration is checked twice, and what is
// public here has to mean the same thing it meant there.
import std::io
import std::reflect
import libeverything
import std::collections::vector

//===--------------------------------------------------------------------===//
// The consumer's own types, and the library's marks on them
//===--------------------------------------------------------------------===//

struct Badge { title: String = "" }

/// A library mark, implemented for a type the library never saw.
bind libeverything::Named to Badge {
    fn name(&self) -> String { self.title }
}

/// A library mark with an associated type, answered here.
bind libeverything::Holder to Badge {
    type Held = i64
    fn held(&self) -> i64 { 7 }
}

/// A mark of the consumer's own, bound to a library type.
mark Area {
    fn area(&self) -> i64
}

bind Area to libeverything::Point {
    fn area(&self) -> i64 { self.x * self.y }
}

/// And methods of the consumer's own, added to a library type.
extend libeverything::Point {
    fn diagonal(&self) -> i64 { self.x + self.y + self.manhattan() }
}

fn main() -> i64 {
    // --- values ---------------------------------------------------------
    println!("version {}", libeverything::version.$str())
    libeverything::tally += 2
    println!("tally {}", libeverything::tally.$str())

    // --- a struct, its `extend`, and its operators -----------------------
    let p = libeverything::Point { x: 3, y: 4 }
    println!("point {} {} {}", p.name(), p.manhattan().$str(),
             p.scaled(2).name())

    let sum = p + libeverything::Point { x: 1, y: 2 }
    println!("operators {} {} {}", sum.name(),
             (p == libeverything::Point { x: 3, y: 4 }).$str(),
             (p == libeverything::origin()).$str())

    // A conversion, written out and left to the annotation.
    let written = p into libeverything::Distance
    let inferred: libeverything::Distance = p
    println!("convert {} {}", written.$str(), inferred.$str())

    // --- inheritance across the boundary --------------------------------
    let tagged = libeverything::Tagged { x: 1, y: 2, label: "tag" }
    println!("inherited {} {}", tagged.name(), tagged.label)

    // --- enums ----------------------------------------------------------
    let solid: libeverything::Solid = .Cube(2.0)
    let area = match solid {
        .Circle(r) => r * r * 3.0,
        .Rect(w, h) => w * h,
        .Cube(side) => side * side * 6.0,
    }
    println!("enums {} {} {}", (libeverything::Colour::Blue as i64).$str(),
             area.$str(), (2.0 * 4.0).$str())

    // --- generics, with the consumer's own types ------------------------
    let both = libeverything::paired<i64, String>(1, "two")
    let other = both.swapped()
    println!("generic {} {} -> {} {}", both.first.$str(), both.second,
             other.first, other.second.$str())

    // --- classes and inheritance ----------------------------------------
    var counter = libeverything::Counter(0)
    let once = counter.bump()
    var doubling = libeverything::Doubling(1)
    println!("class {} {}", once.$str(), doubling.bump().$str())

    // --- aliases --------------------------------------------------------
    let d: libeverything::Distance = 2.5
    var row: libeverything::Row<i64> = vector::Vector<i64>()
    row.push(1)
    row.push(2)
    println!("alias {} {}", d.$str(), row.length().$str())

    // --- marks, defaults and automatic ones -----------------------------
    // A generic call is bound to a name first: `<` and `>` are operators to
    // a macro's argument splitter, so the commas inside one would read as
    // argument separators of `println!` itself.
    let o = libeverything::origin()
    let namedPoint = libeverything::describe<libeverything::Point>(&o)
    let anyPair = libeverything::paired<i64, i64>(1, 2)
    let namedPair = libeverything::describe<libeverything::Pair<i64, i64>>(&anyPair)
    println!("marks {} {}", namedPoint, namedPair)

    let plainPoint =
        reflect::conforms<libeverything::Point, libeverything::Plain>()
    let plainResource =
        reflect::conforms<libeverything::Resource, libeverything::Plain>()
    println!("auto Point {} Resource {}", plainPoint.$str(),
             plainResource.$str())

    // --- mark objects and opaque results --------------------------------
    let boxed = libeverything::anyNamed(libeverything::Point { x: 5, y: 5 })
    let hidden = libeverything::someNamed(libeverything::Point { x: 9, y: 9 })
    println!("dyn {} some {}", boxed.shout(), hidden.shout())

    // --- a closure whose types the library's signature supplies ---------
    println!("closure {}", libeverything::applyTwice(||(n) { n + 5 }, 2).$str())

    // --- a macro the library exported -----------------------------------
    println!("macro {}", twicePoint!(libeverything::origin()).name())

    // --- a foreign call, wrapped by the library -------------------------
    println!("foreign {}", libeverything::lengthOf("hello").$str())

    // --- the consumer's own types answering the library's marks ---------
    let badge = Badge { title: "Zed" }
    println!("mine {} held {}", badge.shout(), badge.held().$str())

    // --- and the consumer's own mark and methods on a library type ------
    println!("extended {} {} {}", p.name(), p.area().$str(),
             p.diagonal().$str())
    0
}
