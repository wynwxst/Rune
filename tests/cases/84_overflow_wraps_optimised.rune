// The same arithmetic in a build that turned the check off wraps silently —
// which is what `-O1` and above do on their own, and what `rune build
// --release` produces.
// EXPECT: -128
// EXPECT: 0
// EXPECT: -128
// FLAGS: --no-overflow-checks

import std::io

fn main() -> i64 {
    var x: i8 = 127
    x += 1
    io::println(x)
    let u: u8 = 255
    io::println(u + 1)
    let m: i8 = -128
    io::println(-m)
    0
}
