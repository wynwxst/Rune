// A fixed-size heap buffer, bounds checked on every access, with `[]` for
// reading and writing.
// EXPECT: length 4 empty false
// EXPECT: 10 20 30 5
// EXPECT: at 9 false  holds 3 true
// EXPECT: ada grace -
// EXPECT: reset reset
// EXPECT: balanced true
import std::io
import std::process
import std::mem

fn main() -> i64 {
    var b = mem::filled<i64>(4, 0)
    io::println("length " + b.length().$str() +
                " empty " + b.isEmpty().$str())

    b[0] = 10
    b[1] = 20
    b[2] = b[0] + b[1]
    b[3] += 5
    io::println(b[0].$str() + " " + b[1].$str() + " " +
                b[2].$str() + " " + b[3].$str())

    io::println("at 9 " + b.at(9).hasValue().$str() +
                "  holds 3 " + b.holds(3).$str())

    // Reference-counted elements: the buffer owns one reference each, and
    // gives them all back.
    let before = process::liveObjectCount()
    {
        var names = mem::filled<String>(3, "-")
        names[0] = "ada"
        names[1] = "grace"
        io::println(names[0] + " " + names[1] + " " + names[2])
        names.fill("reset")
        io::println(names[0] + " " + names[2])
    }
    let after = process::liveObjectCount()
    io::println("balanced " + (before == after).$str())
    0
}
