// `as` cannot be redefined: a conversion a program supplies is reached with
// `into`, and the two never compete.
// EXPECT-ERROR: cannot cast 'Celsius' to 'Fahrenheit'

struct Celsius { v: f64 }
struct Fahrenheit { v: f64 }

bind As<Fahrenheit> to Celsius {
    fn convert(&self) -> Fahrenheit { Fahrenheit { v: self.v * 1.8 + 32.0 } }
}

fn main() -> i64 {
    let c = Celsius { v: 100.0 }
    let f = c as Fahrenheit      // `into` is the spelling that reaches it
    0
}
