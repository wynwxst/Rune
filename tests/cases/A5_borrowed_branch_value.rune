// EXPECT: y -> var
// EXPECT: y -> y
// EXPECT: x -> x: i64
// EXPECT: x -> let!
// EXPECT: live 0
//
// An `if` or `match` whose value is borrowed by the call it is an argument
// of: a string made inside a branch lives until the call is done, and is
// released then.
import std::io
import std::process
import std::collections::vector
struct B { name: String, kind: String }
fn show(label: &String, detail: &String) {
    let junk = vector::from([1, 2, 3, 4, 5, 6, 7, 8])
    io::println(label + " -> " + detail)
}
fn work() {
    var bs = vector::Vector<B>()
    bs.push(B { name: "x", kind: "let" })
    bs.push(B { name: "y", kind: "var" })
    var i = bs.length() - 1
    while i >= 0 {
        let b = bs.look(i)
        let known = i == 0
        show(b.name, if known { b.name + ": " + "i64" } else { b.kind.$clone() })
        show(b.name, match i { 0 => b.kind + "!", _ => b.name.$clone() })
        i -= 1
    }
}
fn main() -> i64 {
    let before = process::liveObjectCount()
    work()
    io::println("live " + (process::liveObjectCount() - before).$str())
    0
}
