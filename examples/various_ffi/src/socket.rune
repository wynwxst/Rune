//=== Functions and variables ===

pub extern "C" {
    fn accept(arg0: i32, arg1: *var sockaddr, arg2: *var socklen_t) -> i32
    fn bind_(arg0: i32, arg1: *sockaddr, arg2: socklen_t) -> i32
    fn connect(arg0: i32, arg1: *sockaddr, arg2: socklen_t) -> i32
    fn getpeername(arg0: i32, arg1: *var sockaddr, arg2: *var socklen_t) -> i32
    fn getsockname(arg0: i32, arg1: *var sockaddr, arg2: *var socklen_t) -> i32
    fn getsockopt(arg0: i32, arg1: i32, arg2: i32, arg3: *var u8, arg4: *var socklen_t) -> i32
    fn listen(arg0: i32, arg1: i32) -> i32
    fn recv(arg0: i32, arg1: *var u8, arg2: usize, arg3: i32) -> isize
    fn recvfrom(arg0: i32, arg1: *var u8, arg2: usize, arg3: i32, arg4: *var sockaddr, arg5: *var socklen_t) -> isize
    fn recvmsg(arg0: i32, arg1: *var msghdr, arg2: i32) -> isize
    fn send(arg0: i32, arg1: *u8, arg2: usize, arg3: i32) -> isize
    fn sendmsg(arg0: i32, arg1: *msghdr, arg2: i32) -> isize
    fn sendto(arg0: i32, arg1: *u8, arg2: usize, arg3: i32, arg4: *sockaddr, arg5: socklen_t) -> isize
    fn setsockopt(arg0: i32, arg1: i32, arg2: i32, arg3: *u8, arg4: socklen_t) -> i32
    fn shutdown(arg0: i32, arg1: i32) -> i32
    fn sockatmark(arg0: i32) -> i32
    fn socket(arg0: i32, arg1: i32, arg2: i32) -> i32
    fn socketpair(arg0: i32, arg1: i32, arg2: i32, arg3: *var i32) -> i32
    fn sendfile(arg0: i32, arg1: i32, arg2: off_t, arg3: *var off_t, arg4: *var sf_hdtr, arg5: i32) -> i32
    fn pfctlinput(arg0: i32, arg1: *var sockaddr)
    fn connectx(arg0: i32, arg1: *sa_endpoints_t, arg2: sae_associd_t, arg3: u32, arg4: *iovec, arg5: u32, arg6: *var usize, arg7: *var sae_connid_t) -> i32
    fn disconnectx(arg0: i32, arg1: sae_associd_t, arg2: sae_connid_t) -> i32
}

//=== Layout ===

/// How many of these structs differ in size, alignment or member offsets
/// from what the C compiler gives them. Zero, on the target they were
/// written for.
pub fn layoutMismatches() -> i64 {
    var bad = 0
    if offset_of!(iovec, iov_base) != 0 { bad += 1 }
    if offset_of!(iovec, iov_len) != 8 { bad += 1 }
    if mem::size_of<iovec>() != 16 { bad += 1 }
    if mem::align_of<iovec>() != 8 { bad += 1 }
    if offset_of!(sa_endpoints, sae_srcif) != 0 { bad += 1 }
    if offset_of!(sa_endpoints, sae_srcaddr) != 8 { bad += 1 }
    if offset_of!(sa_endpoints, sae_srcaddrlen) != 16 { bad += 1 }
    if offset_of!(sa_endpoints, sae_dstaddr) != 24 { bad += 1 }
    if offset_of!(sa_endpoints, sae_dstaddrlen) != 32 { bad += 1 }
    if mem::size_of<sa_endpoints>() != 40 { bad += 1 }
    if mem::align_of<sa_endpoints>() != 8 { bad += 1 }
    if offset_of!(sockaddr, sa_len) != 0 { bad += 1 }
    if offset_of!(sockaddr, sa_family) != 1 { bad += 1 }
    if offset_of!(sockaddr, sa_data) != 2 { bad += 1 }
    if mem::size_of<sockaddr>() != 16 { bad += 1 }
    if mem::align_of<sockaddr>() != 1 { bad += 1 }
    if offset_of!(linger, l_onoff) != 0 { bad += 1 }
    if offset_of!(linger, l_linger) != 4 { bad += 1 }
    if mem::size_of<linger>() != 8 { bad += 1 }
    if mem::align_of<linger>() != 4 { bad += 1 }
    if offset_of!(so_np_extensions, npx_flags) != 0 { bad += 1 }
    if offset_of!(so_np_extensions, npx_mask) != 4 { bad += 1 }
    if mem::size_of<so_np_extensions>() != 8 { bad += 1 }
    if mem::align_of<so_np_extensions>() != 4 { bad += 1 }
    if offset_of!(__sockaddr_header, sa_len) != 0 { bad += 1 }
    if offset_of!(__sockaddr_header, sa_family) != 1 { bad += 1 }
    if mem::size_of<__sockaddr_header>() != 2 { bad += 1 }
    if mem::align_of<__sockaddr_header>() != 1 { bad += 1 }
    if offset_of!(sockproto, sp_family) != 0 { bad += 1 }
    if offset_of!(sockproto, sp_protocol) != 2 { bad += 1 }
    if mem::size_of<sockproto>() != 4 { bad += 1 }
    if mem::align_of<sockproto>() != 2 { bad += 1 }
    if offset_of!(sockaddr_storage, ss_len) != 0 { bad += 1 }
    if offset_of!(sockaddr_storage, ss_family) != 1 { bad += 1 }
    if offset_of!(sockaddr_storage, __ss_pad1) != 2 { bad += 1 }
    if offset_of!(sockaddr_storage, __ss_align) != 8 { bad += 1 }
    if offset_of!(sockaddr_storage, __ss_pad2) != 16 { bad += 1 }
    if mem::size_of<sockaddr_storage>() != 128 { bad += 1 }
    if mem::align_of<sockaddr_storage>() != 8 { bad += 1 }
    if offset_of!(msghdr, msg_name) != 0 { bad += 1 }
    if offset_of!(msghdr, msg_namelen) != 8 { bad += 1 }
    if offset_of!(msghdr, msg_iov) != 16 { bad += 1 }
    if offset_of!(msghdr, msg_iovlen) != 24 { bad += 1 }
    if offset_of!(msghdr, msg_control) != 32 { bad += 1 }
    if offset_of!(msghdr, msg_controllen) != 40 { bad += 1 }
    if offset_of!(msghdr, msg_flags) != 44 { bad += 1 }
    if mem::size_of<msghdr>() != 48 { bad += 1 }
    if mem::align_of<msghdr>() != 8 { bad += 1 }
    if offset_of!(cmsghdr, cmsg_len) != 0 { bad += 1 }
    if offset_of!(cmsghdr, cmsg_level) != 4 { bad += 1 }
    if offset_of!(cmsghdr, cmsg_type) != 8 { bad += 1 }
    if mem::size_of<cmsghdr>() != 12 { bad += 1 }
    if mem::align_of<cmsghdr>() != 4 { bad += 1 }
    if offset_of!(sf_hdtr, headers) != 0 { bad += 1 }
    if offset_of!(sf_hdtr, hdr_cnt) != 8 { bad += 1 }
    if offset_of!(sf_hdtr, trailers) != 16 { bad += 1 }
    if offset_of!(sf_hdtr, trl_cnt) != 24 { bad += 1 }
    if mem::size_of<sf_hdtr>() != 32 { bad += 1 }
    if mem::align_of<sf_hdtr>() != 8 { bad += 1 }
    bad
}
