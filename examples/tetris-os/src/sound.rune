// The SoundBlaster 16: eight voices mixed into a 16-bit buffer the card
// plays by DMA, refilled half at a time on its interrupt. From sound.h and
// sound.c (MIT; see LICENSE).
import tetris::irq
import tetris::isr
import tetris::math
import tetris::port
import tetris::serial
import tetris::system

pub let voices: i64 = 8
pub let rest: u8 = 12

pub let waveSin: u8 = 0
pub let waveSquare: u8 = 1
pub let waveNoise: u8 = 2
pub let waveTriangle: u8 = 3

