// The card, at base port 0x220.
let mixer: u16 = 548            // 0x224
let mixerData: u16 = 549        // 0x225
let dspReset: u16 = 550         // 0x226
let dspRead: u16 = 554          // 0x22A
let dspWrite: u16 = 556         // 0x22C
let dspReadStatus: u16 = 558    // 0x22E
let dspAck16: u16 = 559         // 0x22F

let mixerIrq: i64 = 5
let sampleRate: i64 = 48000
/// 30 ms of samples, played as two halves: one plays while the other fills.
let bufferSize: i64 = 1440

global var buffer: [1440:i16] = [0; 1440]
global var flip: bool = false
global var sample: u64 = 0

global var master: u8 = 0
global var volumes: [8:u8] = [0; 8]
global var notes: [8:u8] = [0; 8]
global var waves: [8:u8] = [0; 8]

pub fn note(index: i64, octave: u8, n: u8) { notes[index] = (octave << 4) | n }
pub fn volume(index: i64, v: u8) { volumes[index] = v }
pub fn setMaster(v: u8) { master = v }
pub fn wave(index: i64, w: u8) { waves[index] = w }

/// `count` samples into the buffer from `start`: every voice that is
/// playing, as its wave, at its volume, added up.
fn fill(start: i64, count: i64) {
    for i in 0..count {
        var f = 0.0
        for j in 0..voices {
            let octave = ((notes[j] >> 4) & 15) as i64
            let n = (notes[j] & 15) as i64
            if n == rest as i64 { continue }
            let frequency = frequencies[octave * 12 + n] / (sampleRate as f64)
            let t = sample as f64
            var d = 0.0
            let w = waves[j]
            if w == waveSin {
                d = math::sin(2.0 * math::pi * t * frequency)
            } else if w == waveSquare {
                d = if math::sin(2.0 * math::pi * t * frequency) >= 0.0 { 1.0 } else { -1.0 }
            } else if w == waveTriangle {
                d = math::fabs(math::fmod(4.0 * (t * frequency) + 1.0, 4.0) - 2.0) - 1.0
            } else if w == waveNoise {
                let offset = (frequency * 128.0) *
                             ((system::rand() as f64) / 4294967295.0 - 0.5)
                d = math::fabs(math::fmod(4.0 * (t * frequency + offset) + 1.0, 4.0) - 2.0) - 1.0
            }
            f += d * ((volumes[j] as f64) / 255.0)
        }
        buffer[start + i] = (((master as f64) / 255.0) * 4096.0 * f) as i16
        // Wrapped rather than left to grow, as the original does, so a
        // double never loses the precision the phase needs.
        sample = (sample + 1) % 16777216
    }
}

fn dspOut(b: u8) {
    while (port::inb(dspWrite) & 128) != 0 {}
    port::outb(dspWrite, b)
}

/// Resets the DSP and checks it is a SoundBlaster 16 (version 4 or later).
fn reset() {
    port::outb(dspReset, 1)
    var i: i64 = 0
    while i < 100000 { i += 1 }     // a few microseconds, generously
    port::outb(dspReset, 0)
    if (port::inb(dspReadStatus) & 128) == 0 { fail("SB16 DID NOT RESET") }
    if port::inb(dspRead) != 170 { fail("NO SB16 FOUND") }        // 0xAA
    port::outb(dspWrite, 225)                                     // 0xE1: version
    let major = port::inb(dspRead)
    let minor = port::inb(dspRead)
    serial::print("sb16: dsp version ")
    serial::number(major as i64)
    serial::print(".")
    serial::number(minor as i64)
    serial::line("")
    if major < 4 { fail("SB16 IS TOO OLD") }
}

fn fail(message: CString) -> Never {
    serial::line(message)
    system::panicScreen(message)
    port::halt()
}

fn setSampleRate(hz: u16) {
    dspOut(65)                      // 0x41
    dspOut((hz >> 8) as u8)
    dspOut((hz & 255) as u8)
}

/// Points DMA channel 5 at the buffer, in auto-init mode. A 16-bit channel
/// counts in words and cannot cross a 128 KB boundary, which the original
/// left to chance; here it is checked.
@safe("hands the DMA controller the address of a buffer that lives for ever")
fn transfer() {
    let address = unsafe { &var buffer[0] as *var u8 as usize }
    let end = address + (bufferSize as usize) * 2 - 1
    if address >= 16777216 || (address >> 17) != (end >> 17) {
        fail("THE SOUND BUFFER CROSSES A DMA BOUNDARY")
    }
    port::outb(212, 5)              // 0xD4: mask channel 5
    port::outb(216, 1)              // 0xD8: clear the flip-flop
    port::outb(214, 89)             // 0xD6: channel 5, auto-init, playback
    let offset = ((address / 2) % 65536) as u16
    port::outb(196, (offset & 255) as u8)           // 0xC4: address
    port::outb(196, (offset >> 8) as u8)
    let count = (bufferSize - 1) as u16
    port::outb(198, (count & 255) as u8)            // 0xC6: count
    port::outb(198, (count >> 8) as u8)
    port::outb(139, (address >> 16) as u8)          // 0x8B: page
    port::outb(212, 1)              // unmask channel 5
}

/// The card has played half the buffer: refill that half.
fn interrupt(regs: *var isr::Registers) {
    flip = !flip
    fill(if flip { 0 } else { bufferSize / 2 }, bufferSize / 2)
    let status = port::inb(dspReadStatus)
    let ack = port::inb(dspAck16)
}

fn configure() {
    irq::install(mixerIrq, interrupt)
    port::outb(mixer, 128)          // 0x80: interrupt setup
    port::outb(mixerData, 2)        // IRQ 5
}

pub fn init() {
    irq::install(mixerIrq, interrupt)
    reset()
    configure()
    transfer()
    setSampleRate(sampleRate as u16)
    let samples = (bufferSize / 2 - 1) as u16
    dspOut(182)                     // 0xB6: 16-bit output, auto-init
    dspOut(16)                      // 0x10: signed, mono
    dspOut((samples & 255) as u8)
    dspOut((samples >> 8) as u8)
    dspOut(209)                     // 0xD1: speaker on
    dspOut(214)                     // 0xD6: continue 16-bit DMA
    for i in 0..voices {
        notes[i] = rest
        waves[i] = waveSin
    }
}
