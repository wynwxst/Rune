/// How wide `text` is when drawn, in pixels.
pub fn width(text: CString) -> i64 { screen::length(text) * 8 }

pub fn height() -> i64 { 8 }

/// One character with its top-left corner at `x`, `y`. A character outside
/// ASCII is a checked index into `glyphs`, and fails like one.
pub fn char(c: u8, x: i64, y: i64, colour: u8) {
    let glyph = glyphs[c as i64]
    for yy in 0..8 {
        for xx in 0..8 {
            if (glyph[yy] & ((1 as u8) << (xx as u8))) != 0 {
                screen::set(colour, x + xx, y + yy)
            }
        }
    }
}

/// A string, left to right, eight pixels a character.
@safe("a CString ends at its NUL, and nothing past it is read")
pub fn str(text: CString, x: i64, y: i64, colour: u8) {
    let bytes = unsafe { text as *u8 }
    var i: i64 = 0
    while unsafe { bytes[i] } != 0 {
        char(unsafe { bytes[i] }, x + i * 8, y, colour)
        i += 1
    }
}

/// A string with a darker copy one pixel down and right: the game's
/// shadowed text.
pub fn strDoubled(text: CString, x: i64, y: i64, colour: u8) {
    str(text, x + 1, y + 1, screen::add(colour, -2))
    str(text, x, y, colour)
}
