// `Option` and `Result` are ordinary Rune enums that the compiler knows by
// name, so `T?`, `nil`, `??` and `?` are all sugar over them.
//
//     runec -o option_result examples/option_result.rune && ./option_result

import std::io
import std::option
import std::result

//===--------------------------------------------------------------------===//
// Option
//===--------------------------------------------------------------------===//
//
// `Option` and its variants are in scope everywhere; no import is needed to
// write `Some(x)` or `None`.

/// `T?` is exactly `Option<T>`.
fn firstEven(values: [6:i64]) -> i64? {
    for v in values {
        if v % 2 == 0 { return v }
    }
    nil                                  // `nil` is `Option::None`
}

/// `?` returns early when the option is empty.
fn halfOfFirstEven(values: [6:i64]) -> i64? {
    let found = firstEven(values)?
    found / 2
}

/// Options are matched like any other enum.
fn describe(value: i64?) -> String {
    match value {
        Some(v) => "found " + v.$str(),
        None => "nothing",
    }
}

//===--------------------------------------------------------------------===//
// Result
//===--------------------------------------------------------------------===//

type Parsed = result::Result<i64, String>

fn parse(text: String) -> Parsed {
    match text.$toInt() {
        Some(n) => Ok(n),
        None => Err("'" + text + "' is not a number"),
    }
}

/// `?` on a Result passes the error straight out, unchanged.
fn addAll(a: String, b: String, c: String) -> Parsed {
    let x = parse(a)?
    let y = parse(b)?
    let z = parse(c)?
    Ok(x + y + z)
}

fn report(r: Parsed) -> String {
    match r {
        Ok(v) => "ok: " + v.$str(),
        Err(e) => "error: " + e,
    }
}

//===--------------------------------------------------------------------===//

fn main() -> i64 {
    let evens: [6:i64] = [1, 3, 8, 5, 7, 9]
    let odds: [6:i64] = [1, 3, 5, 7, 9, 11]

    io::println("-- Option --")
    io::println(describe(firstEven(evens)))
    io::println(describe(firstEven(odds)))

    // Three ways to get at the value.
    io::println("or        = " + firstEven(odds).or(-1).$str())
    io::println("coalesce  = " + (firstEven(odds) ?? -2).$str())
    io::println("unwrap    = " + firstEven(evens).unwrap().$str())
    io::println("hasValue  = " + firstEven(evens).hasValue().$str())
    io::println("isNil     = " + firstEven(odds).isNil().$str())
    io::println("chained   = " + describe(halfOfFirstEven(evens)))
    io::println("chained   = " + describe(halfOfFirstEven(odds)))

    // Built explicitly, when there is no context to infer from.
    let explicit = option::some(7)
    let empty = option::none::<i64>()
    io::println("explicit  = " + describe(explicit) + ", " + describe(empty))

    io::println("")
    io::println("-- Result --")
    io::println(report(addAll("1", "2", "3")))
    io::println(report(addAll("1", "nope", "3")))
    io::println("isOk      = " + addAll("1", "2", "3").isOk().$str())
    io::println("isErr     = " + addAll("x", "2", "3").isErr().$str())
    io::println("or        = " + addAll("x", "2", "3").or(-1).$str())

    // A Result converts to an Option when the reason no longer matters.
    io::println("ok()      = " + describe(addAll("4", "5", "6").ok()))
    io::println("ok()      = " + describe(addAll("x", "5", "6").ok()))

    // ...and the error can be inspected on its own.
    match addAll("x", "5", "6").error() {
        Some(message) => io::println("error()   = " + message),
        None => io::println("error()   = none"),
    }
    0
}
