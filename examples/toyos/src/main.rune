@runtime(none)
@entry(none)
// toyos: a small operating system kernel in Rune.
//
// `@runtime(none)` builds it freestanding: no C library, no hosted runtime,
// just this code and the Rune-written runtime the compiler brings along.
// `@entry(none)` says it has no `main` — boot/boot.s calls `kernel_main`.
//
// It boots, looks at what the loader handed it, runs a handful of checks of
// the machine and of itself, and switches the machine off — QEMU exits 0, or
// 5 if a check failed. Boot it with
// `-append panic` and it trips a bounds check on purpose instead, to show
// where a failed safety check goes on bare metal: to `panicked`, below.
import toyos::console
import toyos::cpu
import toyos::heap
import toyos::multiboot
import toyos::process
import std::collections::vector
import std::dictionary
import std::io
import std::fmt

extern "C" {
    /// The initialisers of the kernel's globals that are not simply zero —
    /// generated by the compiler, since there is no `main` to run them.
    fn rune_init()
}

@export("kernel_main")
fn kernelMain(magic: u32, infoAddress: u32) -> Never {
    unsafe { rune_init() }
    console::init()
    console::line("toyos 0.1 - a kernel written in Rune")
    console::line("")

    let info = multiboot::read(infoAddress)
    console::check(magic == multiboot::bootMagic, "booted by a multiboot loader")
    if multiboot::hasMemory(&info) {
        console::print("       memory: ")
        console::printNumber(info.memLower as i64)
        console::print(" KB low, ")
        console::printNumber(info.memUpper as i64 / 1024)
        console::line(" MB above 1 MB")
    }

    arithmetic()
    safetyChecksAreOn()
    theHeap()
    theStandardLibrary()
    text()
    scheduling()

    console::line("")
    if multiboot::contains(multiboot::commandLine(&info), "panic") {
        console::line("command line says panic: indexing past the end of an array")
        let table: [4:i64] = [1, 2, 3, 4]
        let index = 4 + (info.flags & 0) as i64     // 4, but not a constant
        console::printNumber(table[index])
    }
    if console::failures > 0 {
        console::printNumber(console::failures)
        console::line(" checks failed")
        cpu::exitWith(2)
    }
    console::line("all checks passed; switching off")
    cpu::powerOff()
}

/// 64-bit numbers on a 32-bit processor: every `/` and `%` here is a call to
/// the division helpers in the freestanding runtime.
fn arithmetic() {
    let big: i64 = 9876543210123
    console::check(big / 1000 == 9876543210 && big % 1000 == 123,
                   "64-bit division on a 32-bit processor")
    let negative: i64 = -7000000000001
    console::check(negative / 1000 == -7000000000 && negative % 1000 == -1,
                   "signed 64-bit division rounds toward zero")
    let unsigned: u64 = 18446744073709551615
    console::check(unsigned / 4294967296 == 4294967295,
                   "unsigned 64-bit division")
}

/// A checked index that is in range, and wrapping arithmetic where overflow
/// is meant: `--safety full` checks every index and every `+`, and neither
/// of these may trip it.
fn safetyChecksAreOn() {
    let squares: [8:i64] = [0, 1, 4, 9, 16, 25, 36, 49]
    var sum: i64 = 0
    for i in 0..8 { sum += squares[i] }
    console::check(sum == 140, "bounds-checked indexing")
    let max: i64 = 9223372036854775807
    console::check(max.$wrappingAdd(1) == -9223372036854775807 - 1,
                   "wrapping arithmetic where it is asked for")
}

class Buffer {
    pub var bytes: [64:u8] = [0; 64]
    pub var label: i64 = 0
    fn init(self, label: i64) { self.label = label }
}

/// Objects on the kernel heap: made, used, and handed back when their owner
/// is done — and the space reused, not lost.
fn theHeap() {
    let before = heap::allocations
    {
        let a = Buffer(1)
        let b = Buffer(2)
        console::check(a.label + b.label == 3 && heap::allocations == before + 2,
                       "two objects on the kernel heap")
    }
    console::check(heap::bytesInUse == 0, "both freed when their owner went away")
    // Freed in the reverse of the order they were made, the two blocks
    // merged into one; a third object is cut from that, not carved anew.
    let carved = heap::carvedBytes()
    {
        let c = Buffer(3)
        console::check(c.label == 3 && heap::carvedBytes() == carved,
                       "freed space is reused")
    }
}

/// The standard library's containers, on the kernel heap. They allocate
/// through `std::mem`, which the freestanding runtime answers from the
/// kernel's own `@allocator` — growing a vector copies it into a bigger
/// block, by the size the runtime keeps in front of each one.
fn theStandardLibrary() {
    {
        var squares = vector::Vector<i64>()
        for i in 0..100 { squares.push(i * i) }
        var sum: i64 = 0
        for s in &squares { sum += *s }
        console::check(squares.length() == 100 && sum == 328350 &&
                       *squares.look(99) == 9801,
                       "a Vector grown to 100 elements")

        var ages = dictionary::Map<i64, i64>()
        for i in 0..40 { ages[i] = i * 2 }
        ages[7] = 70
        console::check(ages.length() == 40 && ages[7] == 70 && ages[39] == 78,
                       "a Map of 40 entries, one replaced")

        var seen = dictionary::Set<i64>()
        for i in 0..10 { seen.add(i % 4) }
        var members: i64 = 0
        for m in seen { members += *m }
        console::check(seen.length() == 4 && members == 6,
                       "a Set, iterated")
    }
    console::check(heap::bytesInUse == 0, "every container handed its memory back")
}

/// `String`, `+`, interpolation and `std::fmt`, on bare metal: the
/// freestanding runtime makes them over the kernel heap, and `io::println`
/// writes through `@output` — the console, below.
fn text() {
    let name: String = "toyos"
    let pi = 3.14159
    let greeting = format!("hello from {name}, {pi} and {}", 7 * 6)
    console::check(greeting == "hello from toyos, 3.14159 and 42", "a String, interpolated")
    console::check(fmt::fixed(2.0 / 3.0, 3) == "0.667" && (1.5e300).$str() == "1.5e+300" &&
                   (0.1 + 0.2).$str() == "0.30000000000000004",
                   "numbers written as the hosted runtime writes them")
    let half: String = "2.5"
    let negative: String = "-17"
    console::check((half.$toFloat() ?? 0.0) == 2.5 && (negative.$toInt() ?? 0) == -17,
                   "and read back")
    println!("       println!, through @output: {greeting}")
}

/// Where `io::println` goes: the console, as the kernel's own printing does.
@output
@safe("writes the bytes the caller says it has")
fn consoleOutput(bytes: *u8, count: usize) {
    var i: usize = 0
    while i < count {
        console::putByte(unsafe { bytes[i as i64] })
        i += 1
    }
}

/// Processes on a round-robin scheduler, each owned by the one before it.
fn scheduling() {
    console::line("       spawning three processes")
    {
        var s = process::Scheduler()
        s.spawn("init", 3)
        s.spawn("shell", 5)
        s.spawn("logger", 2)
        let turns = s.runAll(2)
        console::check(s.totalDone() == 10 && turns == 3,
                       "round-robin: 10 units of work in 3 turns of 2")
    }
    console::check(heap::bytesInUse == 0, "every process reaped, every byte back")
    console::print("       heap: ")
    console::printNumber(heap::allocations)
    console::print(" allocations, ")
    console::printNumber(heap::frees)
    console::print(" frees, ")
    console::printNumber(heap::carvedBytes())
    console::line(" bytes carved")
}

/// Where every failed check in the kernel ends up: bounds, overflow,
/// division by zero, an empty `Option` unwrapped. It says what and where on
/// both outputs, then ends the run with status 1 — which QEMU's debug-exit
/// device turns into its own exit status, 3.
@panicHandler
fn panicked(message: CString, location: CString) -> Never {
    console::line("")
    console::setColour(console::Colour::Bad)
    console::print("KERNEL PANIC: ")
    console::print(message)
    console::setColour(console::Colour::Normal)
    console::line("")
    console::print("  at ")
    console::line(location)
    cpu::exitWith(1)
}
