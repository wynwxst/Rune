// logger — lines with a level, a prefix, and a threshold.

import std::io

/// How important a line is. A logger prints what is at or above its level.
pub enum Level { Debug, Info, Warn, Error }

pub fn levelName(l: Level) -> String {
    match l {
        Level::Debug => "debug",
        Level::Info => "info",
        Level::Warn => "warn",
        Level::Error => "error",
    }
}

fn rank(l: Level) -> i64 { l as i64 }

/// A logger: a class, so one can be shared by everything that logs.
pub class Logger {
    pub prefix: String
    pub threshold: Level
    /// How many lines were printed, and how many were dropped as too quiet.
    pub printed: i64
    pub dropped: i64
    /// Where the lines go: standard error by default.
    pub toStdout: bool

    fn init(&self, prefix: String, threshold: Level) {
        self.prefix = prefix
        self.threshold = threshold
        self.printed = 0
        self.dropped = 0
        self.toStdout = false
    }

    /// The line, when `level` clears the threshold.
    pub fn log(&var self, level: Level, message: String) {
        if rank(level) < rank(self.threshold) {
            self.dropped += 1
            return
        }
        self.printed += 1
        let line = "[" + self.prefix + " " + levelName(level) + "] " + message
        if self.toStdout { io::println(line) } else { io::eprintln(line) }
    }

    pub fn debug(&var self, message: String) { self.log(Level::Debug, message) }
    pub fn info(&var self, message: String) { self.log(Level::Info, message) }
    pub fn warn(&var self, message: String) { self.log(Level::Warn, message) }
    pub fn error(&var self, message: String) { self.log(Level::Error, message) }

    /// The same logger, one level less talkative.
    pub fn quieter(&var self) {
        self.threshold = match self.threshold {
            Level::Debug => Level::Info,
            Level::Info => Level::Warn,
            _ => Level::Error,
        }
    }
}

/// A logger that prints everything at `Info` and above to standard error.
pub fn standard(prefix: String) -> Logger { Logger(prefix, Level::Info) }
