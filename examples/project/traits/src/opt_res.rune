extern "C" {
    printf(content: CString, ...) -> i32

}

pub fn checked_division(dividend: i32, divisor: i32) -> Option<i32> {
    if divisor == 0 {
        // Failure is represented as the `None` variant
        None
    } else {
        // Result is wrapped in a `Some` variant
        Some(dividend / divisor)
    }
}


#safe("Type Checked")
pub fn try_division(dividend: i32, divisor: i32) {
    // `Option` values can be pattern matched, just like other enums
    match checked_division(dividend, divisor) {
        None => printf("%d / %d failed!\n", dividend, divisor),
        Some(quotient) => {
            printf("%d / %d = %d\n", dividend, divisor, quotient)
        },
    }
}

