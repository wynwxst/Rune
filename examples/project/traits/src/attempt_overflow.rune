#type(Exec)
// A bounds check doing its job: reading past the end of a `Buffer` aborts,
// naming the index, rather than handing back whatever was in that memory.
import std::io
import std::mem

fn main() -> i64 {
    var buffer = mem::filled<i64>(100, 20)
    io::println("Buffer[5] = " + buffer[5].$str())
    buffer[100]                     // out of range: this aborts
    0
}
