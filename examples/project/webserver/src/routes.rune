// webserver::routes — what the server actually says.
//
// Routing is a `match` on the path rather than a table, on purpose: a table
// would have to be shared between the worker threads, and a `match` is a
// function every worker already has its own copy of the code for. Adding a
// page means adding an arm.

import std::io
import webserver::http
import std::time

/// When the process started, so `/time` has something to measure against.
/// A monotonic reading, so it is unaffected by the clock being set.
global startedAt: time::Instant = time::now()

/// The answer to one request.
pub fn answer(request: http::Request) -> http::Response {
    if request.method != "GET" && request.method != "HEAD" {
        return http::failure(405, "Method Not Allowed")
    }

    match request.path {
        "/" => home(),
        "/health" => http::text("ok\n"),
        "/time" => http::json("{\"uptimeNanos\": " +
                              startedAt.elapsed().asNanoseconds().$str() +
                              "}\n"),
        "/echo" => echo(request),
        _ => http::failure(404, "Not Found"),
    }
}

fn home() -> http::Response {
    http::html(
        "<!doctype html>\n" +
        "<html lang=\"en\">\n" +
        "<head><meta charset=\"utf-8\"><title>rune-webserver</title></head>\n" +
        "<body>\n" +
        "  <h1>It works</h1>\n" +
        "  <p>Served by a Rune worker pool over <code>std::net</code>.</p>\n" +
        "  <ul>\n" +
        "    <li><a href=\"/health\">/health</a></li>\n" +
        "    <li><a href=\"/time\">/time</a></li>\n" +
        "    <li><a href=\"/echo?hello\">/echo</a></li>\n" +
        "  </ul>\n" +
        "</body>\n</html>\n")
}

/// Reads back what was asked, which is the quickest way to see that parsing
/// worked.
fn echo(request: http::Request) -> http::Response {
    var out = request.method + " " + request.path + " " + request.version + "\n"
    if !request.query.$isEmpty() {
        out += "query: " + request.query + "\n"
    }
    out += "headers:\n"
    for line in request.headers {
        out += "  " + http::headerName(line) + ": " +
               http::headerValue(line) + "\n"
    }
    if !request.body.$isEmpty() {
        out += "body:\n" + request.body + "\n"
    }
    http::text(out)
}
