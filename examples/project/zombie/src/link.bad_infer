struct LinkList<T> {
    value: T?
    next: Handle<LinkList<T>>?



    pub fn add(&var self, value: T, count: int = 0) {
        match self.value {
            None => {
                self.value = value
            },
            Some(val) => {
                match &self.next { /* compiler should mention that a value needs to be borrowed 
                    otherwise it gets 'taken' leaving it empty */
                    None => {
                        println!("{count}: Next'd!")
                        self.next = Handle(LinkList{value: value, next: nil})
                    },
                    Some(handle) => {
                        println!("{count} : Recurse")
                        (*handle).add(value, count+1)
                    }
                }
            }
        }
    }

    @safe("Read only reference")
    pub fn get(&self, idx: int) -> T? {
        var ll = self
        for i in 0..idx {
            println!("Entry!")
            ptr = &ll.next
            match ll.next {
                Some(handle) => {
                    ll = handle.get_ref()
                },
                None => {
                    println!("No next!")
                    return nil
                }
            }
        }
        println!("Exit!")
        (*ll).value
    }
}

pub fn LinkedList_new<T>() -> LinkList<T> {
    LinkList<T> {value: nil, next: nil}
}





class LL<T> {
    head: LNode<T>

    fn init(&self){
        self.head = nil
    }

    fn add(&var self,value: T){
        let new_node: LNode<T> = Handle(Node{value: value, next: None}) /* improve generic resolution */
        match &self.head {
            Some(Head) => {

            },
            _ => {
                self.head = take(new_node)
            }
        } 
    }
}




type LNode<T> = Option<Handle<Node<T>>>

struct Node<T> {
    value: T 
    next: LNode<T>
}

