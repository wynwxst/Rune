@type(Executable)
import std::mem::*
import std::testing
// fix having to import testing for assert!

pub enum List<T> {
    Link{ handle: Handle<List<T>>?, value: T }
    Empty

    pub fn new(self) -> List<T> {
        Empty
    }

    pub fn prepend(self, value: T) -> List<T> {
        List::Link {handle: Handle<List<T>>(self), value: value}
    }

    pub fn get(&self, idx: int, count: int = 0) -> T? {
        println!("{idx}, {count}")
        if idx < count {
            return nil
        }
        match self {
            List::Link {handle, value} => {
                if idx == count {
                    return value
                }
                match handle {
                    Some(Handle) => {
                        (*Handle).get(idx,count+1)
                    },
                    None => {
                        nil
                    }
                }
            },
            Empty => {
                nil
            }
        }
    }

}

