import std::{io, mem}

struct Book {
    // `&'static str` is a reference to a string allocated in read only memory
    author: &String,
    title: &String,
    year: u32,
}

// This function takes a reference to a book
fn borrow_book(book: &Book) {
    println!("I immutably borrowed {} - {} edition", book.title, book.year);
}

// This function takes a reference to a mutable book and changes `year` to 2014
fn new_edition(book: &var Book) {
    book.year = 2014;
    title = book.title
    println!("I mutably borrowed {} - {} edition", title, book.year);
}

fn tnew_edition(book: &var Book) {
    book.year = 2014;
    println!("I T mutably borrowed {} - {} edition", book.title, book.year);
}

fn longest(a: &String from a, b: &String from b) -> &String from (a, b) {
    if a.$length() > b.$length() { a } else { b }
}

fn main() -> i64 {
    var score = 10
    door = 20

    let ref1 = &var score;
    *ref1 = 3030
    let ref2 = &var score;
    println!("{}",*ref2)


    // Create an immutable Book named `immutabook`
    let immutabook = Book {
        // string literals have type `&'static str`
        author: "Douglas Hofstadter",
        title: "Gödel, Escher, Bach",
        year: 1979,
    };


    // Immutably borrow an immutable object
    borrow_book(&immutabook);

    // Create a mutable copy of `immutabook` and call it `mutabook`
    var mutabook = immutabook;


    // Immutably borrow a mutable object
    borrow_book(&mutabook);

    // Borrow a mutable object as mutable
    new_edition(&var mutabook);

    //borrow_book(&immutabook)

    // Error! Cannot borrow an immutable object as mutable
    //new_edition(&mut immutabook);
    // FIXME ^ Comment out this line
    {test = "Hello World"
    longest(mutabook.title, test)}

    0
}
