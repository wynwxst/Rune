// Every shape that crosses the boundary, checked.

import std::testing
import ffi

fn double(x: i64) -> i64 { x * 2 }

fn main() -> i64 {
    // A struct by value, in and back out.
    let p = ffi::Point { x: 3.0, y: 4.0 }
    assertEq!(ffi::lengthSquared(p), 25.0)
    let bigger = ffi::scale(p, 2.0)
    assertEq!(bigger.x, 6.0)
    assertEq!(bigger.y, 8.0)

    // A pointer and a count.
    assertEq!(ffi::sum([1, 2, 3, 4]), 10)
    assertEq!(ffi::sum([]), 0)

    // Results written back through pointers.
    let split = ffi::divideWithRemainder(17, 5)
    assertEq!(split.0, 3)
    assertEq!(split.1, 2)

    // A Rune function called from C, three times over.
    assertEq!(ffi::applyTimes(double, 1, 3), 8)
    assertEq!(ffi::applyTimes(ffi::triple, 1, 2), 9)

    // Strings, both directions.
    assertEq!(ffi::shimName(), "shim")
    assertEq!(ffi::cLength("hello"), 5 as u64)
    assertEq!(ffi::cLength("" + "ab" + "c"), 3 as u64)

    testing::summary()
}
