// The Rune side of the boundary.
//
// An `extern "C"` block declares what exists on the other side. Nothing is
// generated and nothing is marshalled: Rune's scalars *are* C's scalars, and a
// struct of them has the same layout C gives it.

import std::io

/// Two doubles, laid out exactly as the C `shim_Point` is.
pub struct Point { x: f64, y: f64 }

extern "C" {
    // A struct crosses as a pointer. Passing one by value is not portable:
    // Windows x64 puts an aggregate in a register only at 1, 2, 4 or 8 bytes
    // and passes anything else indirectly, so a `Point` would be misread.
    fn shim_length_sq(p: *Point) -> f64
    fn shim_scale(p: *Point, k: f64, out: *var Point)
    fn shim_sum(values: *i64, count: i64) -> i64
    fn shim_divmod(a: i64, b: i64, quotient: *var i64, remainder: *var i64)
    // `@cfunction` is a bare C function pointer. `@function` would be a Rune
    // closure — two words, one of them an environment C has nowhere to put.
    fn shim_apply(f: @cfunction(i64) -> i64, x: i64, times: i64) -> i64
    fn shim_name() -> CString
    fn shim_length(text: CString) -> u64
}

/// `#safe` records why a foreign call needs no `unsafe` at each use: the
/// reason is written once, beside the function that knows it.
#safe("the shim is total over every value these wrappers accept")
pub fn lengthSquared(p: Point) -> f64 {
    unsafe { shim_length_sq(&p as *Point) }
}

/// The wrapper keeps the pointers inside it, so callers see an ordinary
/// function that takes a `Point` and returns one.
pub fn scale(p: Point, factor: f64) -> Point {
    var out = Point { x: 0.0, y: 0.0 }
    unsafe { shim_scale(&p as *Point, factor, &var out as *var Point) }
    out
}

/// A slice hands C a pointer and a count — the two halves C expects.
pub fn sum(values: [i64]) -> i64 {
    if values.$isEmpty() { return 0 }
    unsafe { shim_sum(&values[0] as *i64, values.$length() as i64) }
}

/// C returns two results the only way it can: by writing through pointers.
/// `&var x as *var i64` is how a Rune variable's address becomes one.
pub fn divideWithRemainder(a: i64, b: i64) -> (i64, i64) {
    var quotient: i64 = 0
    var remainder: i64 = 0
    unsafe {
        shim_divmod(a, b, &var quotient as *var i64, &var remainder as *var i64)
    }
    (quotient, remainder)
}

/// A top-level `fn` has no captured state, so its address alone is a valid C
/// function pointer and it converts where one is wanted.
pub fn applyTimes(f: @cfunction(i64) -> i64, start: i64, times: i64) -> i64 {
    unsafe { shim_apply(f, start, times) }
}

/// `CString` is a borrowed pointer to NUL-terminated bytes. `.$str()` copies
/// it into a Rune `String`, which owns its own storage.
#safe("the shim returns a string literal, which outlives every caller")
pub fn shimName() -> String { shim_name().$str() }

/// Going the other way: a Rune `String` is a counted buffer, so C gets its
/// `.$cstr()` view — valid for the duration of the call and no longer.
pub fn cLength(text: String) -> u64 { unsafe { shim_length(text.$cstr()) } }

/// `#export` fixes the symbol name so C can find it. This one is called by
/// `shim_apply` above, through the pointer `applyTimes` hands over.
#export("ffi_triple")
pub fn triple(x: i64) -> i64 { x * 3 }

pub fn describe() {
    io::println("linked against " + shimName())
}

//===--------------------------------------------------------------------===//
// The C++ half
//
// `extern "C++"` declares what a C++ library exports. The difference from
// `extern "C"` is not the syntax but what the compiler does with it: the
// symbol is the one the Itanium ABI gives the declaration — scope, name and
// parameter types folded together — and each argument crosses the way the
// target's *C++* ABI passes it, which for a struct is not how it passes a
// pointer. Both are decided per target, so this cross-compiles like the rest.
//===--------------------------------------------------------------------===//

extern "C++" {
    namespace shim {
        /// A struct declared here is C++'s, laid out identically, and may
        /// cross by value — the compiler knows how that target passes it.
        pub struct Vec2 { x: f64, y: f64 }
        pub struct Pair { a: c_int, b: c_int }
        pub struct Wide { a: c_long, b: c_long, c: c_long }
        pub struct Span<T> { data: *T, len: c_ulong }
        pub enum Colour { Red = 1, Green = 2, Blue = 4 }

        fn lengthSq(v: Vec2) -> f64
        fn scaled(v: Vec2, k: f64) -> Vec2
        fn swapped(p: Pair) -> Pair
        fn tripled(w: Wide) -> Wide
        fn sumRef(p: &Pair) -> c_int          // `const Pair &`
        fn bump(x: &var c_int, by: c_int)     // `int &`
        fn total(s: Span<c_long>) -> c_long
        fn totalD(s: Span<f64>) -> f64
        fn brighter(c: Colour) -> Colour
        var liveCounters: c_int

        /// A C++ `class` is opaque: Rune never holds one by value, only a
        /// pointer to one. `#size` is what lets `cxx::alloc` make room.
        #size(8)
        pub class Counter {
            fn init(&var self, start: c_int)   // Counter::Counter(int)
            fn deinit(&var self)               // Counter::~Counter()
            fn next(&var self) -> c_int
            fn peek(&self) -> c_int            // a const member
            fn setStep(&var self, step: c_int)
            fn state(&self) -> Pair
            fn make(start: c_int) -> *var Counter    // static
            fn destroy(c: *var Counter)
        }

        #size(8)
        pub class Stepper : Counter {
            fn init(&var self, start: c_int, step: c_int)
            fn twice(&var self) -> c_int
        }
    }
}

/// The C++ struct shapes, wrapped so callers see ordinary Rune values.
#safe("these are total over every double and every int")
pub fn vectorLengthSquared(v: Vec2) -> f64 { lengthSq(v) }

#safe("as above")
pub fn vectorScaled(v: Vec2, factor: f64) -> Vec2 { scaled(v, factor) }

#safe("as above")
pub fn pairSwapped(p: Pair) -> Pair { swapped(p) }

#safe("as above")
pub fn wideTripled(w: Wide) -> Wide { tripled(w) }

#safe("the borrow is live for the call, which is all the reference needs")
pub fn pairSum(p: Pair) -> i64 { sumRef(&p) as i64 }

/// A C++ `int &` out-parameter, kept inside the wrapper.
#safe("the borrow names a local that outlives the call")
pub fn bumped(start: i64, by: i64) -> i64 {
    var x = start as c_int
    bump(&var x, by as c_int)
    x as i64
}

/// A slice's two halves are exactly what a C++ span holds.
#safe("the pointer and the count come from one slice, so the extent is right")
pub fn totalOf(values: [c_long]) -> i64 {
    if values.$isEmpty() { return 0 }
    total(Span<c_long> { data: &values[0] as *c_long,
                         len: values.$length() as c_ulong }) as i64
}

#safe("as above")
pub fn totalOfDoubles(values: [f64]) -> f64 {
    if values.$isEmpty() { return 0.0 }
    totalD(Span<f64> { data: &values[0] as *f64,
                       len: values.$length() as c_ulong })
}

#safe("an enum declared in the block is C++'s `int`, and every value is one")
pub fn nextColour(c: Colour) -> Colour { brighter(c) }

/// How many C++ `Counter`s exist. The destructor is what brings it back down,
/// so a test that makes one and destroys it can see both happen.
#safe("reading an `int` the C++ half owns")
pub fn liveCount() -> i64 { liveCounters as i64 }
