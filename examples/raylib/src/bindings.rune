//=== Layout ===

/// How many of these structs differ in size, alignment or member offsets
/// from what the C compiler gives them. Zero, on the target they were
/// written for.
pub fn layoutMismatches() -> i64 {
    var bad = 0
    if offset_of!(Vector2, x) != 0 { bad += 1 }
    if offset_of!(Vector2, y) != 4 { bad += 1 }
    if mem::size_of<Vector2>() != 8 { bad += 1 }
    if mem::align_of<Vector2>() != 4 { bad += 1 }
    if offset_of!(Vector3, x) != 0 { bad += 1 }
    if offset_of!(Vector3, y) != 4 { bad += 1 }
    if offset_of!(Vector3, z) != 8 { bad += 1 }
    if mem::size_of<Vector3>() != 12 { bad += 1 }
    if mem::align_of<Vector3>() != 4 { bad += 1 }
    if offset_of!(Vector4, x) != 0 { bad += 1 }
    if offset_of!(Vector4, y) != 4 { bad += 1 }
    if offset_of!(Vector4, z) != 8 { bad += 1 }
    if offset_of!(Vector4, w) != 12 { bad += 1 }
    if mem::size_of<Vector4>() != 16 { bad += 1 }
    if mem::align_of<Vector4>() != 4 { bad += 1 }
    if offset_of!(Matrix, m0) != 0 { bad += 1 }
    if offset_of!(Matrix, m4) != 4 { bad += 1 }
    if offset_of!(Matrix, m8) != 8 { bad += 1 }
    if offset_of!(Matrix, m12) != 12 { bad += 1 }
    if offset_of!(Matrix, m1) != 16 { bad += 1 }
    if offset_of!(Matrix, m5) != 20 { bad += 1 }
    if offset_of!(Matrix, m9) != 24 { bad += 1 }
    if offset_of!(Matrix, m13) != 28 { bad += 1 }
    if offset_of!(Matrix, m2) != 32 { bad += 1 }
    if offset_of!(Matrix, m6) != 36 { bad += 1 }
    if offset_of!(Matrix, m10) != 40 { bad += 1 }
    if offset_of!(Matrix, m14) != 44 { bad += 1 }
    if offset_of!(Matrix, m3) != 48 { bad += 1 }
    if offset_of!(Matrix, m7) != 52 { bad += 1 }
    if offset_of!(Matrix, m11) != 56 { bad += 1 }
    if offset_of!(Matrix, m15) != 60 { bad += 1 }
    if mem::size_of<Matrix>() != 64 { bad += 1 }
    if mem::align_of<Matrix>() != 4 { bad += 1 }
    if offset_of!(Color, r) != 0 { bad += 1 }
    if offset_of!(Color, g) != 1 { bad += 1 }
    if offset_of!(Color, b) != 2 { bad += 1 }
