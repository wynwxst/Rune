// Syntax highlighting, a line at a time.
//
// A language is a table (`config::Language`): its comment markers, quotes and
// word lists, plus a few switches for the things that need a rule rather
// than a list — Rune's `@decorators`, `$intrinsics` and `macros!`. The only
// thing carried from one line to the next is a small state number (inside a
// block comment, inside a triple-quoted string), which the document caches
// per line so a long file is only ever walked once.

import std::collections::vector
import grve::config
import grve::buffer
import grve::utf

pub global TEXT: i64 = 0
pub global KEYWORD: i64 = 1
pub global CONTROL: i64 = 2
pub global TYPE: i64 = 3
pub global FUNCTION: i64 = 4
pub global STRING: i64 = 5
pub global NUMBER: i64 = 6
pub global COMMENT: i64 = 7
pub global CONSTANT: i64 = 8
pub global DECORATOR: i64 = 9
pub global MACRO: i64 = 10
pub global INTRINSIC: i64 = 11
pub global OPERATOR: i64 = 12
pub global PUNCT: i64 = 13
pub global ESCAPE: i64 = 14
pub global HEADING: i64 = 15

// Line states.
global NORMAL: i64 = 0
global IN_COMMENT: i64 = 1
global IN_FENCE: i64 = 2
// 256 + a quote byte: inside a triple-quoted string of that quote.
global IN_TRIPLE: i64 = 256

/// The state line `index` starts in, working out (and caching) every line
/// above it that has not been seen yet.
pub fn stateBefore(doc: buffer::Document, lang: config::Language, index: i64) -> i64 {
    if doc.hlStates.isEmpty() { doc.hlStates.push(NORMAL) }
    while doc.hlStates.length() <= index {
        let i = doc.hlStates.length() - 1
        let s = doc.hlStates.get(i)
        var scratch = vector::Vector<i64>()
        let next = scan(lang, doc.line(i), s, &var scratch, false)
        doc.hlStates.push(next)
    }
    doc.hlStates.get(index)
}

/// The kind of every byte of a line, and the state the next line starts in.
pub fn kinds(lang: config::Language, line: &String, state: i64) -> (vector::Vector<i64>, i64) {
    var out = vector::Vector<i64>()
    let next = scan(lang, line, state, &var out, true)
    (out, next)
}

fn paint(out: &var vector::Vector<i64>, from: i64, upto: i64, kind: i64, want: bool) {
    if !want { return }
    var i = from
    while i < upto {
        out.set(i, kind)
        i += 1
    }
}

fn isIdentStart(b: i64) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 0x80
}

fn isDigit(b: i64) -> bool { b >= 48 && b <= 57 }

fn isOperator(b: i64) -> bool {
    b == 43 || b == 45 || b == 42 || b == 47 || b == 37 || b == 61 || b == 60 || b == 62 ||
    b == 33 || b == 38 || b == 124 || b == 94 || b == 126 || b == 63 || b == 58
}

fn isPunct(b: i64) -> bool {
    b == 40 || b == 41 || b == 91 || b == 93 || b == 123 || b == 125 || b == 44 || b == 59 || b == 46
}

fn at(line: &String, i: i64) -> i64 {
    if i < 0 || i >= line.$length() { return -1 }
    line.$byteAt(i) as i64
}

fn startsAt(line: &String, i: i64, s: &String) -> bool {
    if s.$isEmpty() || i + s.$length() > line.$length() { return false }
    var k = 0
    while k < s.$length() {
        if line.$byteAt(i + k) != s.$byteAt(k) { return false }
        k += 1
    }
    true
}

fn isQuote(lang: config::Language, b: i64) -> bool {
    var k = 0
    while k < lang.quotes.$length() {
        if (lang.quotes.$byteAt(k) as i64) == b { return true }
        k += 1
    }
    false
}

fn scan(lang: config::Language, line: &String, start: i64, out: &var vector::Vector<i64>, want: bool) -> i64 {
    let n = line.$length()
    if want {
        out.reserve(n)
        for k in 0..n { out.push(TEXT) }
    }
    var state = start
    var i = 0

    if lang.markdown { return markdown(line, state, out, want) }

    // Carried in from the line above.
    if state == IN_COMMENT {
        let close = utf::findFrom(line, lang.blockEnd, 0)
        if close < 0 {
            paint(out, 0, n, COMMENT, want)
            return IN_COMMENT
        }
        i = close + lang.blockEnd.$length()
        paint(out, 0, i, COMMENT, want)
        state = NORMAL
    } elif state >= IN_TRIPLE {
        let q = state - IN_TRIPLE
        let closer = utf::fromCode(q).$repeat(3)
        let close = utf::findFrom(line, closer, 0)
        if close < 0 {
            paint(out, 0, n, STRING, want)
            return state
        }
        i = close + 3
        paint(out, 0, i, STRING, want)
        state = NORMAL
    }

    var previousWord = ""
    while i < n {
        let b = line.$byteAt(i) as i64

        if b == 32 || b == 9 { i += 1; continue }

        // Comments.
        if !lang.lineComment.$isEmpty() && startsAt(line, i, lang.lineComment) {
            // A shell `#` only starts a comment at the start of a word.
            if lang.lineComment != "#" || i == 0 || at(line, i - 1) == 32 || at(line, i - 1) == 9 || !lang.dollar {
                paint(out, i, n, COMMENT, want)
                return NORMAL
            }
        }
        if !lang.blockStart.$isEmpty() && startsAt(line, i, lang.blockStart) {
            let close = utf::findFrom(line, lang.blockEnd, i + lang.blockStart.$length())
            if close < 0 {
                paint(out, i, n, COMMENT, want)
                return IN_COMMENT
            }
            let stop = close + lang.blockEnd.$length()
            paint(out, i, stop, COMMENT, want)
            i = stop
            continue
        }

        // Strings.
        if isQuote(lang, b) {
            if lang.tripleQuotes && at(line, i + 1) == b && at(line, i + 2) == b {
                let closer = utf::fromCode(b).$repeat(3)
                let close = utf::findFrom(line, closer, i + 3)
                if close < 0 {
                    paint(out, i, n, STRING, want)
                    return IN_TRIPLE + b
                }
                paint(out, i, close + 3, STRING, want)
                i = close + 3
                continue
            }
            // A Rune `'` is a character only when it closes soon after;
            // otherwise it is a lone quote and the line goes on as code.
            var j = i + 1
            var closed = false
            while j < n {
                let c = line.$byteAt(j) as i64
                if c == 92 {
                    paint(out, j, if j + 2 <= n { j + 2 } else { n }, ESCAPE, want)
                    j += 2
                    continue
                }
                if c == b { closed = true; break }
                if want { out.set(j, STRING) }
                j += 1
            }
            let stop = if closed { j + 1 } else { n }
            if want {
                out.set(i, STRING)
                if closed { out.set(j, STRING) }
            }
            i = stop
            continue
        }

        // Numbers.
        if isDigit(b) {
            var j = i + 1
            while j < n {
                let c = line.$byteAt(j) as i64
                if isDigit(c) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 { j += 1; continue }
                if c == 46 && isDigit(at(line, j + 1)) { j += 1; continue }
                if (c == 43 || c == 45) && (at(line, j - 1) == 101 || at(line, j - 1) == 69) && !startsAt(line, i, "0x") { j += 1; continue }
                break
            }
            paint(out, i, j, NUMBER, want)
            i = j
            continue
        }

        // `@decorator` and `$intrinsic`.
        if (b == 64 && lang.decorators) || (b == 36 && lang.dollar) {
            var j = i + 1
            if b == 36 && at(line, j) == 123 {
                // `${name}` in a shell.
                while j < n && (line.$byteAt(j) as i64) != 125 { j += 1 }
                if j < n { j += 1 }
            } else {
                while j < n && (isIdentStart(line.$byteAt(j) as i64) || isDigit(line.$byteAt(j) as i64)) { j += 1 }
            }
            if j > i + 1 || b == 36 {
                paint(out, i, j, if b == 64 { DECORATOR } else { INTRINSIC }, want)
                i = j
                continue
            }
        }

        // Words.
        if isIdentStart(b) {
            var j = i + 1
            while j < n && (isIdentStart(line.$byteAt(j) as i64) || isDigit(line.$byteAt(j) as i64)) { j += 1 }
            let word = line.$substring(i, j)
            var kind = TEXT
            if lang.bangMacros && at(line, j) == 33 && at(line, j + 1) != 61 {
                kind = MACRO
                j += 1
            } elif lang.isControl(word) { kind = CONTROL }
            elif lang.isKeyword(word) { kind = KEYWORD }
            elif lang.isConstant(word) { kind = CONSTANT }
            elif lang.isType(word) { kind = TYPE }
            elif previousWord == "fn" || previousWord == "def" || previousWord == "func" || previousWord == "function" {
                kind = FUNCTION
            } elif at(line, j) == 40 { kind = FUNCTION }
            elif lang.capitalTypes && b >= 65 && b <= 90 {
                kind = if allCaps(word) && word.$length() > 1 { CONSTANT } else { TYPE }
            }
            paint(out, i, j, kind, want)
            previousWord = word
            i = j
            continue
        }

        if isOperator(b) { if want { out.set(i, OPERATOR) } }
        elif isPunct(b) { if want { out.set(i, PUNCT) } }
        i = if b >= 0x80 { utf::next(line, i) } else { i + 1 }
    }
    state
}

fn allCaps(w: &String) -> bool {
    var k = 0
    while k < w.$length() {
        let c = w.$byteAt(k) as i64
        if c >= 97 && c <= 122 { return false }
        k += 1
    }
    true
}

/// Headings, code spans and fences, emphasis markers and list bullets.
fn markdown(line: &String, start: i64, out: &var vector::Vector<i64>, want: bool) -> i64 {
    let n = line.$length()
    let trimmed = utf::trim(line)
    if utf::startsWith(trimmed, "```") {
        paint(out, 0, n, STRING, want)
        return if start == IN_FENCE { NORMAL } else { IN_FENCE }
    }
    if start == IN_FENCE {
        paint(out, 0, n, STRING, want)
        return IN_FENCE
    }
    if utf::startsWith(trimmed, "#") {
        paint(out, 0, n, HEADING, want)
        return NORMAL
    }
    if utf::startsWith(trimmed, ">") {
        paint(out, 0, n, COMMENT, want)
        return NORMAL
    }
    var i = 0
    while i < n && (line.$byteAt(i) as i64) == 32 { i += 1 }
    if i < n && ((line.$byteAt(i) as i64) == 45 || (line.$byteAt(i) as i64) == 42 || (line.$byteAt(i) as i64) == 43) && at(line, i + 1) == 32 {
        if want { out.set(i, KEYWORD) }
    }
    while i < n {
        let b = line.$byteAt(i) as i64
        if b == 96 {
            let close = utf::findFrom(line, "`", i + 1)
            let stop = if close < 0 { n } else { close + 1 }
            paint(out, i, stop, STRING, want)
            i = stop
            continue
        }
        if b == 42 || b == 95 {
            if want { out.set(i, OPERATOR) }
        }
        if b == 91 {
            // [text](link)
            let close = utf::findFrom(line, "](", i)
            if close > i {
                let end = utf::findFrom(line, ")", close)
                if end > close {
                    paint(out, i, close + 1, FUNCTION, want)
                    paint(out, close + 1, end + 1, COMMENT, want)
                    i = end + 1
                    continue
                }
            }
        }
        i += 1
    }
    NORMAL
}
