import std::io

enum Currency {
    USD = 1f64,
    AUD = 1.43f64,
    GBP = 0.76f64
}

bind Currency into f64 {
    fn convert(&self) -> f64 {
        match self {
            .USD => 1,
            .AUD => 1.43,
            .GBP => 0.76

        }
    }
}

struct Money {
    cur: Currency
    minor: u8
    major: u64
}

