// std::result — a value, or the reason it is missing.
//
// `Result` is an ordinary Rune enum that the compiler knows by name, so `?`
// works on it as well as on `Option`: inside a function returning
// `Result<T, E>`, writing `value?` returns the error unchanged and otherwise
// yields the value.
//
//     fn parse(text: String) -> Result<i64, String> {
//         match text.$toInt() {
//             Option::Some(n) => n,             // a bare T promotes to Ok
//             Option::None => "not a number",   // a bare E promotes to Err
//         }
//     }
//
//     fn total(a: String, b: String) -> Result<i64, String> {
//         parse(a)? + parse(b)?
//     }
//
// A bare `T` or `E` promotes into `Result<T, E>` wherever one is expected, so
// `Ok(...)` and `Err(...)` rarely need writing out. `ok` and `err` below are
// for the places where the two sides have the same type and the promotion
// would be ambiguous.

import std::option
import std::mem

extern "C" {
    fn rune_panic_unwrap(what: CString, location: CString) -> Never
}

pub enum Result<T, E> {
    Ok(T),
    Err(E),

    //=== Asking ===========================================================//

    /// True when the result holds a value.
    pub fn isOk(&self) -> bool {
        match self {
            Result::Ok(v) => true,
            Result::Err(e) => false,
        }
    }

    /// True when the result holds an error.
    pub fn isErr(&self) -> bool {
        !self.isOk()
    }

    /// True when this succeeded and `keep` says yes to the value.
    pub fn isSuchThat(&self, keep: @function(T) -> bool) -> bool where T: mem::Clone {
        match self {
            Result::Ok(v) => keep(v.$clone()),
            Result::Err(e) => false,
        }
    }

    //=== Getting the value out ============================================//
    //
    // Each of these takes the result itself and hands its contents on, as
    // `Option`'s do: nothing is copied, so they work for a `T` or an `E`
    // that cannot be — a `Box`, a `File`. Ask first with `isOk`, or match,
    // to keep the result.

    /// The value, or `fallback` when this is an error.
    ///
    /// `fallback` is evaluated whether or not it is needed. Use `orElse` when
    /// producing it is expensive, and `recover` when the error itself should
    /// have a say in what replaces it.
    pub fn or(self, fallback: T) -> T {
        match self {
            Result::Ok(take v) => v,
            Result::Err(e) => fallback,
        }
    }

    /// The value, or what `produce` returns when this is an error.
    pub fn orElse(self, produce: @function() -> T) -> T {
        match self {
            Result::Ok(take v) => v,
            Result::Err(e) => produce(),
        }
    }

    /// The value, or what `repair` makes of the error.
    ///
    ///     let port = configured().recover(||(e: ConfigError) -> i64 {
    ///         warn(e)
    ///         8080
    ///     })
    pub fn recover(self, repair: @function(E) -> T) -> T {
        match self {
            Result::Ok(take v) => v,
            Result::Err(take e) => repair(e),
        }
    }

    /// The value. Aborts when this is an error.
    #safe("the runtime prints the location and aborts; it never returns")
    pub fn unwrap(self) -> T {
        match self {
            Result::Ok(take v) => v,
            Result::Err(e) => rune_panic_unwrap("Result", "Result::unwrap"),
        }
    }

    /// The value, or `message` on the way out.
    ///
    /// Prefer this to `unwrap` wherever the reason it should have succeeded
    /// can be written down: the message is what the traceback leads with.
    #safe("the runtime prints the message and aborts; it never returns")
    pub fn expect(self, message: CString) -> T {
        match self {
            Result::Ok(take v) => v,
            Result::Err(e) => rune_panic_unwrap(message, "Result::expect"),
        }
    }

    /// The error. Aborts when this holds a value.
    ///
    /// The mirror of `unwrap`, for a test that means to check the failure.
    #safe("the runtime prints the location and aborts; it never returns")
    pub fn unwrapErr(self) -> E {
        match self {
            Result::Ok(v) => rune_panic_unwrap("Result", "Result::unwrapErr"),
            Result::Err(take e) => e,
        }
    }

    //=== Transforming =====================================================//

    /// The value with `f` applied to it; an error passes straight through.
    ///
    ///     let lines = readFile(path).map(||(text: String) -> i64 {
    ///         text.$length()
    ///     })
    pub fn map<U>(self, f: @function(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(take v) => Result::<U, E>::Ok(f(v)),
            Result::Err(take e) => Result::<U, E>::Err(e),
        }
    }

    /// The error with `f` applied to it; a value passes straight through.
    ///
    /// This is how one layer's failure becomes another's — a `FileError` from
    /// `std::io` reported as whatever your own code deals in.
    ///
    ///     store(path).mapErr(||(e: io::FileError) -> SaveError {
    ///         SaveError::Disk(e)
    ///     })
    pub fn mapErr<F>(self, f: @function(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(take v) => Result::<T, F>::Ok(v),
            Result::Err(take e) => Result::<T, F>::Err(f(e)),
        }
    }

    /// `f` applied to the value, where `f` may itself fail.
    ///
    /// This is what `?` does without the early return, and what keeps a chain
    /// from nesting: `Result<Result<T, E>, E>` never appears.
    ///
    ///     open(path).andThen(||(f: io::File) -> Result<String, io::FileError> {
    ///         f.readToString()
    ///     })
    pub fn andThen<U>(self, f: @function(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(take v) => f(v),
            Result::Err(take e) => Result::<U, E>::Err(e),
        }
    }

    //=== Crossing over to Option ==========================================//

    /// The value as an option, discarding any error.
    pub fn ok(self) -> option::Option<T> {
        match self {
            Result::Ok(take v) => option::Option::<T>::Some(v),
            Result::Err(e) => option::Option::<T>::None,
        }
    }

    /// The error as an option, discarding any value.
    pub fn error(self) -> option::Option<E> {
        match self {
            Result::Ok(v) => option::Option::<E>::None,
            Result::Err(take e) => option::Option::<E>::Some(e),
        }
    }
}

//=== Constructing ========================================================//

/// A successful result.
pub fn ok<T, E>(value: T) -> Result<T, E> {
    Result::<T, E>::Ok(value)
}

/// A failed result.
pub fn err<T, E>(error: E) -> Result<T, E> {
    Result::<T, E>::Err(error)
}

/// An option read as a result, with `error` standing in for `nil`.
///
/// The bridge in the other direction from `ok` above: it is how a lookup that
/// merely came up empty is turned into one that says why.
///
///     let user = result::from(lookup(id), "no such user")
pub fn from<T, E>(value: option::Option<T>, error: E) -> Result<T, E> {
    match value {
        option::Option::Some(v) => Result::<T, E>::Ok(v),
        option::Option::None => Result::<T, E>::Err(error),
    }
}

/// One result out of two.
///
/// `andThen` avoids ever building a nested result; this is for when one
/// arrives anyway.
pub fn flatten<T, E>(nested: Result<Result<T, E>, E>) -> Result<T, E> {
    match nested {
        Result::Ok(take inner) => inner,
        Result::Err(take e) => Result::<T, E>::Err(e),
    }
}
