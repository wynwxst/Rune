// std::math — numbers: the constants, what libm provides, and the handful of
// things that are easier to write once than to write again.
//
// The trigonometric and exponential functions are C's, declared here and
// wrapped so that calling one is not a foreign call at the use site. Each is
// marked `@safe` with the same reason: libm reports a domain error by
// returning NaN rather than by trapping, so there is nothing a caller could
// do wrong that the value it gets back does not already say.
//
//     if math::isNan(result) { ... }
//
// Everything is `f64`. Rune widens an `f32` on the way in, so `sine(x)` works
// for either; the answer comes back double precision.

//=== Constants ===========================================================//

/// The ratio of a circle's circumference to its diameter.
pub global PI: f64 = 3.141592653589793
/// The base of the natural logarithm.
pub global E: f64 = 2.718281828459045
/// Two pi — a whole turn, in radians.
pub global TAU: f64 = 6.283185307179586
/// The square root of two.
pub global SQRT_2: f64 = 1.4142135623730951
/// The natural logarithm of two, which is what converts between `log` bases.
pub global LN_2: f64 = 0.6931471805599453
/// The natural logarithm of ten.
pub global LN_10: f64 = 2.302585092994046

/// The gap between 1.0 and the next `f64` above it.
///
/// Two floats that differ by less than this cannot be told apart at that
/// magnitude, which is what makes it the unit of a tolerance comparison —
/// see `nearlyEqual`.
pub global EPSILON: f64 = 2.220446049250313e-16
/// The largest finite `f64`.
pub global F64_MAX: f64 = 1.7976931348623157e308
/// The smallest positive normal `f64`.
pub global F64_MIN_POSITIVE: f64 = 2.2250738585072014e-308

extern "C" {
    fn sqrt(value: f64) -> f64
    fn cbrt(value: f64) -> f64
    fn pow(base: f64, exponent: f64) -> f64
    fn hypot(x: f64, y: f64) -> f64
    fn sin(value: f64) -> f64
    fn cos(value: f64) -> f64
    fn tan(value: f64) -> f64
    fn asin(value: f64) -> f64
    fn acos(value: f64) -> f64
    fn atan(value: f64) -> f64
    fn atan2(y: f64, x: f64) -> f64
    fn sinh(value: f64) -> f64
    fn cosh(value: f64) -> f64
    fn tanh(value: f64) -> f64
    fn log(value: f64) -> f64
    fn log2(value: f64) -> f64
    fn log10(value: f64) -> f64
    fn exp(value: f64) -> f64
    fn floor(value: f64) -> f64
    fn ceil(value: f64) -> f64
    fn round(value: f64) -> f64
    fn trunc(value: f64) -> f64
    fn fmod(numerator: f64, denominator: f64) -> f64
    fn copysign(magnitude: f64, sign: f64) -> f64
}

//=== Roots and powers ====================================================//

@safe("libm handles its own domain errors by returning NaN")
pub fn squareRoot(value: f64) -> f64 { sqrt(value) }

/// The real cube root, defined for negative values too — unlike
/// `power(value, 1.0 / 3.0)`, which is NaN below zero.
///
/// C libraries differ in the last bit: glibc's `cbrt(27.0)` is
/// 3.0000000000000004, Apple's is 3. A perfect cube's root is a whole
/// number, so when the nearest whole number cubes back to exactly `value`,
/// that is the answer — the same on every platform.
@safe("libm handles its own domain errors by returning NaN")
pub fn cubeRoot(value: f64) -> f64 {
    let r = cbrt(value)
    let whole = round(r)
    if whole * whole * whole == value { whole } else { r }
}

@safe("libm handles its own domain errors by returning NaN")
pub fn power(base: f64, exponent: f64) -> f64 { pow(base, exponent) }

/// The length of the hypotenuse: `sqrt(x*x + y*y)`, computed so that a large
/// `x` does not overflow on the way.
@safe("libm handles its own domain errors by returning NaN")
pub fn lengthOf(x: f64, y: f64) -> f64 { hypot(x, y) }

//=== Trigonometry ========================================================//

@safe("libm handles its own domain errors by returning NaN")
pub fn sine(value: f64) -> f64 { sin(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn cosine(value: f64) -> f64 { cos(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn tangent(value: f64) -> f64 { tan(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn arcSine(value: f64) -> f64 { asin(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn arcCosine(value: f64) -> f64 { acos(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn arcTangent(value: f64) -> f64 { atan(value) }

/// The angle of the point `(x, y)` from the positive x-axis, in radians and
/// in the right quadrant — which `arcTangent(y / x)` cannot tell you.
@safe("libm handles its own domain errors by returning NaN")
pub fn angleOf(y: f64, x: f64) -> f64 { atan2(y, x) }

@safe("libm handles its own domain errors by returning NaN")
pub fn hyperbolicSine(value: f64) -> f64 { sinh(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn hyperbolicCosine(value: f64) -> f64 { cosh(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn hyperbolicTangent(value: f64) -> f64 { tanh(value) }

/// Radians from degrees.
pub fn radians(degrees: f64) -> f64 { degrees * PI / 180.0 }

/// Degrees from radians.
pub fn degrees(radians: f64) -> f64 { radians * 180.0 / PI }

//=== Logarithms and exponentials =========================================//

@safe("libm handles its own domain errors by returning NaN")
pub fn naturalLog(value: f64) -> f64 { log(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn log2Of(value: f64) -> f64 { log2(value) }

@safe("libm handles its own domain errors by returning NaN")
pub fn log10Of(value: f64) -> f64 { log10(value) }

/// The logarithm of `value` in an arbitrary base.
@safe("libm handles its own domain errors by returning NaN")
pub fn logOf(value: f64, base: f64) -> f64 { log(value) / log(base) }

@safe("libm handles its own domain errors by returning NaN")
pub fn exponential(value: f64) -> f64 { exp(value) }

//=== Rounding ============================================================//

/// Towards negative infinity.
@safe("libm handles its own domain errors by returning NaN")
pub fn roundDown(value: f64) -> f64 { floor(value) }

/// Towards positive infinity.
@safe("libm handles its own domain errors by returning NaN")
pub fn roundUp(value: f64) -> f64 { ceil(value) }

/// To the nearest whole number, halves away from zero.
@safe("libm handles its own domain errors by returning NaN")
pub fn roundNearest(value: f64) -> f64 { round(value) }

/// Towards zero: the whole part, with the fraction dropped.
@safe("libm handles its own domain errors by returning NaN")
pub fn wholePart(value: f64) -> f64 { trunc(value) }

/// What is left after `wholePart`, keeping the sign.
@safe("libm handles its own domain errors by returning NaN")
pub fn fractionPart(value: f64) -> f64 { value - trunc(value) }

/// The remainder of `a / b`, keeping the sign of `a`. This is C's `fmod`;
/// `%` means the same thing for floats.
@safe("libm handles its own domain errors by returning NaN")
pub fn remainderOf(a: f64, b: f64) -> f64 { fmod(a, b) }

/// `magnitude` with the sign of `sign` — which is the only way to tell the
/// two zeroes apart, since `-0.0 == 0.0`.
@safe("copysign is total: every pair of inputs has a defined result")
pub fn withSignOf(magnitude: f64, sign: f64) -> f64 { copysign(magnitude, sign) }

//=== Decimal places ======================================================//
//
// Rounding to a number of decimal places, as a person means it.
//
// A float holds most decimals only approximately: `0.29` is really
// 0.28999999999999998, so `0.29 * 100.0` is 28.999999999999996, and cutting
// that off gives 28 where anyone would expect 29. Every function here first
// asks whether the scaled value is within a few units of float error of a
// whole number — or of a half, for the rounding modes that care — and if so
// takes it to be exactly that, the decimal that was written. Only then does
// it round. So:
//
//     math::truncateTo(0.29, 2)      // 0.29, not 0.28
//     math::roundTo(2.675, 2)        // 2.68: the 5 is taken as written
//     math::floorTo(1.005, 2)        // 1.0
//
// `places` may be negative, which rounds to tens, hundreds and so on:
// `roundTo(1234.0, -2)` is 1200.0.

/// How a value that falls between two representable decimals is settled.
pub enum Rounding {
    /// Towards negative infinity: 2.37 → 2.3, -2.31 → -2.4.
    Floor,
    /// Towards positive infinity: 2.31 → 2.4, -2.37 → -2.3.
    Ceiling,
    /// Towards zero — the digits past the last place are dropped.
    TowardZero,
    /// Away from zero: 2.31 → 2.4, -2.31 → -2.4.
    AwayFromZero,
    /// To the nearest, and a half away from zero: 2.25 → 2.3. What is taught
    /// at school, and what `roundTo` does.
    HalfAwayFromZero,
    /// To the nearest, and a half to the even neighbour: 2.25 → 2.2, 2.35 →
    /// 2.4. Banker's rounding: over many values the halves cancel instead of
    /// all pushing the same way.
    HalfEven,
}

/// Ten to the `places`, exactly — every power of ten up to 10^22 is a
/// double, which is further than any float has digits for.
fn powerOfTen(places: i64) -> f64 {
    var p = 1.0
    var i = 0
    while i < places && i < 308 {
        p *= 10.0
        i += 1
    }
    p
}

/// How far from a whole number `x` may be and still be taken as one: a few
/// units in the last place, at `x`'s own size.
fn slack(x: f64) -> f64 {
    let size = if x < 0.0 { 0.0 - x } else { x }
    8.0 * EPSILON * (if size > 1.0 { size } else { 1.0 })
}

/// `x`, or the whole number it is float error away from.
@safe("libm handles its own domain errors by returning NaN")
fn snapWhole(x: f64) -> f64 {
    let r = round(x)
    let d = if x > r { x - r } else { r - x }
    if d <= slack(x) { r } else { x }
}

/// `x`, or the half — n + 0.5 — it is float error away from.
@safe("libm handles its own domain errors by returning NaN")
fn snapHalf(x: f64) -> f64 {
    let h = floor(x) + 0.5
    let d = if x > h { x - h } else { h - x }
    if d <= slack(x) { h } else { x }
}

/// `x` settled to a whole number by `mode`.
@safe("libm handles its own domain errors by returning NaN")
fn settle(x: f64, mode: Rounding) -> f64 {
    let w = snapWhole(x)
    match mode {
        Rounding::Floor => floor(w),
        Rounding::Ceiling => ceil(w),
        Rounding::TowardZero => trunc(w),
        Rounding::AwayFromZero => if w < 0.0 { floor(w) } else { ceil(w) },
        Rounding::HalfAwayFromZero => round(snapHalf(w)),
        Rounding::HalfEven => {
            let h = snapHalf(w)
            let down = floor(h)
            if h - down == 0.5 {
                // Exactly between: the even one of the two.
                if fmod(down, 2.0) == 0.0 { down } else { down + 1.0 }
            } else {
                round(h)
            }
        },
    }
}

/// `value` rounded to `places` decimal places by `mode`.
///
///     math::roundWith(2.25, 1, math::Rounding::HalfEven)    // 2.2
///     math::roundWith(-2.31, 1, math::Rounding::Floor)      // -2.4
pub fn roundWith(value: f64, places: i64, mode: Rounding) -> f64 {
    if isNan(value) || isInfinite(value) { return value }
    if places >= 0 {
        let f = powerOfTen(places)
        return settle(value * f, mode) / f
    }
    let f = powerOfTen(0 - places)
    settle(value / f, mode) * f
}

/// `value` rounded to `places` decimal places, halves away from zero.
///
///     math::roundTo(3.14159, 2)      // 3.14
///     math::roundTo(2.675, 2)        // 2.68
///     math::roundTo(1234.0, -2)      // 1200.0
pub fn roundTo(value: f64, places: i64) -> f64 {
    roundWith(value, places, Rounding::HalfAwayFromZero)
}

/// `value` cut off after `places` decimal places, towards zero.
///
///     math::truncateTo(0.29, 2)      // 0.29
///     math::truncateTo(-1.239, 2)    // -1.23
pub fn truncateTo(value: f64, places: i64) -> f64 {
    roundWith(value, places, Rounding::TowardZero)
}

/// `value` rounded down, towards negative infinity, to `places` places.
pub fn floorTo(value: f64, places: i64) -> f64 {
    roundWith(value, places, Rounding::Floor)
}

/// `value` rounded up, towards positive infinity, to `places` places.
pub fn ceilTo(value: f64, places: i64) -> f64 {
    roundWith(value, places, Rounding::Ceiling)
}

/// `value` rounded to the nearest multiple of `step`, halves away from zero
/// — cash rounding, a grid, a slider's notches:
///
///     math::roundToStep(1.23, 0.05)  // 1.25
///     math::roundToStep(17.0, 5.0)   // 15.0
///
/// A `step` of zero, or one that is not a number, gives `value` back.
pub fn roundToStep(value: f64, step: f64) -> f64 {
    if step == 0.0 || isNan(step) || isNan(value) || isInfinite(value) { return value }
    let s = if step < 0.0 { 0.0 - step } else { step }
    settle(value / s, Rounding::HalfAwayFromZero) * s
}

/// `value` as a whole number of `10^-places` units, rounded halves away from
/// zero — hundredths for `places` 2. This is the form money wants: count in
/// cents, add and compare exactly, and turn it back with `unscaled` only to
/// show it.
///
///     math::scaled(103.4, 2)         // 10340
///     math::scaled(0.29, 2)          // 29
///
/// A value too large for an `i64` at that scale is not a sensible amount of
/// anything; it saturates rather than wrapping.
pub fn scaled(value: f64, places: i64) -> i64 {
    if isNan(value) { return 0 }
    let x = if places >= 0 { settle(value * powerOfTen(places), Rounding::HalfAwayFromZero) }
            else { settle(value / powerOfTen(0 - places), Rounding::HalfAwayFromZero) }
    if x >= 9.2233720368547748e18 { return 9223372036854775807 }
    if x <= -9.2233720368547748e18 { return -9223372036854775807 - 1 }
    x as i64
}

/// A whole number of `10^-places` units, as a float: the way back from
/// `scaled`.
///
///     math::unscaled(10340, 2)       // 103.4
pub fn unscaled(units: i64, places: i64) -> f64 {
    if places >= 0 { return (units as f64) / powerOfTen(places) }
    (units as f64) * powerOfTen(0 - places)
}

/// The whole part and the first `places` digits after the point of
/// `value`'s magnitude, rounded to that many places first — so a value that
/// rounds up carries into the whole part:
///
///     math::splitDecimal(103.4, 2)   // (103, 40)
///     math::splitDecimal(0.999, 2)   // (1, 0)
///     math::splitDecimal(-2.5, 1)    // (2, 5): the sign is `value`'s to say
///
/// Which is what showing an amount as `103.40`, or storing it as dollars and
/// cents, wants — and what `wholePart` and `fractionPart` give only
/// approximately.
pub fn splitDecimal(value: f64, places: i64) -> (i64, i64) {
    let p = if places < 0 { 0 } else { places }
    let magnitude = if value < 0.0 { 0.0 - value } else { value }
    let units = scaled(magnitude, p)
    let unit = powerInt(10, p)
    (units / unit, units % unit)
}

//=== Asking about a float ================================================//

/// True when `value` is not a number.
///
/// NaN is the one value that is not equal to itself, which is what this
/// checks — and why `value == NAN` never works.
pub fn isNan(value: f64) -> bool { value != value }

/// True when `value` is positive or negative infinity.
pub fn isInfinite(value: f64) -> bool {
    !isNan(value) && (value > F64_MAX || value < 0.0 - F64_MAX)
}

/// True when `value` is an ordinary number: neither NaN nor infinite.
pub fn isFinite(value: f64) -> bool { !isNan(value) && !isInfinite(value) }

/// Positive infinity.
pub fn infinity() -> f64 { 1.0e308 * 10.0 }

/// A not-a-number value.
pub fn nan() -> f64 { infinity() - infinity() }

/// True when `a` and `b` are within `tolerance` of each other.
///
/// Floating point arithmetic does not give exact answers, so `==` on two
/// computed doubles asks a question they cannot answer. This asks the one
/// they can. A tolerance of a few multiples of `EPSILON` is right for values
/// near 1; scale it up with the magnitudes involved.
///
///     if math::nearlyEqual(total, expected, 1e-9) { ... }
pub fn nearlyEqual(a: f64, b: f64, tolerance: f64) -> bool {
    absFloat(a - b) <= tolerance
}

//=== Comparison, for anything ordered ====================================//

/// The smaller of two values.
///
/// The bound is an operator rather than a mark: anything `<` works on can be
/// compared here, builtin or your own.
///
///     math::least(3, 5)          // 3
///     math::least(2.5, 1.5)      // 1.5
///     math::least(a, b)          // whatever `bind operator::cmp` says
pub fn least<T: operator::cmp>(a: T, b: T) -> T { if a < b { a } else { b } }

/// The larger of two values.
pub fn greatest<T: operator::cmp>(a: T, b: T) -> T { if a > b { a } else { b } }

/// `value`, held inside the inclusive range `[low, high]`.
pub fn clamp<T: operator::cmp>(value: T, low: T, high: T) -> T {
    if value < low { low } elif value > high { high } else { value }
}

//=== Integers ============================================================//

/// The distance from zero.
pub fn absInt(value: i64) -> i64 {
    if value < 0 { 0 - value } else { value }
}

/// The distance from zero.
pub fn absFloat(value: f64) -> f64 {
    if value < 0.0 { 0.0 - value } else { value }
}

/// -1, 0 or 1, according to the sign.
pub fn signInt(value: i64) -> i64 {
    if value > 0 { 1 } elif value < 0 { -1 } else { 0 }
}

/// -1.0, 0.0 or 1.0, according to the sign. NaN gives 0.0.
pub fn signFloat(value: f64) -> f64 {
    if value > 0.0 { 1.0 } elif value < 0.0 { -1.0 } else { 0.0 }
}

pub fn minInt(a: i64, b: i64) -> i64 { least(a, b) }

pub fn maxInt(a: i64, b: i64) -> i64 { greatest(a, b) }

pub fn minFloat(a: f64, b: f64) -> f64 { least(a, b) }

pub fn maxFloat(a: f64, b: f64) -> f64 { greatest(a, b) }

/// Clamps `value` into the inclusive range `[low, high]`.
pub fn clampInt(value: i64, low: i64, high: i64) -> i64 {
    clamp(value, low, high)
}

/// `base` raised to a whole-number power, by squaring.
///
/// Exact where `power` would be approximate, and defined for a negative base.
/// A negative exponent gives 0, since the result would not be a whole number.
pub fn powerInt(base: i64, exponent: i64) -> i64 {
    if exponent < 0 { return 0 }
    var result: i64 = 1
    var b = base
    var e = exponent
    while e > 0 {
        if e % 2 == 1 { result = result * b }
        b = b * b
        e = e / 2
    }
    result
}

/// The largest whole number whose square is at most `value`.
///
/// Newton's method on integers, so there is no rounding to argue with:
/// `isqrt(n) * isqrt(n) <= n` exactly. Negative input gives 0.
pub fn squareRootInt(value: i64) -> i64 {
    if value <= 0 { return 0 }
    var guess = value
    var next = (guess + 1) / 2
    while next < guess {
        guess = next
        next = (guess + value / guess) / 2
    }
    guess
}

/// The greatest common divisor of two numbers, as a non-negative value.
///
///     math::gcd(12, 18)     // 6
pub fn gcd(a: i64, b: i64) -> i64 {
    var x = absInt(a)
    var y = absInt(b)
    while y != 0 {
        rest = x % y
        x = y
        y = rest
    }
    x
}

/// The least common multiple, as a non-negative value. Zero with either side
/// zero, since nothing else would divide.
pub fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 { return 0 }
    absInt(a / gcd(a, b) * b)
}

/// Division that rounds towards negative infinity rather than towards zero.
///
/// `/` truncates, so `-7 / 2` is -3. This gives -4, which is what indexing
/// into a grid with negative coordinates wants.
pub fn divFloor(a: i64, b: i64) -> i64 {
    q = a / b
    if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

/// The remainder that goes with `divFloor`, so the sign follows the divisor
/// and the result is never negative for a positive `b`.
pub fn modFloor(a: i64, b: i64) -> i64 {
    rest = a % b
    if rest != 0 && ((rest < 0) != (b < 0)) { rest + b } else { rest }
}

//=== Overflow, by name ===================================================//
//
// `+`, `-` and `*` on a fixed-width integer follow the build when the result
// does not fit: a debug build (`-O0`) stops with a panic, the way a bounds
// check does, and a release build wraps. These say which one is meant, and
// mean it at every setting — a hash that is supposed to wrap should say so,
// and a counter that must never wrap should ask for `nil` instead.
//
//     let h = math::wrappingMul(h, 31)          // the wrap is the point
//     let n = math::checkedAdd(count, 1) ?? panic("too many")
//
// Each works for every integer type, and the two operands must share one.

/// `a + b`, wrapping at the type's limits.
pub fn wrappingAdd<T>(a: T, b: T) -> T { a.$wrappingAdd(b) }
/// `a - b`, wrapping at the type's limits.
pub fn wrappingSub<T>(a: T, b: T) -> T { a.$wrappingSub(b) }
/// `a * b`, wrapping at the type's limits.
pub fn wrappingMul<T>(a: T, b: T) -> T { a.$wrappingMul(b) }

/// `a + b`, clamped to the type's limits instead of wrapping past them.
pub fn saturatingAdd<T>(a: T, b: T) -> T { a.$saturatingAdd(b) }
/// `a - b`, clamped to the type's limits.
pub fn saturatingSub<T>(a: T, b: T) -> T { a.$saturatingSub(b) }
/// `a * b`, clamped to the type's limits.
pub fn saturatingMul<T>(a: T, b: T) -> T { a.$saturatingMul(b) }

/// `a + b`, or `nil` when the result would not fit.
pub fn checkedAdd<T>(a: T, b: T) -> T? { a.$checkedAdd(b) }
/// `a - b`, or `nil` when the result would not fit.
pub fn checkedSub<T>(a: T, b: T) -> T? { a.$checkedSub(b) }
/// `a * b`, or `nil` when the result would not fit.
pub fn checkedMul<T>(a: T, b: T) -> T? { a.$checkedMul(b) }
