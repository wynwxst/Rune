// Raw memory: how much space a type needs, where to get it, and a safe
// wrapper so most code never has to touch any of it.
//
// The unsafe surface is deliberately small. `Allocator` hands out untyped
// blocks; `Handle<T>` is the one owning pointer you should reach for, and it
// frees itself. Anything built on these — see `std::collections` — pays for
// `unsafe` once, inside, and offers a checked interface outside.

import std::io
import std::process
import std::collections::vector

extern "C" {
    fn rune_raw_alloc(size: u64) -> *var u8
    fn rune_raw_realloc(block: *var u8, size: u64) -> *var u8
    fn rune_raw_free(block: *var u8)
    fn rune_raw_copy(dst: *var u8, src: *u8, size: u64)
    fn rune_raw_zero(block: *var u8, size: u64)
    fn rune_raw_is_zero(block: *u8, size: u64) -> bool
}

//===--------------------------------------------------------------------===//
// Layout
//===--------------------------------------------------------------------===//

/// Bytes one value of `T` occupies, including any tail padding — the stride
/// between neighbouring elements of an array of `T`.
///
///     let n = mem::size_of<i64>()     // 8
@intrinsic("size_of")
pub fn size_of<T>() -> usize

/// The alignment `T` requires, in bytes.
@intrinsic("align_of")
pub fn align_of<T>() -> usize

/// True when `T` is reference counted — a class, a `String`, a `dyn Mark`, or
/// anything holding one of those.
///
/// This is the same question the compiler answers for itself before it emits a
/// retain, so a container that asks it agrees with the compiler by
/// construction rather than by convention. It is decided at compile time, so
/// the branch it guards costs nothing.
///
///     if mem::is_counted<T>() { ... } else { ... }
///
/// The one place it matters: all-zero bytes are a perfectly good `i64`, `f64`
/// or `bool`, and are never a valid reference. A container that zeroes its
/// storage can therefore hand back zeroed slots for one kind of `T` and must
/// call them empty for the other.
@intrinsic("is_counted")
pub fn is_counted<T>() -> bool

/// A hash of `value`, worked out from its layout.
///
/// The compiler knows what `T` is made of, so this asks nothing of `T`: no
/// `Hashable` mark to bind, and no `Display` standing in for one. It is
/// consistent with `equals` — two values that compare equal hash the same.
///
///     let h = mem::hash(key)
///
/// A `String` hashes its contents; a class hashes its address, because two
/// distinct objects are two distinct keys even when their fields agree. An
/// aggregate hashes its parts, and an enum its tag and live payload.
@intrinsic("hash")
pub fn hash<T>(value: &T) -> u64

/// True when `a` and `b` are structurally equal, worked out from the layout.
///
/// Contents for a `String`, address for a class, part by part for anything
/// aggregate. This is the comparison `hash` is consistent with, and it needs
/// no bound on `T`.
@intrinsic("equals")
pub fn equals<T>(a: &T, b: &T) -> bool

//===--------------------------------------------------------------------===//
// Allocators
//===--------------------------------------------------------------------===//

/// A source of untyped memory. Blocks come back uninitialised, and every one
/// handed out must be given back to the same allocator exactly once.
pub mark Allocator {
    /// A block of at least `bytes`, or a null pointer if none can be had.
    fn allocate(&self, bytes: usize) -> *var u8

    /// Returns a block. Passing a null pointer is allowed and does nothing.
    fn deallocate(&self, block: *var u8)

    /// Grows or shrinks a block, preserving its contents up to the smaller of
    /// the two sizes. The old pointer is invalid afterwards.
    fn reallocate(&self, block: *var u8, bytes: usize) -> *var u8
}

/// The allocator backing every other one: the process heap.
pub struct SystemAllocator {}

bind Allocator to SystemAllocator {
    @safe("the runtime returns either a valid block of this size or null")
    fn allocate(&self, bytes: usize) -> *var u8 {
        unsafe { rune_raw_alloc(bytes as u64) }
    }

    @safe("the runtime ignores a null block")
    fn deallocate(&self, block: *var u8) {
        unsafe { rune_raw_free(block) }
    }

    @safe("the runtime copies the contents it can keep")
    fn reallocate(&self, block: *var u8, bytes: usize) -> *var u8 {
        unsafe { rune_raw_realloc(block, bytes as u64) }
    }
}

/// The process heap, ready to use: `mem::allocator.allocate(n)`.
pub global allocator: SystemAllocator = SystemAllocator {}

/// A block pointer that refers to nothing yet. `deallocate` and `reallocate`
/// both accept it, so a container can start out holding one.
@safe("a null block is never read through; it only marks 'nothing allocated'")
pub fn noBlock() -> *var u8 { unsafe { 0 as *var u8 } }

/// True when a block pointer refers to nothing.
@safe("comparing an address to zero reads no memory")
pub fn isNull(block: *var u8) -> bool { unsafe { block as u64 == 0 } }

/// Copies `bytes` from one block to another. The two must not overlap.
@safe("both blocks are sized by the caller, which is where the invariant is")
pub fn copy(dst: *var u8, src: *u8, bytes: usize) {
    if bytes == 0 { return }
    unsafe { rune_raw_copy(dst, src, bytes as u64) }
}

/// The address `bytes` further into a block. The caller is responsible for
/// that address still being inside it.
@safe("address arithmetic reads nothing; the block's extent is the caller's")
pub fn offset(block: *var u8, bytes: usize) -> *var u8 {
    unsafe { (block as u64 + bytes as u64) as *var u8 }
}

/// Sets `bytes` of a block to zero. A null block is accepted and ignored.
@safe("the block is sized by the caller, which is where the invariant is")
pub fn zero(block: *var u8, bytes: usize) {
    unsafe { rune_raw_zero(block, bytes as u64) }
}

/// True when `bytes` of a block are all zero — the test for "never written",
/// worth making only when `T` has no all-zero value. See `is_counted`.
@safe("reads exactly the bytes the caller sized, and only to compare them")
pub fn isZeroed(block: *u8, bytes: usize) -> bool {
    unsafe { rune_raw_is_zero(block, bytes as u64) }
}

//===--------------------------------------------------------------------===//
// Viewing raw memory as a slice
//===--------------------------------------------------------------------===//

/// `count` elements of `T` starting at `block`, as a slice.
///
/// Nothing is copied: the slice is the block's address and the count, so it
/// reads the same memory the block does and is valid exactly as long as the
/// block is. This is how a container hands its contents to code that takes
/// a `[T]` — see `Vector::asSlice` — and the caller is responsible for the
/// block holding `count` initialised elements.
///
///     let view = unsafe { mem::slice_of<T>(self.block as *var T, self.count) }
@unsafe
@intrinsic("slice_of")
pub fn slice_of<T>(block: *var T, count: usize) -> [T]

/// Where a slice's elements start.
///
/// The other direction: a slice is an address and a count, and this is the
/// address. It is what a routine that has to reach the *slots* rather than
/// the values needs — `&values[i]` hands back the value where `T` is a
/// handle, which is the right answer for reading and the wrong one for
/// emptying.
@unsafe
@intrinsic("slice_data")
pub fn slice_data<T>(values: [T]) -> *var T

//===--------------------------------------------------------------------===//
// Ownership in raw storage
//===--------------------------------------------------------------------===//
//
// A container that keeps its elements in memory the compiler cannot see moves
// values in and out of that memory with these. They mean the same thing under
// both memory models — what goes in belongs to the slot, what comes out
// belongs to the caller — which is what lets one container source serve both
// `--memory arc` and `--memory zombie`. (The `std::collections` rewrite that
// uses them is Milestone C of the Zombie work; see docs/roadmap.md.)

/// Puts `value` into the slot at `slot`, which the slot then owns. Whatever
/// the slot held before is not released — see `drop_at`.
@unsafe
@intrinsic("store")
pub fn store<T>(slot: *var T, value: T)

/// Takes the value out of the slot at `slot`, leaving it empty.
@unsafe
@intrinsic("take")
pub fn take<T>(slot: *var T) -> T

/// Destroys the value in the slot at `slot` and leaves the slot empty.
@unsafe
@intrinsic("drop_at")
pub fn drop_at<T>(slot: *var T)

/// All-zero bytes, read as a `T`. Not a value: a null reference, an empty
/// string that is no string, a struct of nothing. For the one place that
/// has to hand back a `T` it does not have — a task leaving a suspension
/// point because it was cancelled, whose result nothing will look at.
@unsafe
@intrinsic("zeroed")
pub fn zeroed<T>() -> T

/// Puts `value` into `place` and hands back what was there.
@safe("the place is a live borrow, and every write into it is balanced")
@intrinsic("replace")
pub fn replace<T>(place: &var T, value: T) -> T

//===--------------------------------------------------------------------===//
// Reference counting, for containers that hold their own storage
//===--------------------------------------------------------------------===//

/// Claims a reference to `value`. No effect on a type that is not counted.
///
/// Only needed when a value is stored somewhere the compiler cannot see — raw
/// memory. Everything else is balanced for you.
@unsafe
@intrinsic("retain")
pub fn retain<T>(value: T)

/// Gives up a reference to `value`. Must balance a `retain`.
@unsafe
@intrinsic("release")
pub fn release<T>(value: T)

//===--------------------------------------------------------------------===//
// Clone: values a copy of which means what it says
//===--------------------------------------------------------------------===//

/// Types the compiler will copy for you.
///
/// `Clone` is an **automatic** mark: nobody implements it, because there is
/// nothing to implement. A type has it when every part of it has it, so a
/// struct of numbers has it without saying so and a struct that gains a
/// `String` field keeps it — the answer follows the type as it changes.
///
/// Two things do not have it on their own:
///
///  * anything that runs a `deinit`. A destructor is a promise — close this,
///    free that — and a copy made field by field would make the promise
///    twice. Such a type says what copying it means by writing
///    `fn clone(&self) -> Self`, which `$clone()` then calls, and claims the
///    mark with `bind mem::Clone to ...`.
///  * anything the compiler cannot look into: a closure and its captures, an
///    `Any`, a `dyn Mark`, a raw pointer. `String` is bound below, because a
///    string's contents never change and a copy of one is a copy.
///
/// Write it as a bound when a function has to copy what it is given:
///
///     fn twice<T: mem::Clone>(value: &T) -> (T, T) {
///         (value.$clone(), value.$clone())
///     }
///
/// `@never(mem::Clone)` on a type refuses it outright, whatever its parts
/// say.
@auto
pub mark Clone {}

/// A `String` is immutable and counted: a copy of one is a copy of a value.
bind Clone to String {}

//===--------------------------------------------------------------------===//
// Handle: one owned value on the heap
//===--------------------------------------------------------------------===//

//===--------------------------------------------------------------------===//
// Standing in for a value
//===--------------------------------------------------------------------===//
//
// `Handle`, `Box`, `Rc` and the borrows `Checked` hands out all hold a value
// and lend it. That is what makes `.` reach through them: a type with a
// `look(&self) -> &T from self` answers a member it does not have itself
// with `T`'s, and one with a `touch(&var self) -> &var T from self` lets it
// be written as well.
//
//     var b = mem::boxed(Point { x: 1, y: 2 })
//     b.x = 10            // through `touch`
//     io::println(b.sum().$str())   // through `look`
//
// It can never hide anything: the reach-through only runs once the member
// has *not* been found on the stand-in, so `b.duplicate()` is still the
// box's own. An `Rc` has no `touch`, so writing through one is refused and
// the message says to put a `Checked<T>` inside.

/// A single `T` living on the heap, owned by this handle.
///
/// `Handle` is a class, so it is reference counted: copies share one value,
/// and the last one to go releases it. Nothing about using one is unsafe —
/// there is no way to reach the value after it is gone, and no way to free it
/// twice. This is what most code should reach for instead of an allocator.
///
///     var h = Handle<i64>(41)
///     h.set(h.get() + 1)
///     io::println(h.get().$str())      // 42
pub class Handle<T> {
    value: T

    fn init(self, value: T) { self.value = value }

    /// A copy of the value: a share under counting, a clone under single
    /// ownership.
    pub fn get(&self) -> T { self.value.$clone() }

    /// The value where it lies, borrowed for as long as the handle is.
    ///
    /// This is what a structure built out of handles walks with: `*h` and
    /// `get()` both hand back a *copy*, which under single ownership means
    /// cloning everything below — a list traversal that clones the rest of
    /// the list at every step. A borrow reads the one that is there.
    ///
    ///     var cur = &list.head
    ///     loop {
    ///         match cur {
    ///             Link::Empty => break,
    ///             Link::More(node) => { n += 1; cur = &node.look().next }
    ///         }
    ///     }
    pub fn look(&self) -> &T from self { &self.value }

    /// The same, to write through: `h.touch().field = v` changes the value
    /// in place rather than replacing the whole of it.
    pub fn touch(&var self) -> &var T from self { &var self.value }

    /// `look` under its older name.
    @alias("get_ref")
    pub fn borrowed(&self) -> &T from self { &self.value }

    /// Replaces the value. Every handle sharing it sees the change.
    pub fn set(&var self, value: T) { self.value = value }

    /// Puts `value` in and hands back what was there — the read and the write
    /// in one step, so nothing has to clone the old value to keep it.
    ///
    ///     let previous = h.replace(next)
    pub fn replace(&var self, value: T) -> T {
        replace<T>(&var self.value, value)
    }

    /// Exchanges the two handles' values.
    pub fn swap(&var self, other: &var Handle<T>) {
        let mine = replace<T>(&var self.value, unsafe { zeroed<T>() })
        let theirs = replace<T>(&var other.value, mine)
        self.value = theirs
    }

    /// True when the two names refer to the *same* handle, rather than to two
    /// handles whose values agree. `==` answers the second question; this one
    /// compares addresses and asks nothing of `T`.
    ///
    ///     let a = mem::of(1)
    ///     let b = a                    // the same handle
    ///     a.sameAs(&b)                 // true
    ///     a.sameAs(&mem::of(1))        // false — an equal value, not the same handle
    pub fn sameAs(&self, other: &Handle<T>) -> bool { equals<Handle<T>>(self, other) }

    /// A second handle on a value of its own, cloned from this one. Where a
    /// plain copy of a handle shares the value, this one does not.
    pub fn duplicate(&self) -> Handle<T> { Handle<T>(self.value.$clone()) }
}

// Two handles are equal when the values they hold are, whatever `T` is: the
// comparison is worked out from the layout, so `T` needs no mark for it. Use
// `sameAs` for the other question — whether they are the same handle.
bind<T> operator::eq to Handle<T> {
    fn eq(&self, other: &Handle<T>) -> bool { equals<T>(self.look(), other.look()) }
}

// A handle shows what it holds, so `println!("{h}")` reads the value rather
// than an address.
bind<T: io::Display> io::Display to Handle<T> {
    fn display(&self) -> String { self.look().display() }
}

// A handle behaves like a pointer: `*h` reads the value, `*h = v` writes it.
// `deref` and `derefSet` are the two halves; `operator::"*"` is the same
// operator written as punctuation.
bind<T> operator::"*" to Handle<T> {
    @alias("Asterisk")
    fn deref(&self) -> T { self.value.$clone() }

    @alias("AsteriskEquals")
    fn derefSet(&var self, value: T) { self.value = value }
}

/// `mem::of(v)` reads better than `Handle<T>(v)` when `T` is obvious.
pub fn of<T>(value: T) -> Handle<T> { Handle<T>(value) }

//===--------------------------------------------------------------------===//
// Box: one value on the heap, with exactly one owner
//===--------------------------------------------------------------------===//

/// A `T` on the heap that exactly one place owns.
///
/// `Handle` is a class, so under `--memory arc` two names for one handle share
/// the value and a reference count decides when it goes. A `Box` keeps no
/// count: it is a value with a destructor, so it is **moved** rather than
/// copied — in both memory models — and the one place holding it is the one
/// that frees it. That makes it the honest choice for a node in a structure
/// you own outright, and the only smart pointer whose cost is a single
/// machine word and no bookkeeping at all.
///
///     var b = mem::boxed(41)
///     *b.touch() += 1
///     io::println(b.look().$str())     // 42
///
/// A box is not `Clone`: duplicating one would free the same block twice.
/// `duplicate()` makes a second box over a clone of the value, which is a
/// different and explicit thing.
pub struct Box<T> {
    block: *var u8

    /// Destroys the value and returns its block.
    fn deinit(&self) {
        if isNull(self.block) { return }
        unsafe { drop_at<T>(self.block as *var T) }
        allocator.deallocate(self.block)
    }

    /// The value where it lies, borrowed for as long as the box is. This is
    /// the read that costs nothing; `get()` hands back a copy.
    pub fn look(&self) -> &T from self { unsafe { &(self.block as *var T)[0] } }

    /// The same, to write through: `b.touch().field = v` changes the value in
    /// place rather than replacing the whole of it.
    pub fn touch(&var self) -> &var T from self {
        unsafe { &var (self.block as *var T)[0] }
    }

    /// A copy of the value.
    pub fn get(&self) -> T { self.look().$clone() }

    /// Replaces the value, destroying what was there.
    pub fn set(&var self, value: T) { *self.touch() = value }

    /// Puts `value` in and hands back what was there.
    pub fn replace(&var self, value: T) -> T { replace<T>(self.touch(), value) }

    /// True when the two names are the same box.
    pub fn sameAs(&self, other: &Box<T>) -> bool {
        unsafe { self.block as u64 == other.block as u64 }
    }

    /// A second box over a clone of the value.
    pub fn duplicate(&self) -> Box<T> { boxed<T>(self.look().$clone()) }
}

/// `mem::boxed(v)` — a `T` on the heap, owned by the box it hands back.
pub fn boxed<T>(value: T) -> Box<T> {
    let bytes = size_of<T>()
    let block = allocator.allocate(bytes)
    if isNull(block) { process::panic("Box: out of memory") }
    zero(block, bytes)
    unsafe { store<T>(block as *var T, value) }
    Box<T> { block: block }
}

// A box behaves like a pointer: `*b` reads the value, `*b = v` writes it.
bind<T> operator::"*" to Box<T> {
    @alias("Asterisk")
    fn deref(&self) -> T { self.look().$clone() }

    @alias("AsteriskEquals")
    fn derefSet(&var self, value: T) { *self.touch() = value }
}

// Two boxes are equal when the values they hold are; `sameAs` asks the other
// question.
bind<T> operator::eq to Box<T> {
    fn eq(&self, other: &Box<T>) -> bool { equals<T>(self.look(), other.look()) }
}

bind<T: io::Display> io::Display to Box<T> {
    fn display(&self) -> String { self.look().display() }
}

//===--------------------------------------------------------------------===//
// Rc and Weak: shared ownership with a count you can see
//===--------------------------------------------------------------------===//
//
// One block holds two counts and the value:
//
//     [ strong: i64 ][ weak: i64 ][ padding ][ T ]
//
// `strong` is how many `Rc`s there are, `weak` how many `Weak`s. The value is
// destroyed when `strong` reaches zero; the block is returned when both do, so
// a `Weak` that outlives the value has somewhere to read the zero from.

/// Where the value starts in an `Rc` block: after the two counts, rounded up
/// to whatever `T` needs.
fn rcValueOffset<T>() -> usize {
    let head: usize = 16
    let a = align_of<T>()
    if a <= 8 { return head }
    ((head + a - 1) / a) * a
}

@safe("the counts are the first two words of a block this module allocated")
fn rcStrong(block: *var u8) -> i64 { unsafe { (block as *var i64)[0] } }

@safe("the counts are the first two words of a block this module allocated")
fn rcSetStrong(block: *var u8, n: i64) { unsafe { (block as *var i64)[0] = n } }

@safe("the counts are the first two words of a block this module allocated")
fn rcWeakCount(block: *var u8) -> i64 { unsafe { (block as *var i64)[1] } }

@safe("the counts are the first two words of a block this module allocated")
fn rcSetWeak(block: *var u8, n: i64) { unsafe { (block as *var i64)[1] = n } }

/// A `T` on the heap shared by as many owners as ask for one, each of which
/// says so by cloning.
///
/// This is the count `--memory zombie` does not give you for free. Under
/// `--memory arc` a class already behaves this way, and an `Rc` costs the same
/// thing written down; under single ownership it is the only way two places
/// can hold the same value, because the count is an ordinary field this
/// module keeps rather than something the compiler emits.
///
///     let a = mem::shared("hello")
///     let b = a.$clone()              // two owners
///     io::println(a.strongCount().$str())   // 2
///
/// Sharing is read-only: `look()` borrows the value, and there is no `touch()`
/// because two owners could then write at once. Put a `mem::Checked<T>` inside
/// when the value has to change:
///
///     let cell = mem::shared(mem::Checked<i64>(0))
///     { var w = cell.look().borrowVar(); *w = 42 }
///
/// A cycle of `Rc`s never reaches zero, which is what `Weak` is for: take a
/// `downgrade()` for the back-edge and `upgrade()` it when you need the value.
pub struct Rc<T> {
    block: *var u8

    /// One more owner.
    fn clone(&self) -> Self {
        if !isNull(self.block) { rcSetStrong(self.block, rcStrong(self.block) + 1) }
        Rc<T> { block: self.block }
    }

    /// One fewer. The value goes when the last owner does; the block waits for
    /// the last `Weak` as well.
    fn deinit(&self) {
        if isNull(self.block) { return }
        let n = rcStrong(self.block) - 1
        rcSetStrong(self.block, n)
        if n > 0 { return }
        unsafe { drop_at<T>(offset(self.block, rcValueOffset<T>()) as *var T) }
        if rcWeakCount(self.block) == 0 { allocator.deallocate(self.block) }
    }

    /// The value where it lies, borrowed for as long as this owner is.
    pub fn look(&self) -> &T from self {
        unsafe { &(offset(self.block, rcValueOffset<T>()) as *var T)[0] }
    }

    /// A copy of the value.
    pub fn get(&self) -> T { self.look().$clone() }

    /// How many owners there are, this one included.
    pub fn strongCount(&self) -> i64 {
        if isNull(self.block) { return 0 }
        rcStrong(self.block)
    }

    /// How many `Weak`s point at it.
    pub fn weakCount(&self) -> i64 {
        if isNull(self.block) { return 0 }
        rcWeakCount(self.block)
    }

    /// True when this is the only owner.
    pub fn isUnique(&self) -> bool { self.strongCount() == 1 }

    /// A reference that does not keep the value alive — the back-edge of a
    /// cycle, or a cache that should not stop anything being freed.
    pub fn downgrade(&self) -> Weak<T> {
        if !isNull(self.block) { rcSetWeak(self.block, rcWeakCount(self.block) + 1) }
        Weak<T> { block: self.block }
    }

    /// True when the two names are owners of the same value.
    pub fn sameAs(&self, other: &Rc<T>) -> bool {
        unsafe { self.block as u64 == other.block as u64 }
    }
}

/// Cloning an `Rc` is claiming a share, which is what a copy of one means.
bind<T> Clone to Rc<T> {}

bind<T> operator::"*" to Rc<T> {
    @alias("Asterisk")
    fn deref(&self) -> T { self.look().$clone() }
}

bind<T> operator::eq to Rc<T> {
    fn eq(&self, other: &Rc<T>) -> bool { equals<T>(self.look(), other.look()) }
}

bind<T: io::Display> io::Display to Rc<T> {
    fn display(&self) -> String { self.look().display() }
}

/// `mem::shared(v)` — a `T` on the heap with one owner to start with.
pub fn shared<T>(value: T) -> Rc<T> {
    let bytes = rcValueOffset<T>() + size_of<T>()
    let block = allocator.allocate(bytes)
    if isNull(block) { process::panic("Rc: out of memory") }
    zero(block, bytes)
    rcSetStrong(block, 1)
    unsafe { store<T>(offset(block, rcValueOffset<T>()) as *var T, value) }
    Rc<T> { block: block }
}

/// A reference to an `Rc`'s value that does not keep it alive.
///
/// Ask for the value with `upgrade()`, which hands back an owner when there
/// still is one and nothing when the value has gone. This is what breaks a
/// cycle: a parent owns its children with `Rc`, each child points back with a
/// `Weak`, and dropping the parent frees the lot.
///
///     let parent = mem::shared(Node { ... })
///     let back = parent.downgrade()
///     match back.upgrade() { Some(p) => ..., None => ... }
pub struct Weak<T> {
    block: *var u8

    fn clone(&self) -> Self {
        if !isNull(self.block) { rcSetWeak(self.block, rcWeakCount(self.block) + 1) }
        Weak<T> { block: self.block }
    }

    fn deinit(&self) {
        if isNull(self.block) { return }
        let n = rcWeakCount(self.block) - 1
        rcSetWeak(self.block, n)
        if n == 0 && rcStrong(self.block) == 0 { allocator.deallocate(self.block) }
    }

    /// An owner of the value, or nothing when the value has gone.
    pub fn upgrade(&self) -> Rc<T>? {
        if isNull(self.block) { return nil }
        if rcStrong(self.block) == 0 { return nil }
        rcSetStrong(self.block, rcStrong(self.block) + 1)
        Some(Rc<T> { block: self.block })
    }

    /// True when the value is still there.
    pub fn isAlive(&self) -> bool {
        if isNull(self.block) { return false }
        rcStrong(self.block) > 0
    }
}

/// Cloning a `Weak` is claiming another weak reference.
bind<T> Clone to Weak<T> {}

//===--------------------------------------------------------------------===//
// Buffer: n values, checked on every access
//===--------------------------------------------------------------------===//

/// `size` values of `T`.
///
///     var b = buffer::Buffer<i64>(4)          // four zeroed slots
///     b[2] = 7
///     io::println(b[2].$str())
///
///     var c = buffer::Buffer<i64>(4, 1)       // four slots holding 1
///
/// Leaving the fill out zeroes the storage, which means two different things
/// depending on `T`, and both are safe:
///
/// * For a value type — an integer, a float, `bool`, a struct of those — all
///   zero *is* a value, so every slot starts at `0` / `0.0` / `false` and
///   reads back like any other.
/// * For a counted type — a class, a `String` — all zero is not a reference to
///   anything, so a slot that has never been written reads as empty: `at`
///   gives `nil` and `get` aborts. Write to it and it behaves normally from
///   then on.
///
/// What it never does is hand back whatever the allocator happened to leave
/// there, which is the one thing a safe container must not do.
pub class Buffer<T> {
    block: *var u8
    count: i64

    fn init(self, size: i64, fill: T? = nil) {
        self.count = if size > 0 { size } else { 0 }
        if self.count == 0 {
            self.block = noBlock()
            return
        }
        let bytes = self.count as usize * size_of<T>()
        self.block = allocator.allocate(bytes)
        if isNull(self.block) {
            process::panic("Buffer: out of memory")
            self.count = 0
            return
        }
        // Zero first, unconditionally: it is what an absent fill means, and it
        // is also the state a fill overwrites, so nothing is ever read before
        // it is written.
        zero(self.block, bytes)
        match fill {
            Some(value) => {
                var i = 0
                while i < self.count {
                    // A fresh copy per slot: a share of the one value under
                    // counting, an independent clone under single ownership.
                    unsafe {
                        store<T>(&var (self.block as *var T)[i] as *var T, value.$clone())
                    }
                    i += 1
                }
            }
            None => {}
        }
    }

    fn deinit(self) {
        var i = 0
        while i < self.count {
            // `drop_at` ignores a null reference, so a slot still zeroed from
            // the constructor costs nothing here.
            unsafe { drop_at<T>(&var (self.block as *var T)[i] as *var T) }
            i += 1
        }
        allocator.deallocate(self.block)
    }

    //=== Size ===========================================================//

    /// How many values it holds. Fixed for the buffer's whole life.
    pub fn length(&self) -> i64 { self.count }

    /// True when it was made with a size of zero.
    pub fn isEmpty(&self) -> bool { self.count == 0 }

    /// True when `index` names a slot in this buffer.
    pub fn holds(&self, index: i64) -> bool {
        index >= 0 && index < self.count
    }

    /// True when `index` names a slot that has something in it.
    ///
    /// For a value type every slot in range is occupied, because zero is a
    /// value. For a counted type a slot is occupied once something has been
    /// written to it.
    @safe("the index is compared against the count before the block is read")
    pub fn occupied(&self, index: i64) -> bool {
        if !self.holds(index) { return false }
        if !is_counted<T>() { return true }
        let stride = size_of<T>()
        let slot = offset(self.block, index as usize * stride)
        !isZeroed(unsafe { slot as *u8 }, stride)
    }

    //=== Borrowing ======================================================//

    /// The value at `index`, borrowed, or nothing when there is no such slot
    /// or nothing has been written to it — the borrowing form of `at`.
    @safe("the slot is checked for range and for contents before the borrow")
    pub fn peek(&self, index: i64) -> (&T from self)? {
        if !self.occupied(index) { return nil }
        Some(unsafe { &(self.block as *var T)[index] })
    }

    /// The value at `index`, borrowed, whatever its bytes are. Aborts when
    /// there is no such slot.
    ///
    /// Like `read`, it takes the caller's word that the slot has been
    /// written: a table that keeps its own record of which slots are live
    /// borrows through this.
    @safe("the index is compared against the count before the borrow")
    pub fn look(&self, index: i64) -> &T from self {
        if !self.holds(index) { process::panic("Buffer index out of range") }
        unsafe { &(self.block as *var T)[index] }
    }

    /// The value at `index`, borrowed to write through. Aborts when there is
    /// no such slot.
    @safe("the index is compared against the count before the borrow")
    pub fn touch(&var self, index: i64) -> &var T from self {
        if !self.holds(index) { process::panic("Buffer index out of range") }
        unsafe { &var (self.block as *var T)[index] }
    }

    //=== Copying ========================================================//
    //
    // Each of these hands back a value of the caller's own — a share under
    // counting, a deep copy under single ownership — and so is only here for
    // a `T` that can be cloned. `peek` and `look` are for the rest.

    /// The value at `index`, or nothing when there is no such slot or nothing
    /// has been written to it. This is the form to reach for when the index
    /// came from outside.
    ///
    /// "Nothing has been written to it" is decided by `occupied`, which reads
    /// a slot of all zero bytes as empty. That is exactly right for a slot
    /// nobody has touched and wrong for one holding a value whose bytes
    /// happen to all be zero — an empty `String`, or the first variant of a
    /// counted enum that carries nothing. A caller that keeps its own record
    /// of which slots are live wants `read`, which asks no such question.
    @safe("the slot is checked for range and for contents before the read")
    pub fn at(&self, index: i64) -> T? where T: Clone {
        match self.peek(index) {
            Some(r) => Some(r.$clone())
            None => nil
        }
    }

    /// A buffer of its own, the same size, holding a clone of every slot
    /// — written or not: a slot nobody wrote is zero bytes here too. What
    /// `$clone()` does to a `Buffer`; the memberwise copy would share the
    /// block.
    @safe("both blocks are sized by the same count; every slot below it is read once")
    pub fn clone(&self) -> Self where T: Clone {
        var out = Buffer<T>(self.count)
        var i = 0
        while i < self.count {
            // A counted slot nobody wrote is zero bytes: no value to clone,
            // and the fresh buffer already has zero bytes there.
            if self.occupied(i) {
                let value = unsafe { (self.block as *var T)[i] }.$clone()
                unsafe { store<T>(&var (out.block as *var T)[i] as *var T, value) }
            }
            i += 1
        }
        out
    }

    /// The value at `index`, whatever its bytes are, or nothing when there is
    /// no such slot.
    ///
    /// The read `at` cannot do: it takes the caller's word that the slot has
    /// been written, so a value of all zero bytes comes back as the value it
    /// is rather than as nothing. A hash table with a state buffer of its own
    /// already knows which slots are live, and this is the read for it.
    @safe("the index is compared against the count before the read")
    pub fn read(&self, index: i64) -> T? where T: Clone {
        if !self.holds(index) { return nil }
        Some(self.look(index).$clone())
    }

    /// The value at `index`. Aborts when there is no such slot, or when
    /// nothing has been written to it.
    pub fn get(&self, index: i64) -> T where T: Clone {
        match self.at(index) {
            Some(v) => v,
            None => {
                if self.holds(index) {
                    process::panic("Buffer slot has not been written")
                } else {
                    process::panic("Buffer index out of range")
                }
                self.at(0).unwrap()
            }
        }
    }

    //=== Writing ========================================================//

    /// Replaces the value at `index`. Returns false when there is no such
    /// slot, leaving the buffer untouched.
    @safe("the index is compared against the count before the write")
    pub fn put(&var self, index: i64, value: T) -> bool {
        if !self.holds(index) { return false }
        let slot = unsafe { self.block as *var T }
        // Drop what was there, then move `value` in.
        unsafe {
            drop_at<T>(&var slot[index] as *var T)
            store<T>(&var slot[index] as *var T, value)
        }
        true
    }

    /// Takes the value out of the slot at `index`, handing it back and leaving
    /// the slot empty (zeroed). Nothing when there is no such slot. The caller
    /// owns what comes out; the buffer no longer does.
    @safe("the index is compared against the count before the move")
    pub fn take(&var self, index: i64) -> T? {
        if !self.holds(index) { return nil }
        let slot = unsafe { self.block as *var T }
        let value = unsafe { take<T>(&var slot[index] as *var T) }
        let stride = size_of<T>()
        zero(offset(self.block, index as usize * stride), stride)
        Some(value)
    }

    /// Empties the slot at `index`, releasing whatever was there.
    ///
    /// For a counted type the slot reads as `nil` afterwards. For a value type
    /// there is no such thing as an empty slot, so this sets it back to zero.
    /// Returns false when there is no such slot.
    @safe("the index is compared against the count before the write")
    pub fn clear(&var self, index: i64) -> bool {
        if !self.holds(index) { return false }
        let stride = size_of<T>()
        unsafe {
            drop_at<T>(&var (self.block as *var T)[index] as *var T)
            zero(offset(self.block, index as usize * stride), stride)
        }
        true
    }

    /// Writes a copy of `value` into every slot.
    pub fn fill(&var self, value: T) where T: Clone {
        var i = 0
        while i < self.count {
            // A copy per slot — a share under counting, a clone under single
            // ownership — so the argument survives the loop.
            self.put(i, value.$clone())
            i += 1
        }
    }
}

/// A buffer writes its own `clone`, so it claims the mark that copy stands
/// behind — when what it holds can be copied too.
bind<T> Clone to Buffer<T> where T: Clone {}

// `b[i]` and `b[i] = v`, both bounds checked: reading past the end aborts
// rather than reading whatever is there. Reading borrows, like `peek`, and
// aborts on a slot nothing has been written to.
bind<T> operator::"[]" to Buffer<T> {
    fn index(&self, index: i64) -> &T from self {
        match self.peek(index) {
            Some(r) => r,
            None => {
                if self.holds(index) {
                    process::panic("Buffer slot has not been written")
                } else {
                    process::panic("Buffer index out of range")
                }
                self.look(index)
            }
        }
    }

    fn indexSet(&var self, index: i64, value: T) {
        if !self.put(index, value) {
            process::panic("Buffer index out of range")
        }
    }
}

//===--------------------------------------------------------------------===//
// Checked: exclusive access decided at run time
//===--------------------------------------------------------------------===//

/// A value whose borrows are checked as the program runs, for the places the
/// compiler cannot prove exclusive access ahead of time.
///
/// This is what the borrow diagnostics point to when two borrows genuinely
/// have to overlap, or a field has to change behind a shared `&`: put the
/// value in a `Checked`, and ask for a borrow when you need one. A shared
/// `borrow()` reads; the one `borrowVar()` reads and writes; asking for a
/// conflicting one aborts rather than letting the two race.
///
///     let cell = mem::Checked<i64>(0)
///     { var w = cell.borrowVar(); *w = 41; *w = *w + 1 }
///     io::println((*cell.borrow()).$str())      // 42
///
/// It costs one machine word and no reference count, so it works the same
/// under `--memory arc` and `--memory zombie`.
pub class Checked<T> {
    value: T
    // 0 = free; n > 0 = n shared borrows out; -1 = the one mutable borrow.
    state: i64

    fn init(self, value: T) {
        self.value = value
        self.state = 0
    }

    @safe("the state word belongs to this Checked and is written only here")
    fn setState(&self, next: i64) {
        unsafe { store<i64>(&self.state as *var i64, next) }
    }

    /// A shared, read-only borrow. Aborts if the mutable borrow is out.
    pub fn borrow(&self) -> Ref<T> from self {
        if self.state < 0 {
            process::panic("Checked: already borrowed for writing")
        }
        self.setState(self.state + 1)
        Ref<T> { owner: self }
    }

    /// The one mutable borrow. Aborts if any borrow is already out.
    pub fn borrowVar(&self) -> RefVar<T> from self {
        if self.state != 0 {
            process::panic("Checked: already borrowed")
        }
        self.setState(-1)
        RefVar<T> { owner: self }
    }

    /// True when no borrow is out.
    pub fn isFree(&self) -> bool { self.state == 0 }
}

/// A shared borrow handed out by `Checked::borrow`: read it with `*r`, and the
/// claim is returned when `r` goes out of scope.
pub struct Ref<T> {
    owner: &Checked<T>

    fn deinit(&self) { self.owner.setState(self.owner.state - 1) }

    /// The value where it lies. `.` reaches through a `Ref` to it, so
    /// `r.field` and `r.method()` read the value without copying it.
    pub fn look(&self) -> &T from self { &self.owner.value }
}
bind<T> operator::"*" to Ref<T> {
    @alias("Asterisk")
    fn deref(&self) -> T { self.owner.value.$clone() }
}

/// The mutable borrow handed out by `Checked::borrowVar`: read or write it with
/// `*r`, and the exclusive claim is returned when `r` goes out of scope.
pub struct RefVar<T> {
    owner: &Checked<T>

    fn deinit(&self) { self.owner.setState(0) }

    @safe("the run-time check makes this the only borrow, so the write is exclusive")
    fn write(&self, value: T) {
        unsafe {
            drop_at<T>(&self.owner.value as *var T)
            store<T>(&self.owner.value as *var T, value)
        }
    }

    /// The value where it lies, to read.
    pub fn look(&self) -> &T from self { &self.owner.value }

    /// The value where it lies, to write: the run-time check has already
    /// made this the only borrow.
    @safe("the run-time check makes this the only borrow out")
    pub fn touch(&var self) -> &var T from self {
        unsafe { &var (&self.owner.value as *var T)[0] }
    }
}
bind<T> operator::"*" to RefVar<T> {
    @alias("Asterisk")
    fn deref(&self) -> T { self.owner.value.$clone() }

    @alias("AsteriskEquals")
    fn derefSet(&var self, value: T) { self.write(value) }
}

//===--------------------------------------------------------------------===//
// Arena: owned storage behind generational handles
//===--------------------------------------------------------------------===//

/// A handle into an `Arena`. It is a plain value — copy it, store it, pass it
/// around freely — and it stays valid until the slot it names is removed. A
/// handle to a removed slot is detected and reads as nothing, rather than
/// quietly naming whatever took the slot's place.
pub struct Slot {
    index: i64
    generation: i64
}

/// Owned storage that hands out `Slot` handles instead of borrows — the answer
/// when a `weak` back-reference or a borrow that has to outlive its owner is
/// what a design reaches for, but single ownership has no count to lend one.
///
/// Everything the arena holds lives as long as the arena does; a `Slot` names
/// one entry, and a stale handle (its slot removed and perhaps reused) is
/// caught by a generation stamp rather than dangling.
///
///     var a = mem::Arena<String>()
///     let h = a.insert("first")
///     io::println(a.get(h).unwrap())     // first
///     a.remove(h)
///     io::println(a.get(h).isNil().$str())   // true — the handle is stale
///
/// It keeps no reference count, so it works the same under both memory models.
pub class Arena<T> {
    // Values live in raw storage — one buffer, not a vector of options, since
    // `T?` would flatten when `T` is itself an option. The bookkeeping (which
    // slots are live, and each slot's generation stamp) is kept alongside.
    values: Buffer<T>
    occupied: vector::Vector<i64>    // 1 = live, 0 = free
    generations: vector::Vector<i64> // bumped on removal, so old handles go stale
    free: vector::Vector<i64>        // freed indices, ready to reuse
    slots: i64                       // how many slots have ever been created
    live: i64

    fn init(self) {
        self.values = Buffer<T>(0)
        self.occupied = vector::Vector<i64>()
        self.generations = vector::Vector<i64>()
        self.free = vector::Vector<i64>()
        self.slots = 0
        self.live = 0
    }

    /// How many live entries it holds.
    pub fn length(&self) -> i64 { self.live }

    /// True when it holds none.
    pub fn isEmpty(&self) -> bool { self.live == 0 }

    @safe("the new buffer is sized for every slot before any value moves into it")
    fn grow(&var self, wanted: i64) {
        if wanted <= self.values.length() { return }
        var cap = self.values.length() * 2
        if cap < 4 { cap = 4 }
        if cap < wanted { cap = wanted }
        var bigger = Buffer<T>(cap)
        // Move the live values across. Only the slots that already exist have
        // an `occupied` entry — the slot being added has not been pushed yet.
        var i = 0
        while i < self.occupied.length() {
            if self.occupied.at(i).unwrap() == 1 {
                match self.values.take(i) {
                    Some(v) => { bigger.put(i, v) },
                    None => {},
                }
            }
            i += 1
        }
        self.values = bigger
    }

    /// Stores `value` and hands back a handle to it.
    pub fn insert(&var self, value: T) -> Slot {
        self.live += 1
        match self.free.pop() {
            Some(i) => {
                self.occupied.set(i, 1)
                self.values.put(i, value)
                Slot { index: i, generation: self.generations.at(i).unwrap() }
            },
            None => {
                let i = self.slots
                self.slots += 1
                self.grow(self.slots)
                self.occupied.push(1)
                self.generations.push(0)
                self.values.put(i, value)
                Slot { index: i, generation: 0 }
            },
        }
    }

    fn liveAt(&self, slot: Slot) -> bool {
        slot.index >= 0 && slot.index < self.slots &&
            self.occupied.at(slot.index).unwrap() == 1 &&
            self.generations.at(slot.index).unwrap() == slot.generation
    }

    /// The value a handle names, or nothing when the handle is stale.
    pub fn get(&self, slot: Slot) -> T? {
        if !self.liveAt(slot) { return nil }
        self.values.read(slot.index)
    }

    /// True when the handle still names a live entry.
    pub fn holds(&self, slot: Slot) -> bool { self.liveAt(slot) }

    /// Removes the entry a handle names, handing it back. A stale handle
    /// removes nothing and returns nothing.
    pub fn remove(&var self, slot: Slot) -> T? {
        if !self.liveAt(slot) { return nil }
        let taken = self.values.take(slot.index)
        self.occupied.set(slot.index, 0)
        self.generations.set(slot.index, slot.generation + 1)
        self.free.push(slot.index)
        self.live -= 1
        taken
    }
}
