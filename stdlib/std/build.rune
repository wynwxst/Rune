// std::build — what a package's `build.rune` is told, and how it answers.
//
// A package may keep a `build.rune` beside its `Rune.toml`. `rune` compiles
// it for the machine doing the building — whatever the package itself is
// built for — and runs it twice per build:
//
//   prepare   before the package is compiled. It can set `#Config` flags,
//             and add link arguments, libraries and library directories.
//   finish    after each executable is linked, once per executable. It can
//             post-process the file (strip it, lay it out as a disk image,
//             sign it), and say what `rune run` should hand the runner in
//             its place.
//
//     import std::build
//
//     fn main() -> i64 {
//         if build::finishing() {
//             let image = build::outDir() + "/" + build::artifactName() + ".img"
//             build::run(build::tool(["llvm-objcopy", "objcopy"]),
//                        ["-O", "binary", build::artifact(), image])
//             build::runWith(image)
//         }
//         0
//     }
//
// The script runs in the package's directory. It is told everything through
// the environment, which the functions below read; it answers by printing
// `rune:key=value` lines, which the functions below write. Anything else it
// prints is shown only when it fails, or under `rune build -v`. A script that
// exits with anything but 0 fails the build.
//
// It runs on every build, so what it does should be quick, or check for
// itself whether there is anything to do.

import std::env
import std::io
import std::process
import std::text
import std::collections::vector

//=== Where and what ======================================================//

/// True in the phase that runs before the package is compiled.
pub fn preparing() -> bool { env::getOr("RUNE_BUILD_PHASE", "") == "prepare" }

/// True in the phase that runs after an executable is linked.
pub fn finishing() -> bool { env::getOr("RUNE_BUILD_PHASE", "") == "finish" }

/// True while linking, for a target whose `linker = "build-script"`: the
/// script is then called in place of a linker, with a linker's arguments.
pub fn linking() -> bool { env::getOr("RUNE_BUILD_PHASE", "") == "link" }

/// The package's name, from its manifest.
pub fn packageName() -> String { env::getOr("RUNE_PACKAGE_NAME", "") }

/// The package's version, from its manifest.
pub fn packageVersion() -> String { env::getOr("RUNE_PACKAGE_VERSION", "") }

/// The directory holding `Rune.toml` and `build.rune`, as an absolute path.
pub fn packageDir() -> String { env::getOr("RUNE_PACKAGE_DIR", ".") }

/// Where this build's outputs go: `target/<target>/<profile>` under the
/// package. Whatever the script makes belongs here too.
pub fn outDir() -> String { env::getOr("RUNE_OUT_DIR", ".") }

/// `debug` or `release`.
pub fn profile() -> String { env::getOr("RUNE_PROFILE", "debug") }

/// True for `rune build --release`.
pub fn release() -> bool { profile() == "release" }

/// The target being built for, by the name `--target` was given — `wasm`,
/// `bare-x86`, a `[target.x]` table's `x` — or `host`.
pub fn target() -> String { env::getOr("RUNE_TARGET", "host") }

/// The target's LLVM triple; empty for the host.
pub fn triple() -> String { env::getOr("RUNE_TARGET_TRIPLE", "") }

/// True when the package is built with no hosted runtime.
pub fn freestanding() -> bool { env::getOr("RUNE_FREESTANDING", "0") == "1" }

/// The C compiler the target builds with, as `rune` would call it.
pub fn cc() -> String { env::getOr("RUNE_CC", "cc") }

/// The program that links for this target: its `linker`, else its `cc`.
pub fn linker() -> String { env::getOr("RUNE_LINKER", "cc") }

/// How that program takes its flags: `ld` for a linker, `driver` for a
/// compiler that links.
pub fn linkerKind() -> String { env::getOr("RUNE_LINKER_KIND", "driver") }

/// While finishing: the executable that was just linked.
pub fn artifact() -> String { env::getOr("RUNE_ARTIFACT", "") }

/// While finishing: its name, without directory or suffix.
pub fn artifactName() -> String { env::getOr("RUNE_ARTIFACT_NAME", "") }

//=== Linking =============================================================//
//
// With `linker = "build-script"` in the target's table, the link is the
// script's. It is called exactly as a linker would be — the objects, `-o`
// and every flag the build has for the link (a linker script, a package's
// `link-args`) — and can do with them what it likes:
//
//     if build::linking() {
//         var args = build::linkArguments()
//         build::runAll("i686-elf-ld", &args)
//     }

/// While linking: every argument, in order, as a linker would get them.
pub fn linkArguments() -> vector::Vector<String> { process::arguments() }

/// While linking: the file to write — the argument after `-o`.
pub fn linkOutput() -> String {
    let args = process::arguments()
    var i = 0
    while i + 1 < args.length() {
        if args.look(i) == "-o" { return args.look(i + 1).$clone() }
        i += 1
    }
    artifact()
}

/// While linking: the objects and archives — every argument ending in `.o`,
/// `.obj`, `.a` or `.lib`.
pub fn linkInputs() -> vector::Vector<String> {
    var out = vector::Vector<String>()
    for a in process::arguments() {
        if text::endsWith(a, &".o") || text::endsWith(a, &".obj") ||
           text::endsWith(a, &".a") || text::endsWith(a, &".lib") {
            out.push(a.$clone())
        }
    }
    out
}

//=== Answers =============================================================//

/// Sets `#Config(name)` for this package's own sources.
pub fn cfg(name: String) { io::println("rune:cfg=" + name) }

/// Sets `#Config(key == "value")` for this package's own sources.
pub fn cfgValue(key: String, value: String) {
    io::println("rune:cfg=" + key + "=" + value)
}

/// Adds an argument to the link of every executable in the package.
pub fn linkArg(argument: String) { io::println("rune:link-arg=" + argument) }

/// Links a native library, `-l<name>`.
pub fn linkLibrary(name: String) { io::println("rune:link-lib=" + name) }

/// Adds a directory to search for native libraries; relative to the package.
pub fn linkPath(directory: String) { io::println("rune:link-path=" + directory) }

/// While finishing: what `rune run` hands the target's runner instead of the
/// executable — a disk image made from it, say. A relative path is read from
/// the package's directory.
pub fn runWith(path: String) { io::println("rune:run=" + path) }

/// Shows a warning among the build's own output. The build carries on.
pub fn warning(message: String) { io::println("rune:warning=" + message) }

/// Stops the build, saying why.
pub fn fail(message: String) -> Never {
    io::println("rune:error=" + message)
    process::exit(1)
}

//=== Helpers =============================================================//

/// The first of `candidates` found on `PATH` — `["llvm-objcopy", "objcopy"]`
/// — as the name to run it by. Fails the build, naming them all, when none is.
pub fn tool(candidates: [String]) -> String {
    let path = env::getOr("PATH", "")
    let dirs = text::split(&path, &":")
    for name in candidates {
        for dir in dirs {
            let file = io::joinPath(dir, name)
            if !dir.$isEmpty() && io::exists(&file) {
                return name.$clone()
            }
        }
    }
    var names = ""
    for name in candidates {
        names = if names.$isEmpty() { name.$clone() } else { names + ", " + name }
    }
    fail("none of " + names + " is on PATH")
}

/// Runs `program` with `args` in the package's directory, and fails the build
/// — with its output — unless it succeeds.
pub fn run(program: String, args: [String]) {
    var all = vector::Vector<String>()
    for a in args { all.push(a.$clone()) }
    runAll(program, &all)
}

/// `run`, with the arguments in a vector: for a list worked out as the script
/// goes, like the one `linkArguments` hands back. `program` may carry
/// arguments of its own, separated by spaces: `"clang --target=i686-elf"`.
pub fn runAll(program: String, args: &vector::Vector<String>) {
    let words = text::split(&program, &" ")
    var c = process::Command(words.look(0).$clone())
    var i = 1
    while i < words.length() {
        if !words.look(i).$isEmpty() { c.arg(words.look(i).$clone()) }
        i += 1
    }
    for a in args { c.arg(a.$clone()) }
    c.inDirectory(packageDir())
    match c.run() {
        Some(out) => {
            if !out.succeeded() {
                io::print(out.stdout)
                io::print(out.stderr)
                fail(program + " exited with status " + out.status.$str())
            }
        }
        None => fail("cannot start " + program),
    }
}
