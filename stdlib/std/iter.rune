// std::iter — what `for` walks, and how to reshape it on the way past.
//
// `for` knows three shapes natively: a range, an array and a slice.
// Everything else it asks, and these two marks are the questions.
//
//     for value in thing { ... }
//
// If `thing` is an `Iterator`, the loop drives it directly. If it is a
// `Sequence`, the loop asks it for an iterator once and drives that. Both are
// in scope everywhere — `for` is syntax, so what it dispatches through cannot
// need an import.
//
// Writing one
// -----------
//
//     struct Countdown { pub remaining: i64 }
//
//     bind Iterator to Countdown {
//         type Item = i64
//         fn next(&var self) -> Self::Item? {
//             if self.remaining <= 0 { return nil }
//             self.remaining -= 1
//             self.remaining + 1
//         }
//     }
//
//     var down = Countdown { remaining: 3 }
//     for n in down { io::println(n) }              // 3 2 1
//
// (A `for` sequence cannot be a bare struct literal — the `{` would start the
// body — so name it first, or wrap it in parentheses.)
//
// A `Sequence` is what a container binds, because a container is not a cursor
// over itself: it hands out a fresh one, so two loops over the same container
// do not interfere.
//
// Reshaping one
// -------------
// `map`, `filter` and `zip` each wrap an iterator in another iterator. They
// compute nothing on their own: a value moves through the chain only when the
// loop at the end asks for it, so a chain over a million elements allocates
// nothing and walks the source once.
//
//     for name in people.map(||(p: Person) -> String { p.name }) { ... }
//
//     for n in numbers.filter(||(n: i64) -> bool { n % 2 == 0 }) { ... }
//
//     for (i, name) in iter::counting(0).zip(names.iterate()) { ... }
//
// `0..n` is loop syntax rather than a value, so `counting` is what numbers
// something; it never ends, which is safe because `zip` stops with the shorter
// side. `vector::collect(it)` is the other end of a chain: the adaptors are
// lazy, and it is what runs them.
//
// What the loop advances
// ----------------------
// `for` puts the iterator in a slot of its own, so it advances whatever a
// binding would have got. A struct iterator is copied, and the one you named
// is untouched afterwards; a class iterator is shared, and is left spent. Both
// follow from what the type already means, and neither is special to `for`.

import std::collections::vector

/// A cursor that yields values until it runs out.
///
/// `next` returns `nil` to end the loop. Nothing says a spent iterator has to
/// keep saying `nil`, but one that does is easier to reason about, and every
/// iterator in this library does.
pub mark Iterator {
    /// What each turn of the loop produces.
    type Item

    /// The next value, or `nil` when there are no more.
    fn next(&var self) -> Self::Item?

    //=== Adaptors =======================================================//
    //
    // Each returns an iterator wrapping this one, so each result is a type
    // parameterised by `Self`. The compiler resolves those where they are
    // called rather than for every type carrying the mark, which is what
    // keeps a chain as deep as the one you wrote and no deeper.

    /// Every value with `f` applied to it.
    ///
    ///     for line in rows.map(||(r: Row) -> String { r.title }) { ... }
    pub fn map<B>(self, f: @function(Self::Item) -> B) -> Map<Self, B> {
        Map<Self, B> { source: self, f: f }
    }

    /// Only the values `keep` says yes to.
    ///
    ///     for n in numbers.filter(||(n: i64) -> bool { n > 0 }) { ... }
    pub fn filter(self, keep: @function(&Self::Item) -> bool) -> Filter<Self> {
        Filter<Self> { source: self, keep: keep }
    }

    /// Pairs from both, stopping as soon as either does.
    ///
    ///     for (n, name) in counts.zip(names) { ... }
    pub fn zip<J: Iterator>(self, other: J) -> Zip<Self, J> {
        Zip<Self, J> { left: self, right: other }
    }

    /// The values up to the first one `keep` says no to, and no further.
    ///
    /// The source is asked once more than the number of values taken, and
    /// never again — so this is what ends an endless iterator.
    ///
    ///     for n in counting(1).take_while(||(n: i64) -> bool { n * n < 100 }) { ... }
    pub fn take_while(self, keep: @function(&Self::Item) -> bool) -> TakeWhile<Self> {
        TakeWhile<Self> { source: self, keep: keep }
    }

    /// Everything from the first value `drop` says no to onwards.
    pub fn skip_while(self, drop: @function(&Self::Item) -> bool) -> SkipWhile<Self> {
        SkipWhile<Self> { source: self, drop: drop }
    }

    /// At most `count` values.
    pub fn take(self, count: i64) -> Take<Self> {
        Take<Self> { source: self, remaining: count }
    }

    /// Everything after the first `count` values.
    pub fn skip(self, count: i64) -> Skip<Self> {
        Skip<Self> { source: self, remaining: count }
    }

    /// Each value paired with its position, counting from zero.
    ///
    ///     for (i, name) in names.iterate().enumerate() { ... }
    pub fn enumerate(self) -> Enumerate<Self> {
        Enumerate<Self> { source: self }
    }

    /// This iterator's values, then `other`'s.
    pub fn chain<J: Iterator>(self, other: J) -> Chain<Self, J> {
        Chain<Self, J> { left: self, right: other }
    }

    /// Every `stride`-th value, starting with the first.
    ///
    /// A stride of 1 changes nothing; anything below 1 is read as 1, since a
    /// stride of zero would never move.
    ///
    ///     for n in counting(0).step_by(5).take(4) { ... }   // 0 5 10 15
    pub fn step_by(self, stride: i64) -> StepBy<Self> {
        StepBy<Self> { source: self, stride: stride }
    }

    /// Every value, unchanged, with `look` called on each as it goes past.
    ///
    /// It is the chain's own print statement: a lazy chain cannot be stopped
    /// at halfway to see what is in it, so this is how you look.
    ///
    ///     rows.inspect(||(r: Row) -> () { io::println(r.title) }).count()
    pub fn inspect(self, look: @function(&Self::Item) -> ()) -> Inspect<Self> {
        Inspect<Self> { source: self, look: look }
    }

    /// Every value of every inner iterator, in order: an iterator of
    /// iterators laid out flat. Each inner one is walked to its end before
    /// the next is asked for.
    ///
    ///     for word in lines.map(words).flatten() { ... }
    pub fn flatten(self) -> Flatten<Self> where Self::Item: Iterator {
        Flatten<Self> { source: self }
    }

    /// `map` and `flatten` in one: `f` turns each value into an iterator,
    /// and the results are laid out end to end.
    ///
    ///     for c in names.as_iter().flatMap(||(n: String) -> text::Chars { text::chars(n) }) { ... }
    pub fn flatMap<J: Iterator>(self, f: @function(Self::Item) -> J) -> Flatten<Map<Self, J>> {
        Flatten<Map<Self, J>> { source: Map<Self, J> { source: self, f: f } }
    }

    //=== Ending a chain =================================================//

    /// Everything left, in a vector. This is what runs a chain: the adaptors
    /// above compute nothing until something asks them to.
    ///
    ///     let evens = numbers.filter(||(n: i64) -> bool { n % 2 == 0 }).collect()
    pub fn collect(self) -> vector::Vector<Self::Item> {
        vector::collect(self)
    }

    /// How many values are left. Walks the iterator to its end.
    pub fn count(self) -> i64 {
        var it = self
        var n = 0
        loop {
            match it.next() {
                Option::Some(value) => n += 1,
                Option::None => break,
            }
        }
        n
    }

    /// The first value `keep` says yes to, or `nil` if there is none.
    ///
    /// Stops as soon as it finds one: the source is not walked to its end.
    pub fn find(self, keep: @function(&Self::Item) -> bool) -> Self::Item? {
        var it = self
        loop {
            match it.next() {
                Option::Some(value) => if keep(&value) { return value },
                Option::None => return nil,
            }
        }
    }

    /// True when `keep` says yes to at least one value. Stops at the first.
    pub fn any(self, keep: @function(&Self::Item) -> bool) -> bool {
        var it = self
        loop {
            match it.next() {
                Option::Some(value) => if keep(&value) { return true },
                Option::None => return false,
            }
        }
    }

    /// True when `keep` says yes to every value. Stops at the first `false`.
    pub fn all(self, keep: @function(&Self::Item) -> bool) -> bool {
        var it = self
        loop {
            match it.next() {
                Option::Some(value) => if !keep(&value) { return false },
                Option::None => return true,
            }
        }
    }

    /// Every value, one at a time, with nothing kept.
    ///
    /// A `for` loop says the same thing and reads better; this is for the end
    /// of a chain, where breaking out to a loop would mean naming the chain.
    ///
    ///     rows.filter(isVisible).forEach(||(r: Row) { draw(r) })
    pub fn forEach(self, visit: @function(Self::Item) -> ()) {
        var it = self
        loop {
            match it.next() {
                Option::Some(value) => visit(value),
                Option::None => break,
            }
        }
    }

    /// Combines every value into one, starting from `initial`.
    ///
    /// This is the general form of the four above: `count`, `any` and `all`
    /// are all folds, and so is anything else that walks a chain to its end
    /// and keeps a running answer.
    ///
    ///     let total = prices.as_iter().fold(0, ||(sum: i64, p: i64) -> i64 {
    ///         sum + p
    ///     })
    pub fn fold<A>(self, initial: A, combine: @function(A, Self::Item) -> A) -> A {
        var it = self
        var carried = initial
        loop {
            match it.next() {
                Option::Some(value) => carried = combine(carried, value),
                Option::None => break,
            }
        }
        carried
    }

    /// `fold` with the first value as the starting point, so nothing has to
    /// be invented for an empty chain — it yields `nil` instead.
    ///
    ///     let biggest = scores.as_iter().reduce(||(a: i64, b: i64) -> i64 {
    ///         if a > b { a } else { b }
    ///     })
    pub fn reduce(self, combine: @function(Self::Item, Self::Item) -> Self::Item) -> Self::Item? {
        var it = self
        var carried = it.next()
        match carried {
            Option::Some(first) => {
                var running = first
                loop {
                    match it.next() {
                        Option::Some(value) => running = combine(running, value),
                        Option::None => break,
                    }
                }
                running
            },
            Option::None => nil,
        }
    }

    /// The last value, or `nil` when there are none. Walks to the end.
    pub fn last(self) -> Self::Item? {
        var it = self
        var seen: Self::Item? = nil
        loop {
            match it.next() {
                Option::Some(value) => seen = value,
                Option::None => break,
            }
        }
        seen
    }

    /// The value at `index`, counting from zero, or `nil` if the chain is
    /// shorter than that. Everything before it is walked past and discarded.
    pub fn nth(self, index: i64) -> Self::Item? {
        var it = self
        var left = index
        loop {
            match it.next() {
                Option::Some(value) => {
                    if left <= 0 { return value }
                    left -= 1
                },
                Option::None => return nil,
            }
        }
    }

    /// Where the first value `keep` says yes to is, or `nil` if there is none.
    ///
    /// `find` hands back the value; this hands back its position.
    pub fn position(self, keep: @function(&Self::Item) -> bool) -> i64? {
        var it = self
        var at = 0
        loop {
            match it.next() {
                Option::Some(value) => {
                    if keep(&value) { return at }
                    at += 1
                },
                Option::None => return nil,
            }
        }
    }

    /// The value `better` prefers over every other, or `nil` when empty.
    ///
    /// `better` returns true when its first argument should win, so
    /// `||(a, b) -> bool { a < b }` finds the smallest and `a > b` the
    /// largest. One comparison per value, and nothing is stored.
    pub fn best(self, better: @function(&Self::Item, &Self::Item) -> bool) -> Self::Item? {
        var it = self
        match it.next() {
            Option::Some(first) => {
                var winner = first
                loop {
                    match it.next() {
                        Option::Some(value) => {
                            if better(&value, &winner) { winner = value }
                        },
                        Option::None => break,
                    }
                }
                winner
            },
            Option::None => nil,
        }
    }
}

/// Something a fresh `Iterator` can be had from — a container, typically.
///
/// `iterate` takes `&self`, so walking a sequence does not consume it and two
/// loops over the same one are independent.
pub mark Sequence {
    /// The cursor this hands out.
    type Iter: Iterator

    /// A new cursor, positioned at the start.
    fn iterate(&self) -> Self::Iter from self

    //=== The same adaptors, one step earlier ============================//

    /// Every value with `f` applied to it.
    fn map<B>(&self, f: @function(Self::Iter::Item) -> B) -> Map<Self::Iter, B> from (self, f) {
        Map<Self::Iter, B> { source: self.iterate(), f: f }
    }

    /// Only the values `keep` says yes to.
    fn filter(&self,
              keep: @function(&Self::Iter::Item) -> bool) -> Filter<Self::Iter> from (self, keep) {
        Filter<Self::Iter> { source: self.iterate(), keep: keep }
    }

    /// Pairs from both, stopping as soon as either does.
    fn zip<J: Iterator>(&self, other: J) -> Zip<Self::Iter, J> from (self, other) {
        Zip<Self::Iter, J> { left: self.iterate(), right: other }
    }

    /// The values up to the first one `keep` says no to, and no further.
    fn take_while(&self,
                  keep: @function(&Self::Iter::Item) -> bool) -> TakeWhile<Self::Iter> from (self, keep) {
        TakeWhile<Self::Iter> { source: self.iterate(), keep: keep }
    }

    /// Everything from the first value `drop` says no to onwards.
    fn skip_while(&self,
                  drop: @function(&Self::Iter::Item) -> bool) -> SkipWhile<Self::Iter> from (self, drop) {
        SkipWhile<Self::Iter> { source: self.iterate(), drop: drop }
    }

    /// At most `count` values.
    fn take(&self, count: i64) -> Take<Self::Iter> from self {
        Take<Self::Iter> { source: self.iterate(), remaining: count }
    }

    /// Everything after the first `count` values.
    fn skip(&self, count: i64) -> Skip<Self::Iter> from self {
        Skip<Self::Iter> { source: self.iterate(), remaining: count }
    }

    /// Each value paired with its position, counting from zero.
    fn enumerate(&self) -> Enumerate<Self::Iter> from self {
        Enumerate<Self::Iter> { source: self.iterate() }
    }

    /// This sequence's values, then `other`'s.
    fn chain<J: Iterator>(&self, other: J) -> Chain<Self::Iter, J> from (self, other) {
        Chain<Self::Iter, J> { left: self.iterate(), right: other }
    }

    /// Every value of every inner iterator, laid out flat.
    fn flatten(&self) -> Flatten<Self::Iter> from self where Self::Iter::Item: Iterator {
        Flatten<Self::Iter> { source: self.iterate() }
    }

    /// `map` and `flatten` in one.
    fn flatMap<J: Iterator>(&self, f: @function(Self::Iter::Item) -> J) -> Flatten<Map<Self::Iter, J>> from (self, f) {
        Flatten<Map<Self::Iter, J>> { source: Map<Self::Iter, J> { source: self.iterate(), f: f } }
    }

    /// A cursor over this sequence — `iterate` under the name a chain reads
    /// better with.
    ///
    ///     let firstThree = names.as_iter().take(3).collect()
    fn as_iter(&self) -> Self::Iter from self { self.iterate() }

    /// Everything in this sequence, in a vector.
    fn collect(&self) -> vector::Vector<Self::Iter::Item> {
        vector::collect(self.iterate())
    }
}

//===--------------------------------------------------------------------===//
// Sources
//===--------------------------------------------------------------------===//

/// An endless run of integers. It is what `zip` needs to number something:
/// `0..n` is loop syntax rather than a value, so it cannot be zipped.
///
///     for (i, name) in iter::counting(0).zip(names.iterate()) { ... }
///
/// Endless is safe here because `zip` stops with the shorter side.
pub struct Counter { at: i64, step: i64 }

/// Counts up from `from`, one at a time.
pub fn counting(from: i64) -> Counter { Counter { at: from, step: 1 } }

/// Counts from `from` in steps of `step`, which may be negative.
pub fn countingBy(from: i64, step: i64) -> Counter {
    Counter { at: from, step: step }
}

bind Iterator to Counter {
    type Item = i64
    fn next(&var self) -> Self::Item? {
        let value = self.at
        self.at += self.step
        value
    }
}

//===--------------------------------------------------------------------===//
// The adaptors
//
// Each is an iterator that holds another one. Nothing happens until the loop
// at the end of the chain calls `next`, which is what makes a chain cost one
// pass over the source and no storage.
//===--------------------------------------------------------------------===//

/// `source`, with `f` applied to every value. Built by `Iterator::map`.
pub struct Map<I, B> {
    source: I
    f: @function(I::Item) -> B
}

bind<I: Iterator, B> Iterator to Map<I, B> {
    type Item = B
    fn next(&var self) -> Self::Item? {
        match self.source.next() {
            Option::Some(value) => (self.f)(value),
            Option::None => nil,
        }
    }
}

/// The values of `source` that `keep` says yes to. Built by `Iterator::filter`.
pub struct Filter<I> {
    source: I
    keep: @function(&I::Item) -> bool
}

bind<I: Iterator> Iterator to Filter<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        // Skipping is the whole job, so the loop is here rather than in the
        // caller: `next` returns only once it has something to return.
        loop {
            match self.source.next() {
                Option::Some(value) => if (self.keep)(&value) { return value },
                Option::None => return nil,
            }
        }
    }
}

/// Pairs from two iterators, ending as soon as either does. Built by
/// `Iterator::zip`.
pub struct Zip<I, J> {
    left: I
    right: J
}

bind<I: Iterator, J: Iterator> Iterator to Zip<I, J> {
    type Item = (I::Item, J::Item)
    fn next(&var self) -> Self::Item? {
        // The left one is asked first, and the right one is not asked at all
        // once the left has run out — so neither is advanced past the end of
        // the pair that was produced.
        match self.left.next() {
            Option::Some(a) => match self.right.next() {
                Option::Some(b) => (a, b),
                Option::None => nil,
            },
            Option::None => nil,
        }
    }
}

/// The leading values of `source` that `keep` says yes to. Built by
/// `Iterator::take_while`.
///
/// The first `false` ends the run for good: `done` is set, and no later turn
/// asks `source` for anything. That is what lets a `take_while` sit in front
/// of an endless or an expensive iterator — the source is advanced exactly
/// once past the last value taken, and never again.
pub struct TakeWhile<I> {
    source: I,
    keep: @function(&I::Item) -> bool,
    done: bool = false
}

bind<I: Iterator> Iterator to TakeWhile<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        if self.done { return nil }
        match self.source.next() {
            Option::Some(value) => {
                if (self.keep)(&value) {
                    value
                } else {
                    // Stop here rather than skipping: `take_while` ends at the
                    // first `false`, it does not filter.
                    self.done = true
                    nil
                }
            },
            Option::None => {
                self.done = true
                nil
            }
        }
    }
}

/// The values of `source` after `drop` stops saying yes, and every one from
/// then on. The mirror of `TakeWhile`. Built by `Iterator::skip_while`.
pub struct SkipWhile<I> {
    source: I,
    drop: @function(&I::Item) -> bool,
    skipping: bool = true
}

bind<I: Iterator> Iterator to SkipWhile<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        loop {
            match self.source.next() {
                Option::Some(value) => {
                    if !self.skipping { return value }
                    if !(self.drop)(&value) {
                        self.skipping = false
                        return value
                    }
                },
                Option::None => return nil,
            }
        }
    }
}

/// At most `remaining` values from `source`. Built by `Iterator::take`.
pub struct Take<I> {
    source: I,
    remaining: i64
}

bind<I: Iterator> Iterator to Take<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        if self.remaining <= 0 { return nil }
        self.remaining -= 1
        self.source.next()
    }
}

/// Everything after the first `count` values of `source`. Built by
/// `Iterator::skip`.
pub struct Skip<I> {
    source: I,
    remaining: i64
}

bind<I: Iterator> Iterator to Skip<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        while self.remaining > 0 {
            self.remaining -= 1
            match self.source.next() {
                Option::Some(value) => {},
                Option::None => return nil,
            }
        }
        self.source.next()
    }
}

/// `source` with each value numbered from zero. Built by
/// `Iterator::enumerate`.
pub struct Enumerate<I> {
    source: I,
    at: i64 = 0
}

bind<I: Iterator> Iterator to Enumerate<I> {
    type Item = (i64, I::Item)
    fn next(&var self) -> Self::Item? {
        match self.source.next() {
            Option::Some(value) => {
                let index = self.at
                self.at += 1
                (index, value)
            },
            Option::None => nil,
        }
    }
}

/// One iterator's values then another's. Built by `Iterator::chain`.
pub struct Chain<I, J> {
    left: I,
    right: J,
    onLeft: bool = true
}

bind<I: Iterator, J: Iterator> Iterator to Chain<I, J> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        if self.onLeft {
            match self.left.next() {
                Option::Some(value) => return value,
                Option::None => self.onLeft = false,
            }
        }
        self.right.next()
    }
}

/// `source`, every `stride`-th value. Built by `Iterator::step_by`.
pub struct StepBy<I> {
    source: I,
    stride: i64,
    started: bool = false
}

bind<I: Iterator> Iterator to StepBy<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        if !self.started {
            self.started = true
            return self.source.next()
        }
        var skipped = 1
        while skipped < self.stride {
            match self.source.next() {
                Option::Some(value) => skipped += 1,
                Option::None => return nil,
            }
        }
        self.source.next()
    }
}

/// `source`, unchanged, with a look at each value on the way past. Built by
/// `Iterator::inspect`.
pub struct Inspect<I> {
    source: I,
    look: @function(&I::Item) -> ()
}

bind<I: Iterator> Iterator to Inspect<I> {
    type Item = I::Item
    fn next(&var self) -> Self::Item? {
        match self.source.next() {
            Option::Some(value) => {
                (self.look)(&value)
                value
            },
            Option::None => nil,
        }
    }
}

/// `source`'s iterators, one after another. Built by `Iterator::flatten`
/// and `Iterator::flatMap`.
///
/// This is the adaptor whose item type is two marks deep — the item of the
/// source's item — which is what `I::Item::Item` spells.
pub struct Flatten<I> {
    source: I,
    current: I::Item? = nil
}

bind<I: Iterator> Iterator to Flatten<I> where I::Item: Iterator {
    type Item = I::Item::Item
    fn next(&var self) -> Self::Item? {
        loop {
            // The inner iterator is taken out, advanced, and put back: a
            // struct iterator advances as a copy, so the copy that moved is
            // the one that has to be kept.
            match self.current.take() {
                Option::Some(inner) => {
                    var it = inner
                    match it.next() {
                        Option::Some(value) => {
                            self.current = Option::Some(it)
                            return value
                        },
                        Option::None => {},
                    }
                },
                Option::None => {},
            }
            match self.source.next() {
                Option::Some(inner) => self.current = Option::Some(inner),
                Option::None => return nil,
            }
        }
    }
}
