// C++'s heap, for the objects an `extern "C++"` block declares.
//
// A C++ object lives where C++ can destroy it: `operator new` gives out the
// storage and `operator delete` takes it back, and a library that frees what
// it was handed — an LLVM `Module` deleting its functions, a container
// deleting its elements — assumes exactly those two. Rune's own allocator is
// not interchangeable with them, so a C++ object is allocated here and never
// with `mem::allocator`.
//
// The two halves of an object's life are written out, the way placement new
// and an explicit destructor call are in C++:
//
//     let ctx = cxx::alloc<LLVMContext>()   // storage: `@size` bytes
//     ctx.init()                            // the constructor, on it
//     ...
//     ctx.deinit()                          // the destructor
//     cxx::free(ctx)                        // the storage, back
//
// Nothing here is checked: a pointer from `alloc` is a raw `*var T`, and every
// use of it is unsafe in the ordinary way.

/// Storage for one `T` from C++'s `operator new`, uninitialised. For a C++
/// `class` the amount is its `@size`; a `struct` is measured from its fields.
///
/// The object does not exist until its `init` has run on the pointer, and
/// stops existing once `deinit` has; `free` returns the storage afterwards.
@unsafe
@intrinsic("cxx_alloc")
pub fn alloc<T>() -> *var T

/// Returns storage from `alloc` to C++'s `operator delete`. Whatever was in
/// it must already have been destroyed — Rune runs no destructor here.
@unsafe
@intrinsic("cxx_free")
pub fn free<T>(object: *var T)

/// A pointer to no object, for a C++ parameter that accepts `nullptr`.
@safe("an address of zero is never read through; C++ tests it the same way")
pub fn null<T>() -> *var T { unsafe { 0 as *var T } }

/// True when `object` is C++'s `nullptr`.
@safe("comparing an address to zero reads no memory")
pub fn isNull<T>(object: *var T) -> bool { unsafe { object as u64 == 0 } }
