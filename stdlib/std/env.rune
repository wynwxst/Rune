// std::env — the process's environment: its variables, and where it is.
//
// A variable is read with `get`, which is `nil` when it is not set at all —
// a set-but-empty variable is an empty `String`, and the two are different
// things to a shell script, so they are different things here:
//
//     let home = env::get("HOME") ?? "/"
//     match env::get("DEBUG") {
//         Some(v) => io::println("debug is '" + v + "'"),
//         None => io::println("debug is unset"),
//     }
//
// Writing goes through `set` and `remove`, and both say whether they worked.
// `all` lists every variable as a `(name, value)` pair.

import std::io
import std::text
import std::collections::vector

extern "C" {
    fn rune_env_get(name: CString) -> String
    fn rune_env_has(name: CString) -> bool
    fn rune_env_set(name: CString, value: CString) -> bool
    fn rune_env_remove(name: CString) -> bool
    fn rune_env_count() -> i64
    fn rune_env_at(index: i64) -> String
    fn rune_current_directory() -> String
    fn rune_set_current_directory(path: CString) -> bool
}

/// The value of `name`, or `nil` when it is not set.
#safe("getenv reads a table the runtime owns; the name is NUL-terminated by the String")
pub fn get(name: &String) -> String? {
    if !rune_env_has(name.$cstr()) { return nil }
    rune_env_get(name.$cstr())
}

/// The value of `name`, or `fallback` when it is not set or is empty.
///
///     let editor = env::getOr("EDITOR", "vi")
pub fn getOr(name: String, fallback: String) -> String {
    match get(name) {
        Some(v) => if v.$isEmpty() { fallback } else { v },
        None => fallback,
    }
}

/// True when `name` is set, even to an empty value.
#safe("getenv only reads the name")
pub fn has(name: String) -> bool { rune_env_has(name.$cstr()) }

/// Sets `name` to `value` for this process and anything it starts. False
/// when the platform refused — an empty name, for one.
#safe("setenv copies both strings before returning")
pub fn set(name: String, value: String) -> bool {
    rune_env_set(name.$cstr(), value.$cstr())
}

/// Unsets `name`. False when the platform refused.
#safe("unsetenv only reads the name")
pub fn remove(name: String) -> bool {
    rune_env_remove(name.$cstr())
}

/// Every variable, as `(name, value)` pairs, in the order the platform
/// keeps them.
#safe("each index is checked against the count the runtime reports")
pub fn all() -> vector::Vector<(String, String)> {
    var out = vector::Vector<(String, String)>()
    for i in 0..rune_env_count() {
        let entry = rune_env_at(i)
        match text::find(entry, "=") {
            Some(eq) => out.push((entry.$substring(0, eq),
                                  entry.$substring(eq + 1, entry.$length()))),
            None => out.push((entry, "")),
        }
    }
    out
}

//=== Where the process is ================================================//

/// The working directory, or `nil` if it cannot be read — deleted from under
/// the process, say.
#safe("getcwd writes into a buffer the runtime sizes")
pub fn currentDirectory() -> String? {
    let dir = rune_current_directory()
    if dir.$isEmpty() { return nil }
    dir
}

/// Changes the working directory. False when the path does not exist or is
/// not a directory.
#safe("chdir only reads the path")
pub fn setCurrentDirectory(path: String) -> bool {
    rune_set_current_directory(path.$cstr())
}

/// The current user's home directory, if the environment names one.
pub fn home() -> String? {
    match get("HOME") {
        Some(h) => h,
        None => get("USERPROFILE"),
    }
}

/// Where temporary files go: `TMPDIR`, `TEMP` or `TMP`, or `/tmp`.
pub fn temporaryDirectory() -> String {
    for name in ["TMPDIR", "TEMP", "TMP"] {
        if get(name) is Some(dir) {
            if !dir.$isEmpty() { return dir }
        }
    }
    "/tmp"
}
