#type(Executable)
// The Rune formatter.
//
//     rune-fmt [options] [path...]
//
// Each path is a file or a directory; a directory means every `.rune` file
// under it, build output left out. With no path, the package the current
// directory is in is formatted — its `src/` and `tests/` — or, outside a
// package, the current directory.
//
// What it does to a file is described in `runetools/format.rune`, and in
// `rune doc fmt`. The exit status is 0 when it succeeded, 1 with `--check`
// when a file is not formatted, and 2 when the command line or a file could
// not be read or written.

import std::io
import std::env
import std::random
import std::process
import std::collections::vector
import runetools::project
import runetools::format

fn usage() -> String {
    """
    rune-fmt — lay Rune source out, and write in what the compiler knows

    USAGE
        rune-fmt [options] [path...]

    OPTIONS
        --check            Change nothing; list the files that are not formatted, exit 1 if any
        --stdout           Print the formatted text instead of writing it (one file)
        --stdin-path <p>   Format standard input as though it were the file <p>, and print it
        --no-types         Do not write in the types of bindings
        --no-labels        Do not label arguments given by position
        --no-reorder       Leave the order of the file's top-level pieces alone
        --no-lint-fixes    Do not apply the linter's style fixes
        --runec <path>     The compiler (default: beside rune-fmt, or on PATH)
        --stdlib <dir>     Where the standard library is
        -h, --help         Print this message
    """ + "\n"
}

/// A compiler beside this program, or the one on PATH.
fn sibling(name: &String) -> String {
    let own = project::absolute(process::programName())
    let beside = project::join(project::dirOf(own), name)
    if io::exists(beside) { return beside }
    name.$clone()
}

fn main() -> i64 {
    var opts = format::Options()
    var check = false
    var toStdout = false
    var runec = ""
    var stdlibFlag = ""
    var stdinPath = ""
    var paths = vector::Vector<String>()
    let args = process::arguments()
    var i = 0
    while i < args.length() {
        let a = args.get(i)
        let value = if i + 1 < args.length() { args.get(i + 1) } else { "" }
        if a == "-h" || a == "--help" { io::print(usage()); return 0 }
        elif a == "--check" { check = true }
        elif a == "--stdout" { toStdout = true }
        elif a == "--no-types" { opts.types = false }
        elif a == "--no-labels" { opts.labels = false }
        elif a == "--no-reorder" { opts.reorder = false }
        elif a == "--no-lint-fixes" { opts.lintFixes = false }
        elif a == "--runec" { runec = value; i += 1 }
        elif a == "--stdlib" { stdlibFlag = value; i += 1 }
        elif a == "--stdin-path" { stdinPath = value; i += 1 }
        elif a.$length() > 0 && a.$byteAt(0) == 45 {
            io::eprintln("rune-fmt: unknown option '" + a + "'")
            io::eprint(usage())
            return 2
        } else {
            paths.push(a)
        }
        i += 1
    }
    if runec.$isEmpty() { runec = sibling("runec") }
    var p = project::Project(project::findStdlib(stdlibFlag, process::programName()))

    var r = random::new()
    let scratch = project::join(env::temporaryDirectory(), "rune-fmt-" + r.between(100000, 999999).$str() + ".rune")

    // An editor's buffer, on standard input: formatted as the file it will
    // be saved as, with that file's package around it.
    if !stdinPath.$isEmpty() {
        var input = io::Bytes()
        loop {
            match io::readLineOrEnd() {
                Some(line) => {
                    input.appendText(line)
                    input.appendText("\n")
                },
                None => break,
            }
        }
        let path = project::absolute(stdinPath)
        let done = format::format(&var p, runec, path, input.toString(), scratch, opts)
        io::delete(scratch)
        if !done.note.$isEmpty() { io::eprintln("rune-fmt: " + stdinPath + ": " + done.note) }
        io::print(done.text)
        io::flush()
        return 0
    }

    var files = vector::Vector<String>()
    if paths.isEmpty() {
        let here = project::absolute(".")
        let m = p.manifestFor(project::join(here, "Rune.toml"))
        if m >= 0 {
            let root = p.manifest(m).root.$clone()
            for sub in ["src", "tests"] {
                for f in project::sourcesUnder(project::join(root, sub)) { files.push(f.$clone()) }
            }
        } else {
            for f in project::sourcesUnder(here) { files.push(f.$clone()) }
        }
    }
    for path in paths {
        let abs = project::absolute(path)
        if io::isDirectory(abs) {
            for f in project::sourcesUnder(abs) { files.push(f.$clone()) }
        } elif io::exists(abs) {
            files.push(abs)
        } else {
            io::eprintln("rune-fmt: no such file or directory: " + path)
            return 2
        }
    }
    if toStdout && files.length() != 1 {
        io::eprintln("rune-fmt: --stdout formats exactly one file")
        return 2
    }

    let cwd = project::absolute(".")
    var changed = 0
    for file in files {
        let shown = if file.$find(cwd + "/") == 0 { file.$substring(cwd.$length() + 1, file.$length()) }
                    else { file.$clone() }
        let text = match io::readToString(file) {
            Ok(t) => t,
            Err(e) => {
                io::eprintln("rune-fmt: could not read " + shown + ": " + io::describe(e))
                io::delete(scratch)
                return 2
            },
        }
        let done = format::format(&var p, runec, file, text.$clone(), scratch, opts)
        if !done.note.$isEmpty() { io::eprintln("rune-fmt: " + shown + ": " + done.note) }
        if toStdout {
            io::print(done.text)
            continue
        }
        if done.text == text { continue }
        changed += 1
        if check {
            io::println(shown)
            continue
        }
        match io::writeString(file, done.text) {
            Ok(_n) => io::eprintln("○ Formatted " + shown),
            Err(e) => {
                io::eprintln("rune-fmt: could not write " + shown + ": " + io::describe(e))
                io::delete(scratch)
                return 2
            },
        }
    }
    io::delete(scratch)
    io::flush()
    if check && changed > 0 {
        io::eprintln("● " + changed.$str() + " of " + files.length().$str() + " file" +
                     (if files.length() == 1 { "" } else { "s" }) + " not formatted")
        return 1
    }
    if !toStdout && !check && changed == 0 {
        io::eprintln("○ Nothing to change in " + files.length().$str() + " file" +
                     (if files.length() == 1 { "" } else { "s" }) + ".")
    }
    0
}
