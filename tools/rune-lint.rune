@type(Executable)
// The Rune linter.
//
//     rune-lint [options] [path...]
//
// Each path is a file or a directory; a directory means every `.rune` file
// under it, build output left out. With no path, the package the current
// directory is in is linted — its `src/` and `tests/` — or, outside a
// package, the current directory.
//
// A package's `Rune.toml` may have a `[lint]` table, which applies to its
// files before anything on the command line:
//
//     [lint]
//     allow = ["naming", "line-too-long"]
//     warn = ["missing-docs"]
//     max-line-length = 100
//
// The exit status is 0 when nothing was found, 1 when something was, and 2
// when the command line or a file could not be read.

import std::io
import std::process
import std::json
import std::collections::vector
import runetools::syntax
import runetools::project
import runetools::lint

fn usage() -> String {
    """
    rune-lint — find likely mistakes and style problems in Rune source

    USAGE
        rune-lint [options] [path...]

    OPTIONS
        --fix                  Apply every fix the findings carry, and report the rest
        --format <human|json>  How to report (json: one object per line)
        -A, --allow <rule>     Turn a rule off (`all` for every rule)
        -W, --warn <rule>      Turn a rule on, including one that is off by default
        --max-line-length <n>  The limit for line-too-long (default 120)
        --stdlib <dir>         Where the standard library is
        --list                 List the rules and exit
        -h, --help             Print this message
    """ + "\n"
}

/// A 0-based byte column as the 1-based character column people count.
fn charColumn(line: &String, byteCol: i64) -> i64 {
    var w = 0
    var i = 0
    while i < byteCol && i < line.$length() {
        let b = line.$byteAt(i) as i64
        if b < 128 || b >= 192 { w += 1 }
        i += 1
    }
    w
}

/// One finding, the way `runec` prints a diagnostic.
fn render(out: &var io::Bytes, path: &String, lx: &syntax::Lexed, f: &lint::Finding, fixed: bool) {
    let line = lx.lineOf(f.start)
    let text = lx.lineText(line)
    let col = f.start - lx.lineStarts.get(line)
    var endCol = f.end - lx.lineStarts.get(line)
    if endCol > text.$length() || lx.lineOf(f.end) != line { endCol = text.$length() }
    if endCol <= col { endCol = col + 1 }
    let c0 = charColumn(text, col)
    let c1 = charColumn(text, endCol)
    let number = (line + 1).$str()
    let word = if f.level == "warn" { "WARNING" } else { "NOTE" }
    out.appendText("● " + path + " [" + number + ":" + c0.$str() + ".." + c1.$str() + "]\n")
    out.appendText(number + " ║ " + text + "\n")
    var pad = ""
    var i = 0
    while i < number.$length() + 3 + c0 { pad += " "; i += 1 }
    var carets = "^"
    var k = c0 + 1
    while k < c1 { carets += "^"; k += 1 }
    out.appendText(pad + carets + " " + word + ": " + f.message + " [" + f.rule + "]\n")
    if !f.edits.isEmpty() {
        var gutter = ""
        var g = 0
        while g < number.$length() + 1 { gutter += " "; g += 1 }
        let what = if fixed { "fixed: " } else { "fix: " }
        out.appendText(gutter + "  ─  " + what + lowerFirst(f.fixTitle) +
                       (if fixed { "" } else { " (rune lint --fix)" }) + "\n")
    }
}

/// One finding as a line of JSON, the same shape as `runec --diagnostic-format json`.
fn renderJson(out: &var io::Bytes, path: &String, lx: &syntax::Lexed, f: &lint::Finding) {
    let line = lx.lineOf(f.start)
    let endLine = lx.lineOf(f.end)
    var s = "{\"severity\":\"" + (if f.level == "warn" { "warning" } else { "note" }) + "\""
    s += ",\"code\":" + json::quote(f.rule)
    s += ",\"message\":" + json::quote(f.message)
    s += ",\"file\":" + json::quote(path)
    s += ",\"line\":" + (line + 1).$str() + ",\"column\":" + (f.start - lx.lineStarts.get(line)).$str()
    s += ",\"endLine\":" + (endLine + 1).$str() + ",\"endColumn\":" + (f.end - lx.lineStarts.get(endLine)).$str()
    if !f.edits.isEmpty() {
        s += ",\"fix\":{\"title\":" + json::quote(f.fixTitle) + ",\"edits\":["
        var first = true
        for e in f.edits {
            if !first { s += "," }
            first = false
            s += "{\"start\":" + e.start.$str() + ",\"end\":" + e.end.$str() + ",\"text\":" + json::quote(e.text) + "}"
        }
        s += "]}"
    }
    out.appendText(s + "}\n")
}

fn main() -> i64 {
    var _config = lint::Config()
    var overrides = vector::Vector<String>()      // rule, level, rule, level...
    var maxLine = 0
    var paths = vector::Vector<String>()
    var fix = false
    var jsonOut = false
    var stdlibFlag = ""
    let args = process::arguments()
    var i = 0
    while i < args.length() {
        let a = args.get(i)
        let value = if i + 1 < args.length() { args.get(i + 1) } else { "" }
        if a == "-h" || a == "--help" { io::print(usage()); return 0 }
        elif a == "--list" {
            for r in lint::rules() {
                io::println(padTo(r.name, 22) + padTo(r.level, 7) + r.summary)
            }
            return 0
        } elif a == "--fix" { fix = true }
        elif a == "--format" {
            if value != "json" && value != "human" { io::eprintln("rune-lint: --format takes human or json"); return 2 }
            jsonOut = value == "json"
            i += 1
        } elif a == "-A" || a == "--allow" || a == "-W" || a == "--warn" {
            if !lint::isRule(value) {
                io::eprintln("rune-lint: there is no rule called '" + value + "' (see --list)")
                return 2
            }
            overrides.push(value)
            overrides.push(if a == "-A" || a == "--allow" { "allow" } else { "warn" })
            i += 1
        } elif a == "--max-line-length" {
            maxLine = value.$toInt() ?? 0
            i += 1
        } elif a == "--stdlib" {
            stdlibFlag = value
            i += 1
        } elif a.$length() > 0 && a.$byteAt(0) == 45 {
            io::eprintln("rune-lint: unknown option '" + a + "'")
            io::eprint(usage())
            return 2
        } else {
            paths.push(a)
        }
        i += 1
    }

    var p = project::Project(project::findStdlib(stdlibFlag, process::programName()))

    // What to lint.
    var files = vector::Vector<String>()
    if paths.isEmpty() {
        let here = project::absolute(".")
        let m = p.manifestFor(project::join(here, "Rune.toml"))
        if m >= 0 {
            let root = p.manifest(m).root.$clone()
            for sub in ["src", "tests"] {
                for f in project::sourcesUnder(project::join(root, sub)) { files.push(f.$clone()) }
            }
        } else {
            for f in project::sourcesUnder(here) { files.push(f.$clone()) }
        }
    }
    for path in paths {
        let abs = project::absolute(path)
        if io::isDirectory(abs) {
            for f in project::sourcesUnder(abs) { files.push(f.$clone()) }
        } elif io::exists(abs) {
            files.push(abs)
        } else {
            io::eprintln("rune-lint: no such file or directory: " + path)
            return 2
        }
    }

    let cwd = project::absolute(".")
    var warnings = 0
    var notes = 0
    var fixedCount = 0
    var withFindings = 0
    var out = io::Bytes()
    for file in files {
        // Each file gets its own package's settings, then the command line's.
        var cfg = lint::Config()
        let mid = p.manifestFor(file)
        if mid >= 0 { cfg.apply(p.manifest(mid)) }
        var k = 0
        while k < overrides.length() {
            cfg.set(overrides.get(k), overrides.get(k + 1))
            k += 2
        }
        if maxLine > 0 { cfg.maxLineLength = maxLine }

        let m = p.load(file)
        if m < 0 { continue }
        p.loadImports(m, 1)
        let found = lint::run(p, m, cfg)
        let shown = if file.$find(cwd + "/") == 0 { file.$substring(cwd.$length() + 1,
                                                                    file.$length()) } else { file.$clone() }
        var fixedHere = false
        if fix {
            var fixable = vector::Vector<lint::Finding>()
            for f in found { if !f.edits.isEmpty() { fixable.push(f.$clone()) } }
            if !fixable.isEmpty() {
                let source = p.module(m).lexed.source.$clone()
                let updated = lint::applyFixes(source, fixable)
                if updated != source {
                    match io::writeString(file, updated) {
                        Ok(_written) => { fixedHere = true },
                        Err(e) => {
                            io::eprintln("rune-lint: could not write " + shown + ": " + io::describe(e))
                            return 2
                        },
                    }
                }
            }
        }
        if !found.isEmpty() { withFindings += 1 }
        let lx = p.module(m).lexed
        for f in found {
            let wasFixed = fixedHere && !f.edits.isEmpty()
            if wasFixed { fixedCount += 1 }
            if jsonOut { renderJson(&var out, file, lx, f) }
            else { render(&var out, shown, lx, f, wasFixed) }
            if !wasFixed {
                if f.level == "warn" { warnings += 1 } else { notes += 1 }
            }
        }
    }
    io::print(out.toString())
    io::flush()
    if !jsonOut {
        var summary = ""
        if warnings + notes == 0 && fixedCount == 0 {
            summary = "No problems found in " + files.length().$str() + " file" +
                    (if files.length() == 1 { "" } else { "s" }) + "."
        } else {
            summary = plural(warnings, "warning") + " and " + plural(notes, "note") + " in " +
                      plural(withFindings, "file")
            if fixedCount > 0 { summary += "; fixed " + fixedCount.$str() }
            summary += "."
        }
        io::eprintln((if warnings + notes == 0 { "○ " } else { "● " }) + summary)
    }
    if warnings + notes > 0 { 1 } else { 0 }
}

/// `text` with its first letter lower-cased: a fix's title reads as a
/// sentence fragment after "fix:".
fn lowerFirst(text: &String) -> String {
    if text.$isEmpty() { return "" }
    let b = text.$byteAt(0) as i64
    if b < 65 || b > 90 { return text.$clone() }
    "abcdefghijklmnopqrstuvwxyz".$substring(b - 65, b - 64) + text.$substring(1, text.$length())
}

/// `text` padded with spaces to `width`.
fn padTo(text: &String, width: i64) -> String {
    var out = text.$clone()
    while out.$length() < width { out += " " }
    out + " "
}

/// `1 warning`, `2 warnings`.
fn plural(n: i64, word: String) -> String {
    n.$str() + " " + word + (if n == 1 { "" } else { "s" })
}
