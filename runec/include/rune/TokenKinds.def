//===- TokenKinds.def - X-macro list of every Rune token -------*- C++ -*-===//
//
// TOK(Name, Spelling)
//   Spelling is the literal source text for punctuation and keywords, or a
//   bracketed category name for tokens whose text varies.
//
// Include this file with TOK defined; it undefines nothing itself.
//===----------------------------------------------------------------------===//

// --- Meta -------------------------------------------------------------------
TOK(Unknown,        "<unknown>")
TOK(EndOfFile,      "<end of file>")
TOK(Newline,        "<end of line>")

// --- Literals ---------------------------------------------------------------
TOK(Identifier,     "<identifier>")
TOK(IntLiteral,     "<integer literal>")
TOK(FloatLiteral,   "<float literal>")
TOK(StringLiteral,  "<string literal>")
TOK(CharLiteral,    "<character literal>")

// --- Keywords ---------------------------------------------------------------
// KEYWORD_FIRST must stay first and KEYWORD_LAST last in this block.
TOK(KwFn,           "fn")
TOK(KwVar,          "var")
TOK(KwLet,          "let")
TOK(KwMut,          "mut")
TOK(KwGlobal,       "global")
TOK(KwClass,        "class")
TOK(KwStruct,       "struct")
TOK(KwEnum,         "enum")
TOK(KwMark,         "mark")
TOK(KwBind,         "bind")
TOK(KwTo,           "to")
TOK(KwExtend,       "extend")
TOK(KwSuper,        "super")
TOK(KwSelfValue,    "self")
TOK(KwSelfType,     "Self")
TOK(KwImport,       "import")
TOK(KwPub,          "pub")
TOK(KwAs,           "as")
TOK(KwInto,         "into")
TOK(KwIs,           "is")
TOK(KwIf,           "if")
TOK(KwElif,         "elif")
TOK(KwElse,         "else")
TOK(KwWhile,        "while")
TOK(KwLoop,         "loop")
TOK(KwFor,          "for")
TOK(KwIn,           "in")
TOK(KwMatch,        "match")
TOK(KwReturn,       "return")
TOK(KwBreak,        "break")
TOK(KwContinue,     "continue")
TOK(KwExtern,       "extern")
TOK(KwWhere,        "where")
TOK(KwDefer,        "defer")
TOK(KwUnsafe,       "unsafe")
TOK(KwOperator,     "operator")
TOK(KwDyn,          "dyn")
TOK(KwType,         "type")
TOK(KwWeak,         "weak")
TOK(KwUniq,         "uniq")
TOK(KwMove,         "move")
TOK(KwMacro,        "macro")
TOK(KwTrue,         "true")
TOK(KwFalse,        "false")
TOK(KwNil,          "nil")

// --- Grouping ---------------------------------------------------------------
TOK(LParen,         "(")
TOK(RParen,         ")")
TOK(LBracket,       "[")
TOK(RBracket,       "]")
TOK(LBrace,         "{")
TOK(RBrace,         "}")

// --- Punctuation ------------------------------------------------------------
TOK(Comma,          ",")
TOK(Dot,            ".")
TOK(DotDot,         "..")
TOK(DotDotEq,       "..=")
TOK(Ellipsis,       "...")
TOK(Colon,          ":")
TOK(ColonColon,     "::")
TOK(Semi,           ";")
TOK(Arrow,          "->")
TOK(FatArrow,       "=>")
TOK(At,             "@")
TOK(Question,       "?")
TOK(QuestionQuestion, "??")
TOK(Underscore,     "_")
TOK(Hash,           "#")
TOK(Dollar,         "$")

// --- Operators --------------------------------------------------------------
TOK(Plus,           "+")
TOK(Minus,          "-")
TOK(Star,           "*")
TOK(Slash,          "/")
TOK(Percent,        "%")
TOK(Bang,           "!")
TOK(Tilde,          "~")
TOK(Amp,            "&")
TOK(Pipe,           "|")
TOK(Caret,          "^")
TOK(Shl,            "<<")
TOK(Shr,            ">>")
TOK(AmpAmp,         "&&")
TOK(PipePipe,       "||")
TOK(Lt,             "<")
TOK(Gt,             ">")
TOK(LtEq,           "<=")
TOK(GtEq,           ">=")
TOK(EqEq,           "==")
TOK(NotEq,          "!=")

// --- Assignment -------------------------------------------------------------
TOK(Eq,             "=")
TOK(PlusEq,         "+=")
TOK(MinusEq,        "-=")
TOK(StarEq,         "*=")
TOK(SlashEq,        "/=")
TOK(PercentEq,      "%=")
TOK(AmpEq,          "&=")
TOK(PipeEq,         "|=")
TOK(CaretEq,        "^=")
TOK(ShlEq,          "<<=")
TOK(ShrEq,          ">>=")
